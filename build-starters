#!/bin/sh
# build-starters: rebuild deploy/allspeak-<lang>.zip from starter/<lang>/.
#
# **A pack is the project's own files and nothing else.** Three of them: the agent's instructions for this
# language (`AGENTS.md`, and `CLAUDE.md` pointing at it), and `.allspeak-init`, which declares which
# language the project speaks. Everything else is fetched at the moment it is needed and so cannot go
# stale — a copy of the tooling in a project is what cost two evenings and a broken page on 2026-10-04:
#
#   * `server.allspeak` — fetched by the CLI, which runs the published one when the directory has none
#   * `viz.html` — served by that server, which fills in the language from `.allspeak-init`
#   * `viz.allspeak`, `viz-graph.allspeak`, `viz-side.allspeak`, `viz.json` — in the page's
#     payload (`dist/viz.js`, written by ./build-allspeak)
#   * `asdoc-check.py`, `plotview-check.js`, `viz-align-measure.py`, `guard-check.js`, `capture-check.js`,
#     `encoding-check.js`, `flush-check.js`, `attr-check.js`, `opcode-check.js`
#     — published at https://allspeak.ai/code/tools/ by the deploy, and fetched by whoever wants one
#
# Languages are auto-discovered from starter/*/ subdirectories. Run this after editing anything under
# starter/, and after editing a tool that an agent uses — the check below fails the build rather than let
# a tool that must reach an agent go missing from the repository.

set -eu
cd "$(dirname "$0")"

for tool in tools/asdoc-check.py tools/plotview-check.js tools/viz-align-measure.py tools/guard-check.js tools/capture-check.js tools/encoding-check.js tools/flush-check.js tools/attr-check.js tools/opcode-check.js; do
    if [ ! -f "$tool" ]; then
        echo "Error: $tool not found — it is published by the deploy, not shipped in a pack." >&2
        exit 1
    fi
done

if ! command -v zip >/dev/null 2>&1; then
    echo "Error: 'zip' command not found." >&2
    exit 1
fi

mkdir -p deploy

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

built=0
for dir in starter/*/; do
    lang=$(basename "$dir")
    missing=
    for f in CLAUDE.md AGENTS.md; do
        [ -f "$dir$f" ] || missing="$missing $f"
    done
    if [ -n "$missing" ]; then
        echo "  skip: starter/$lang missing:$missing"
        continue
    fi

    work="$STAGE/$lang"
    mkdir -p "$work"
    cp -p "$dir"CLAUDE.md "$work/"
    # **`.allspeak-init` carries the language and the runtime, and it is the only thing in a pack that is not
    # prose.** The page is not in a pack any more: the dev server serves the deployed one and fills both in, and
    # neither can come from anywhere but the project — so the pack declares them here. The agent completes this
    # file on first setup (project name and type) and is told to leave the `lang:` line be.
    #
    # **`js` is the runtime default, and the pack writes it out anyway** — a script's `@py`/`@js` says the same
    # thing about one script, and this says it about all of them, which is what stops a Python project carrying
    # a marker on every file. A pack is chosen by *language*, not by kind, so it cannot know which this project
    # is: the AGENTS.md beside it tells the agent to change this line for a CLI or desktop project.
    printf 'lang: %s\nruntime: js\n' "$lang" > "$work/.allspeak-init"
    # **And it must not carry the time of day, or the pack is a different file every time it is built.**
    #
    # The two files beside it arrive by `cp -p`, so they keep their source's timestamp; this one is *written*,
    # so it gets the moment the build ran. `zip` stores each entry's modified time, so that made the finished
    # `.zip` differ byte-for-byte on every build while its contents were identical — which is worse than noise:
    # the four packs are tracked in git, so every deploy showed four modified binaries, and a change being
    # reviewed sat among them indistinguishably. Measured 2026-10-13: same 21 bytes and same CRC (`04ada0b6`),
    # timestamps `17:51` and `20:19`, extracted trees `diff -rq` identical.
    #
    # It now borrows the timestamp of the instructions beside it — the file whose edit is the reason a pack
    # changes at all — so a pack's bytes change when its *contents* change and at no other time, and the
    # timestamp still reads as a real date to whoever unzips it. (A fixed epoch would do the same job and lie
    # to the reader; `SOURCE_DATE_EPOCH` is not honoured by `zip`.)
    touch -r "$dir"AGENTS.md "$work/.allspeak-init"
    for extra in DEEPSEEK.md CODEWHALE.md AGENTS.md; do
        if [ -f "$dir$extra" ]; then
            cp -p "$dir$extra" "$work/"
        fi
    done
    # **Nothing here is tooling.** What a pack carries is the project's own: its agent instructions and
    # the declaration of which language it speaks. Everything else is fetched at the moment it is needed
    # and therefore cannot go stale — the server script by the CLI (`allspeak server`), the page by that
    # server, the editor and its modules by the page's payload, and the checks from /code/tools/. The
    # rule this replaces put the checks in every pack, which is what made four copies of the tooling and
    # no way for a project to notice the repository had moved on.
    for tool in asdoc-check.py plotview-check.js viz-align-measure.py guard-check.js capture-check.js; do
        if [ ! -f "tools/$tool" ]; then
            echo "Error: tools/$tool not found — it is published by the deploy (see deploy-allspeak)." >&2
            exit 1
        fi
    done

    out="$PWD/deploy/allspeak-$lang.zip"
    rm -f "$out"
    zip_files="CLAUDE.md AGENTS.md .allspeak-init"
    for extra in DEEPSEEK.md CODEWHALE.md; do
        if [ -f "$work/$extra" ]; then
            zip_files="$zip_files $extra"
        fi
    done
    # **`-X`: no extra file attributes, and without it the pack is a different file every day.**
    #
    # The `touch -r` above stabilises the *modification* time, which is what the zip's own date field carries —
    # and that turned out to be only half of it. Info-ZIP also writes a `UT` extra field (`0x5455`) holding the
    # entry's **access** time, and an access time moves whenever the file is read, which every build does. So
    # the archive still drifted, by a handful of bytes inside the deflate stream of the first entry.
    #
    # Measured 2026-10-13, because the first fix looked finished and was not: the two builds of
    # `allspeak-en.zip` differed in exactly three bytes, at the atime field, `c242cd6a` (2026-10-12 21:27:46)
    # against `bf96ce6a` (2026-10-13 21:38:23), with the mtime field identical and the extracted contents
    # `diff -rq` clean. **And the check that had passed was passing for the wrong reason** — three consecutive
    # builds agreed because `relatime` suppresses the atime update for a file read twice in a day, so the test
    # was measuring the mount options rather than the build. The test that can fail is the one that moves the
    # access times first: `touch -a -t 202001010000 starter/*/*` then rebuild, and the bytes must not change.
    #
    # `-X` also drops the stored Unix uid/gid, which is no loss for a pack somebody downloads and unzips.
    ( cd "$work" && zip -qX "$out" $zip_files )

    echo "  built: deploy/allspeak-$lang.zip"
    built=$((built + 1))
done

echo "Done. $built starter packs rebuilt."
