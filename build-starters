#!/bin/sh
# build-starters: rebuild deploy/allspeak-<lang>.zip from starter/<lang>/.
#
# Each starter zip bundles the language-specific bootstrap files
# (CLAUDE.md, AGENTS.md) with the shared server and editor
# (server.allspeak, edit.html, asedit.allspeak, asedit-graph.allspeak, asedit-side.allspeak,
# asedit.json) and the doc-block analyser and the recorder's own check all at the zip root.
# **`server.allspeak` and `edit.html` come from the repo root, not from a starter directory** —
# see the note at the copy below.
#
# **The Graph pane and its sidebar are two files and both travel.** They are separate modules because
# each is bulky and the editor needs neither until a run is opened; a project that has one and not the
# other gets a picture with a status line saying the sidebar could not be loaded, which is the pane's
# own lenient path — but there is no reason to ship it that way.
#
# Run after editing anything under starter/ or after changing
# asedit.allspeak / asedit-graph.allspeak / asedit-side.allspeak / asedit.json and the tools an
# agent can use:
# tools/asdoc-check.py, tools/plotview-check.js, tools/viz-align-measure.py and
# tools/guard-check.js. Languages are auto-discovered from starter/*/ subdirectories.
#
# **A tool that an agent can use to speed development or improve reliability ships.** The
# analyser was already here; the visualiser's own instruments are here for the same reason,
# and the guard below fails the build rather than let a pack lose one quietly.

set -eu
cd "$(dirname "$0")"

if [ ! -f asedit.allspeak ] || [ ! -f asedit.json ] || [ ! -f server.allspeak ] || [ ! -f edit.html ]; then
    echo "Error: asedit.allspeak / asedit.json / server.allspeak / edit.html not found in repo root." >&2
    exit 1
fi

for tool in tools/asdoc-check.py tools/plotview-check.js tools/viz-align-measure.py tools/guard-check.js tools/capture-check.js; do
    if [ ! -f "$tool" ]; then
        echo "Error: $tool not found." >&2
        exit 1
    fi
done
if [ ! -f tools/asdoc-check.py ]; then
    echo "Error: tools/asdoc-check.py not found." >&2
    exit 1
fi

if ! command -v zip >/dev/null 2>&1; then
    echo "Error: 'zip' command not found." >&2
    exit 1
fi

mkdir -p deploy

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

built=0
for dir in starter/*/; do
    lang=$(basename "$dir")
    missing=
    [ -f "$dir"CLAUDE.md ] || missing="$missing CLAUDE.md"
    if [ -n "$missing" ]; then
        echo "  skip: starter/$lang missing:$missing"
        continue
    fi

    work="$STAGE/$lang"
    mkdir -p "$work"
    cp -p "$dir"CLAUDE.md "$work/"
    # **The server script is the root's, not a starter copy.** Four copies of a file are four things to
    # keep in step, and these had already drifted: all four still held the version from 1 October while the
    # root's had moved on — so every pack, and every project made from one, ran a server two revisions old
    # without any way to tell. It is language-neutral, which is why one copy can serve every pack.
    cp -p server.allspeak "$work/"
    # **The page is generated from the one in the repo root, not copied from a starter.** Four copies of a page
    # are four things to keep in step and they had already drifted — `starter/en/edit.html` was an older page
    # than the other three. Two things differ in a pack, and both are substitutions here: which language the
    # editor speaks, and where its own files live. The second is what makes an editor update reach every project
    # the moment it is deployed: a pack carries no editor, and its page names the deployed one.
    sed -e 's|<html lang="en">|<html lang="'"$lang"'">|' \
        -e 's|id="editor-lang" style="display:none">en<|id="editor-lang" style="display:none">'"$lang"'<|' \
        -e 's|id="editor-home" style="display:none"></div>|id="editor-home" style="display:none">https://allspeak.ai/dist/</div>|' \
        edit.html > "$work/edit.html"
    for extra in DEEPSEEK.md CODEWHALE.md AGENTS.md; do
        if [ -f "$dir$extra" ]; then
            cp -p "$dir$extra" "$work/"
        fi
    done
    # **No editor in a pack.** `edit.html` fetches `asedit.allspeak`, its two modules and `asedit.json` from
    # this directory and then from https://allspeak.ai/code/, and a pack carries none of them — so a pack always
    # runs the released editor rather than a copy of one that has since moved. A copy is what went stale twice
    # in one evening: a project ran an old editor beside a current runtime and plugin, and found out when the
    # editor refused to compile its own source. The page, the server and the tools stay: they are what a project
    # *is*, and none of them is fetched from anywhere else.
    for tool in asdoc-check.py plotview-check.js viz-align-measure.py guard-check.js capture-check.js; do
        cp -p "tools/$tool" "$work/"
    done

    out="$PWD/deploy/allspeak-$lang.zip"
    rm -f "$out"
    zip_files="CLAUDE.md server.allspeak edit.html asdoc-check.py plotview-check.js viz-align-measure.py guard-check.js capture-check.js"
    for extra in DEEPSEEK.md CODEWHALE.md AGENTS.md; do
        if [ -f "$work/$extra" ]; then
            zip_files="$zip_files $extra"
        fi
    done
    ( cd "$work" && zip -q "$out" $zip_files )

    echo "  built: deploy/allspeak-$lang.zip"
    built=$((built + 1))
done

echo "Done. $built starter packs rebuilt."
