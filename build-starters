#!/bin/sh
# build-starters: rebuild deploy/allspeak-<lang>.zip from starter/<lang>/.
#
# Each starter zip bundles the language-specific bootstrap files
# (CLAUDE.md, AGENTS.md, server.allspeak, edit.html) with the shared editor
# (asedit.allspeak, asedit-graph.allspeak, asedit.json) and the doc-block analyser
# all at the zip root.
#
# Run after editing anything under starter/ or after changing
# asedit.allspeak / asedit-graph.allspeak / asedit.json / tools/asdoc-check.py. Languages are
# auto-discovered from starter/*/ subdirectories.

set -eu
cd "$(dirname "$0")"

if [ ! -f asedit.allspeak ] || [ ! -f asedit.json ]; then
    echo "Error: asedit.allspeak / asedit.json not found in repo root." >&2
    exit 1
fi

if [ ! -f tools/asdoc-check.py ]; then
    echo "Error: tools/asdoc-check.py not found." >&2
    exit 1
fi

if ! command -v zip >/dev/null 2>&1; then
    echo "Error: 'zip' command not found." >&2
    exit 1
fi

mkdir -p deploy

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

built=0
for dir in starter/*/; do
    lang=$(basename "$dir")
    missing=
    for f in CLAUDE.md server.allspeak edit.html; do
        [ -f "$dir$f" ] || missing="$missing $f"
    done
    if [ -n "$missing" ]; then
        echo "  skip: starter/$lang missing:$missing"
        continue
    fi

    work="$STAGE/$lang"
    mkdir -p "$work"
    cp -p "$dir"CLAUDE.md "$dir"server.allspeak "$dir"edit.html "$work/"
    for extra in DEEPSEEK.md CODEWHALE.md AGENTS.md; do
        if [ -f "$dir$extra" ]; then
            cp -p "$dir$extra" "$work/"
        fi
    done
    cp -p asedit.allspeak asedit-graph.allspeak asedit.json tools/asdoc-check.py "$work/"

    out="$PWD/deploy/allspeak-$lang.zip"
    rm -f "$out"
    zip_files="CLAUDE.md server.allspeak edit.html asedit.json asedit.allspeak asedit-graph.allspeak asdoc-check.py"
    for extra in DEEPSEEK.md CODEWHALE.md AGENTS.md; do
        if [ -f "$work/$extra" ]; then
            zip_files="$zip_files $extra"
        fi
    done
    ( cd "$work" && zip -q "$out" $zip_files )

    echo "  built: deploy/allspeak-$lang.zip"
    built=$((built + 1))
done

echo "Done. $built starter packs rebuilt."
