!!  Tabbed script editor with auto-save and external change detection.
!!  Served by server.allspeak locally, or any web server with /list, /read, /write routes.
!   asedit.allspeak

    script ASEditor
!! @hash 57eacdb1
!! @verified 57eacdb1
!!!
!! Variable declarations
!! The script uses a lot of variables; they are grouped here by function.
!   -- DOM --
    div Body
    div TabBar
    div TabBtn
    div Overlay
    div Scroller
    div FileRow
    div EditorArea       ! flat-mode pane (CodeMirror-wrapped textarea)
    div BlocksArea       ! Blocks-mode pane (toolbar + split)
    div VizHost          ! Graph-mode pane: the panel the plot draws in (see the Graph sections)
    textarea ContentEditor
    textarea BlocksCodePane
    textarea BlocksDocPane
    span StatusSpan
    span TabLabel
    span BlocksTitle
    span BlocksBadge
    button OpenBtn
    button FindBtn
    button BlocksBtn
    button GraphBtn
    button BlocksPrev
    button BlocksNext
    button BlocksVerify
    button BlocksVerifyAll
    button CloseBtn
    img PlusBtn
    img TabClose
    a FileName
    pre UIPre

!   -- State --
    variable Lang
    variable StrOpen
    variable StrFind
    variable StrClose
    variable StrSaved
    variable StrSaveFailed
    variable StrReloaded
    variable StrExtChange
    variable StrNoConnect
    variable StrSaveAs
    variable StrEmpty
    variable StrUpLevel
    variable StrRoot
    variable StrUpdated
    variable StrRestart
    variable TabPath       ! array: full file path per tab (relative to project root)
    variable TabName       ! array: display name (basename) per tab
    variable TabSaved      ! array: last content saved to server per tab
    ! Where the flat editor was standing, per tab: the caret's line and the viewport's scroll offset.
    ! Two values and not one, because they are independent — scrolling does not move the insertion
    ! point, and coming back must not carry the view to the caret. A video editor teaches you to
    ! expect that; a text editor usually does not, and the jump is what catches you out.
    variable TabCursor     ! array: the caret's line, per tab
    variable TabView       ! array: the viewport's scroll offset, per tab
    variable TabCount
    variable ActiveTab
    variable Content       ! scratch: current editor content
    variable FileContent   ! scratch: content fetched from server
    variable FileList      ! scratch: JSON array from /list
    variable JsonLines     ! scratch: a JSON file's text split into lines
    variable JsonText      ! scratch: text on its way to the JSON formatter
    variable N
    variable M
    variable Item          ! scratch: single entry object from list
    variable File          ! scratch: single filename
    variable FileCount
    variable TabItem
    variable UIWebson
    variable VersionResult
    variable CurrentPath   ! current directory being browsed (relative, no leading /)
    variable EntryName
    variable EntryType

!   -- Blocks mode (parser + view + edit) --
    variable BlocksMode    ! 0 = flat, 1 = Blocks pane visible
    variable GraphMode     ! 0 = not graphed, 1 = Graph pane visible
    variable VizTrace      ! the trace text the Graph pane draws — the plot view's input
    variable VizSource     ! the script itself, drawn behind the heat — the same pane's second input
    variable TraceSize      ! bytes of the recording, which is what predicts the drawing time
    variable DrawStarted    ! `now` when the drawing began
    variable DrawMillis     ! how long it took
    variable VizMillisPerKb ! learned: milliseconds per kilobyte of recording, on this machine
    variable VizCalib
    variable VizCalibParsed
    variable VizPredicted
    variable VizCalibText
    variable TracePath     ! the trace file looked for, so "nothing to draw" can name it
    variable CurBlock      ! 0-based index into Sections arrays
    variable BlockDirty    ! 1 if user edited the current block since last splice
    variable SecCount      ! number of parsed sections
    variable SecStart      ! array: 1-based opener line number
    variable SecEnd        ! array: 1-based terminator line number
    variable SecProse      ! array: prose text (one entry, joined by newline, !! prefix stripped)
    variable SecCode       ! array: code text (joined by newline, verbatim)
    variable SecHash       ! array: stored @hash, or empty
    variable SecVerified   ! array: stored @verified, or empty
    variable SecHashState  ! array: fresh / stale / no-baseline / no-code
    variable SecVerifyState ! array: verified-fresh / verified-stale / unverified / verified-no-code
    variable Found         ! 1 if the search term was found in section I
    variable FoundPane     ! `code` or `doc` — pane that holds the match
    variable SearchTerm    ! the text being searched for (survives RenderBlock/RenderToc, which reuse Tmp)

!   -- Parser scratch (rebuilt every parse) --
    variable Lines         ! source split on newline
    variable LineCount
    variable Line
    variable Kind          ! `TERM`, `DOC`, `META`, `CODE`
    variable LContent      ! body of a DOC/META line
    variable MetaKey
    variable MetaValue
    variable Pos
    variable Tmp
    variable Tip              ! a sidebar row's tooltip, decided with its colour
    variable InSection
    variable SecHasCode
    variable SecStartTmp
    variable SecCodeTmp
    variable SecProseTmp
    variable SecHashTmp
    variable SecVerifiedTmp
    variable CurHash
    variable HashState
    variable VerifyState
    variable I
    variable Source        ! whole source text being parsed
    variable Outside       ! array: text between sections (length SecCount + 1)
    variable OutsideTmp    ! accumulator for the current outside chunk
    variable ProseSrc      ! scratch: prose text being split into lines
    variable PCount        ! scratch: count of prose lines
    variable PJ            ! scratch: index over prose lines
    variable PL            ! scratch: one prose line
    variable BlkText       ! scratch: assembled section text
    variable NewProse      ! scratch: edited prose pulled from BlocksDocPane
    variable NewCode       ! scratch: edited code pulled from BlocksCodePane
    variable OldProse      ! scratch: previously stored prose for this section
    variable OldCode       ! scratch: previously stored code for this section

!   -- Blocks: TOC + draggable divider --
    div BlocksToc          ! left sidebar listing all blocks
    div BlocksDivider      ! draggable splitter between code and doc panes
    div TocRow             ! one row per block in the TOC
    span TocLabel          ! the clickable label inside each TocRow
    variable PickPos       ! pick coords at mousedown on divider
    variable DragPos       ! drag coords during mousemove
    variable PickX
    variable DragX
    variable CodeWidthAtPick
    variable NewWidth
    variable StoredWidth
    variable FinalWidth
    variable FirstLine     ! first prose line of a block (for TOC label)
    variable From          ! first line of a block, for the review-signal test
    variable To            ! and its last line
    variable BlockAfter    ! index of the block after this one, which bounds it
    variable FromCheck     ! the two bounds moved out by one, so both tests can be positive
    variable ToCheck
    variable FlagCount     ! lines the plugin says nothing enters, over all blocks
    variable FlagLine      ! array: those lines
    variable K             ! walk index over the records, and over the flagged lines
    variable MarkRecord    ! one model record, as the walk reaches it
    variable MarkCount     ! how many records the plugin returned
    variable MarkLine      ! one flagged line, as the walk reaches it
    variable MarkRest      ! scratch: the record after `line=`
    variable MarkSpace     ! scratch: where its number ends
    variable MarkDigits    ! scratch: the number itself
    variable EditorPath    ! the current tab's path, handed to the plugin as its target
    variable Model         ! array: what the plugin returned
    variable NL
    variable J
!! @hash f9a59734
!! @verified f9a59734
!!!
!! The UI is described by a DOM element 'asedit-ui',
!! a <pre> element that contains all the DOM elements that go to make up the editor.
!! These are formatted using Webson, a JSON representation of any number of DOM elements,
!! which is rendered into an existing element using the 'render' command
!! 'body' without a capital, is the HTML <body> element
!! 'Body', where the first letter is a capital, is a variable that is attached to the page body
!! so that other elements - in this case those represented by the Webson -  can be added to it.
!   -- Build UI --
    attach Body to body
    attach UIPre to `asedit-ui`
    put the content of UIPre into UIWebson
    render UIWebson in Body
    attach TabBar to `se-tabbar`
    attach ContentEditor to `se-textarea`
    attach StatusSpan to `se-status`
    attach OpenBtn to `se-open`
    attach FindBtn to `se-findbtn`
    attach PlusBtn to `se-plusbtn`
    attach Overlay to `se-overlay`
    attach Scroller to `se-scroller`
    attach CloseBtn to `se-closebtn`
    attach BlocksBtn to `se-blocksbtn`
    attach GraphBtn to `se-graphbtn`
    attach VizHost to `se-graph-area`
    attach EditorArea to `se-editor-area`
    attach BlocksArea to `se-blocks-area`
    attach BlocksTitle to `se-blocks-title`
    attach BlocksPrev to `se-blocks-prev`
    attach BlocksNext to `se-blocks-next`
    attach BlocksBadge to `se-blocks-badge`
    attach BlocksVerify to `se-blocks-verify`
    attach BlocksVerifyAll to `se-blocks-verify-all`
    attach BlocksCodePane to `se-blocks-code`
    attach BlocksDocPane to `se-blocks-doc`
    attach BlocksToc to `se-blocks-toc`
    attach BlocksDivider to `se-blocks-divider`
!! @hash 8cb592d8
!! @verified 8cb592d8
!!!
!! Some general initialisation
!   -- CodeMirror --
    codemirror attach to ContentEditor

    put 0 into TabCount
    put 0 into ActiveTab
    put `` into CurrentPath
!! @hash 3a601096
!! @verified 3a601096
!!!
!! Language detection
!! The command 'language xx' switches the system to the given language (fr, de, it etc.)
!! and defaults to 'en'. All of the language-specific strings are then defined for each language.
!   -- Detect language and set strings for each supported language --
    div LangDiv
    put `en` into Lang
    attach LangDiv to `editor-lang` or go to SetStrings
    put the text of LangDiv into Lang
    replace ` ` with `` in Lang
    replace newline with `` in Lang
    if Lang is empty put `en` into Lang

SetStrings:
    if Lang is `it`
    begin
        put `Apri` into StrOpen
        put `Cerca` into StrFind
        put `Chiudi` into StrClose
        put `Salvato` into StrSaved
        put `Salvataggio fallito` into StrSaveFailed
        put `Ricaricato` into StrReloaded
        put `Modifica esterna rilevata` into StrExtChange
        put `Impossibile connettersi al server` into StrNoConnect
        put `Salva come (nome file senza .allspeak):` into StrSaveAs
        put `(cartella vuota)` into StrEmpty
        put `.. (livello superiore)` into StrUpLevel
        put `/ (radice progetto)` into StrRoot
        put `L'editor è stato aggiornato. Riavviare?` into StrUpdated
        put `Riavvia il server manualmente.` into StrRestart
    end
    else if Lang is `fr`
    begin
        put `Ouvrir` into StrOpen
        put `Rechercher` into StrFind
        put `Fermer` into StrClose
        put `Enregistré` into StrSaved
        put `Échec de l'enregistrement` into StrSaveFailed
        put `Rechargé` into StrReloaded
        put `Modification externe détectée` into StrExtChange
        put `Impossible de se connecter au serveur` into StrNoConnect
        put `Enregistrer sous (nom de fichier sans .allspeak) :` into StrSaveAs
        put `(dossier vide)` into StrEmpty
        put `.. (niveau supérieur)` into StrUpLevel
        put `/ (racine du projet)` into StrRoot
        put `L'éditeur a été mis à jour. Redémarrer ?` into StrUpdated
        put `Veuillez redémarrer le serveur manuellement.` into StrRestart
    end
    else if Lang is `de`
    begin
        put `Öffnen` into StrOpen
        put `Suchen` into StrFind
        put `Schließen` into StrClose
        put `Gespeichert` into StrSaved
        put `Speichern fehlgeschlagen` into StrSaveFailed
        put `Neu geladen` into StrReloaded
        put `Externe Änderung erkannt` into StrExtChange
        put `Verbindung zum Server nicht möglich` into StrNoConnect
        put `Speichern unter (Dateiname ohne .allspeak):` into StrSaveAs
        put `(leerer Ordner)` into StrEmpty
        put `.. (Ebene höher)` into StrUpLevel
        put `/ (Projektstamm)` into StrRoot
        put `Der Editor wurde aktualisiert. Neu starten?` into StrUpdated
        put `Bitte den Server manuell neu starten.` into StrRestart
    end
    else
    begin
        put `Open` into StrOpen
        put `Find` into StrFind
        put `Close` into StrClose
        put `Saved` into StrSaved
        put `Save failed` into StrSaveFailed
        put `Reloaded` into StrReloaded
        put `External change detected` into StrExtChange
        put `Cannot connect to server` into StrNoConnect
        put `Save as (filename without .allspeak):` into StrSaveAs
        put `(empty directory)` into StrEmpty
        put `.. (up one level)` into StrUpLevel
        put `/ (project root)` into StrRoot
        put `asedit has been updated. Restart to apply changes?` into StrUpdated
        put `Please restart the server manually.` into StrRestart
    end
    set the content of OpenBtn to StrOpen
    set the content of FindBtn to StrFind
    set the content of CloseBtn to StrClose
!! @hash 5633e443
!! @verified 5633e443
!!!
!! The editor checks on startup and periodically for updates to itself.
!! (explain)
!! then 
!   -- Check for updates --
    rest get VersionResult from `/version` or go VersionDone
    if VersionResult is `updated`
    begin
        if confirm StrUpdated
        begin
            rest get VersionResult from `/restart` or begin
                alert StrRestart
                go VersionDone
            end
            wait 3 seconds
            location the location

!			 Is this alternative valid?
!            rest get VersionResult from `/restart`
!            on failure alert StrRestart
!           	else
!            begin
!            	wait 3 seconds
!            	location the location
!            end
        end
    end
VersionDone:
!! @hash 96465c41
!! @verified 96465c41
!!!
!! Set up click handlers for the various editor functions.
!! Blocks-mode handlers (toggle, navigate, mark verified) live alongside
!! the existing flat-mode handlers. The pane editor textareas have
!! keyboard input handlers wired in EnterBlocks so we can stop watching
!! them when the pane is hidden.
!   -- Handlers --
    on click OpenBtn go to ShowBrowser
    on click PlusBtn go to NewFile
    on click FindBtn go to DoFind
    on click BlocksBtn go to ToggleBlocks
    on click GraphBtn go to ToggleGraph
    on click BlocksPrev go to PrevBlock
    on click BlocksNext go to NextBlock
    on click BlocksVerify go to MarkVerified
    on click BlocksVerifyAll go to MarkAllVerified

    on pick BlocksDivider
    begin
        put the pick position into PickPos
        put property `x` of PickPos into PickX
        put the width of BlocksCodePane into CodeWidthAtPick
    end
    on drag
    begin
        put the drag position into DragPos
        ! In Graph mode the Blocks pane is hidden, so every drag in that mode belongs to the picture.
        ! The two views never share the screen, which is what makes one handler enough.
        if GraphMode is 1 gosub to VizPan
        if GraphMode is 0
        begin
            put property `x` of DragPos into DragX
            put DragX into NewWidth
            take PickX from NewWidth
            add CodeWidthAtPick to NewWidth
            if NewWidth is less than 100 put 100 into NewWidth
            set style `flex` of BlocksCodePane to `0 0 ` cat NewWidth cat `px`
        end
    end
    on drop
    begin
        gosub to VizRelease
        if GraphMode is 1 return
        put the width of BlocksCodePane into FinalWidth
        put FinalWidth into storage as `asedit-blocks-code-width`
    end

    ! The Graph pane's own gestures. They are registered here because a handler belongs to the
    ! program that owns the page, while the window they move is the view's — the view exposes
    ! `VizGrab`, `VizPan`, `VizWheel` and `VizReset`, and this is the whole of the wiring between
    ! them. Wheel-alone scrolls, shift-wheel zooms and drag pans, all decided inside the view.
    on pick VizHost
    begin
        gosub to VizGrab
    end
    on wheel VizHost
    begin
        gosub to VizWheel
    end

    put 0 into BlocksMode
    put 0 into GraphMode
    put 0 into BlockDirty
!! @hash d758eb44
!! @verified d758eb44
!!!
!! While editor is running it periodically saves changes made by the user
!! and updates the display to show updates made externally.
!! This avoids the need for any Save mechanism.
!   -- Start background loops --
    fork to AutoSave
    fork to PollFile
    stop
!! @hash f86feb98
!! @verified f86feb98
!!!
!! Every half-second, changes to the content are saved.
!!
!! TabSaved is an array of tab contents. If its content differs from that currently held in the editor, the current content is saved to the file and TabSaved is updated.
!   -- Auto-save loop --
AutoSave:
    wait 500 millis
    if TabCount is 0
    begin
        fork to AutoSave
        stop
    end
    codemirror get content of ContentEditor into Content
    index TabSaved to ActiveTab
    if Content is not TabSaved
    begin
        index TabPath to ActiveTab
        if TabPath is empty
        begin
            if Content is empty
            begin
                fork to AutoSave
                stop
            end
            put prompt StrSaveAs into File
            if File is empty
            begin
                fork to AutoSave
                stop
            end
            put File cat `.allspeak` into File
            ! Save into the currently browsed directory
            if CurrentPath is not empty
                put CurrentPath cat `/` cat File into File
            index TabPath to ActiveTab
            put File into TabPath
            index TabName to ActiveTab
            put File into TabName
            gosub to RebuildTabBar
        end
        rest post Content to `/write/` cat TabPath or go SaveFailed
        index TabSaved to ActiveTab
        put Content into TabSaved
        set the content of StatusSpan to StrSaved
        fork to ClearStatus
    end
    fork to AutoSave
    stop

SaveFailed:
    set the content of StatusSpan to StrSaveFailed
    fork to ClearStatus
    fork to AutoSave
    stop
!! @hash 63538f67
!! @verified 63538f67
!!!
!! Every 3 seconds, the current file is re-read into FileContent.
!!
!! If this differs from what is currently held in TabSaved for this tab, the editor content is updated and a message is displayed briefly.
!   -- External change polling --
PollFile:
    wait 3 seconds
    if TabCount is 0
    begin
        fork to PollFile
        stop
    end
    ! A mode that owns the screen must not have its content reloaded underneath it. In Blocks mode the
    ! in-memory Sections array is the source of truth and a silent reload would clobber the user's pane
    ! edits; in Graph mode the poll replaced the editor's content every three seconds while the graph was
    ! up, which is when the drawing was seen to be overwritten. Either way, skip until the pane is left.
    if BlocksMode is 1 or GraphMode is 1 go to PollNext
    index TabPath to ActiveTab
    if TabPath is empty go to PollNext
    rest get FileContent from `/read/` cat TabPath or go PollNext
    ! Formatted as it is read, exactly as the loader formats it. Without this the poll compares a
    ! one-line file on disk against the formatted text in the tab, sees a difference on every pass,
    ! and reloads the file over the formatted text every three seconds — which is what "it formats
    ! it, then after a couple of seconds reverts to a one-liner" turned out to be. Like has to be
    ! compared with like for the poll to settle.
    if TabPath ends with `.json`
    begin
        put FileContent into JsonText
        gosub to FormatJson
        put JsonText into FileContent
    end
    codemirror get content of ContentEditor into Content
    index TabSaved to ActiveTab
    if FileContent is not TabSaved
    begin
        if Content is TabSaved
        begin
            ! Editor is clean -- silently reload
            put FileContent into TabSaved
            codemirror set content of ContentEditor to FileContent
            set the content of StatusSpan to StrReloaded
            fork to ClearStatus
        end
        else
        begin
            set the content of StatusSpan to StrExtChange
        end
    end
PollNext:
    fork to PollFile
    stop
!! @hash bbd67e70
!! @verified bbd67e70
!!!
!! File browser overlay behind the Open button: lists the current directory, navigates into folders and back to the project root, and hands the chosen file to the tab-management section to open.
!   -- File browser with directory navigation --
ShowBrowser:
    ! Opening a tab while Blocks mode is up leaves the panes out of sync with
    ! the active tab's source; switch back to flat mode first.
    if BlocksMode is 1 gosub to DoExitBlocks
    rest get FileList from `/list/` cat CurrentPath or go BrowserError
    put the json count of FileList into FileCount
    set the elements of FileRow to FileCount
    set the elements of FileName to FileCount
    set the content of Scroller to ``

    ! Show current path at top
    create FileRow in Scroller
    set the style of FileRow to `padding:4px 8px;font-size:0.85em;color:#666;border-bottom:1px solid #ddd`
    if CurrentPath is empty
        set the content of FileRow to StrRoot
    else
        set the content of FileRow to `/` cat CurrentPath

    ! Show "back" row if inside a subdirectory
    if CurrentPath is not empty
    begin
        create FileRow in Scroller
        set the style of FileRow to `padding:4px 8px;cursor:pointer;background:#f0f0ff`
        set the content of FileRow to StrUpLevel
        on click FileRow go to GoUp
    end

    if FileCount is 0
    begin
        create FileRow in Scroller
        set the style of FileRow to `padding:4px 8px;color:#999`
        set the content of FileRow to StrEmpty
    end

    put 0 into N
    while N is less than FileCount
    begin
        put element N of FileList into Item
        put property `name` of Item into EntryName
        put property `type` of Item into EntryType
        index FileRow to N
        create FileRow in Scroller
        set the style of FileRow to `padding:3px 8px;cursor:pointer`
        index FileName to N
        create FileName in FileRow
        if EntryType is `dir`
        begin
            set the style of FileName to `display:block;padding:3px 0;cursor:pointer;font-weight:bold`
            set the content of FileName to `📁 ` cat EntryName
        end
        else
        begin
            set the style of FileName to `display:block;padding:3px 0;cursor:pointer`
            set the content of FileName to EntryName
        end
        on click FileName go to SelectEntry
        add 1 to N
    end
    on click CloseBtn go to CloseBrowser
    set style `display` of Overlay to `block`
    stop

GoUp:
    put the position of the last `/` in CurrentPath into N
    if N is less than 0
        put `` into CurrentPath
    else
        put left N of CurrentPath into CurrentPath
    go to ShowBrowser

BrowserError:
    set the content of StatusSpan to StrNoConnect
    fork to ClearStatus
    stop

!   -- Entry selected in browser --
SelectEntry:
    put the index of FileName into N
    put element N of FileList into Item
    put property `name` of Item into EntryName
    put property `type` of Item into EntryType
    if EntryType is `dir`
    begin
        ! Navigate into directory
        if CurrentPath is empty
            put EntryName into CurrentPath
        else
            put CurrentPath cat `/` cat EntryName into CurrentPath
        go to ShowBrowser
    end
    ! Build full relative path and open file
    if CurrentPath is empty
        put EntryName into TabItem
    else
        put CurrentPath cat `/` cat EntryName into TabItem
    set style `display` of Overlay to `none`
    put EntryName into File
    go to OpenFile

CloseBrowser:
    set style `display` of Overlay to `none`
    stop
!! @hash ac5d5c01
!! @verified ac5d5c01
!!!
!! This section is tab management; creating a new tab, opening a file, selecting a tab and closing a tab.
!! Activating a tab leaves Blocks mode first. A tab is a different file, and Blocks mode belongs to the file you were reading — so switching tabs, and opening a file, both land in the flat editor rather than refusing to move until you leave the mode by hand.
!! **A tab remembers where the flat editor was standing** — the caret's line and the viewport's scroll offset — and puts both back on return, whether the reader left by the tab bar, the Blocks button or the Graph one. Two values rather than one because they are independent: scrolling must not move the insertion point, and coming back must not carry the view to the caret, which is the jump a video editor teaches you to distrust. `codemirror` carries a command for each half and each half only — `cursor to line` does not scroll and `view to` does not move the caret — and the scroll one refreshes the editor on the way, which a CodeMirror hidden by a mode switch needs.
!   Make room for one more tab: the count up by one and every per-tab array grown to match. **In one
!   place, and that is the point of it.** There are two ways to open a tab — the + button and the file
!   browser — and each used to grow the arrays itself, so an array added for one of them is a tab that
!   fails in the other. That is not hypothetical: the caret and view records added for the tab
!   restoration above went into `NewFile` only, and opening a *file* then died with "Array index 1 is
!   out of range for 'TabCursor'" the moment a second tab existed with no slot to hold it.
!   `CloseTab` shifts the value-carrying arrays back down when a tab goes — the element ones are rebuilt
!   from the count instead — so it is the other place that has to know this list, and there are only two.
!
!   The new slots start empty, which is what the readers want: `TabRestore` asks whether a value is
!   *numeric* rather than whether the slot holds anything, and a fresh tab has nowhere to restore to.
TabGrow:
    add 1 to TabCount
    set the elements of TabPath to TabCount
    set the elements of TabName to TabCount
    set the elements of TabSaved to TabCount
    set the elements of TabCursor to TabCount
    set the elements of TabView to TabCount
    set the elements of TabBtn to TabCount
    set the elements of TabLabel to TabCount
    set the elements of TabClose to TabCount
    return

!   -- New empty tab --
NewFile:
    put TabCount into N
    gosub to TabGrow
    index TabPath to N
    put `` into TabPath
    index TabName to N
    put `new` into TabName
    index TabSaved to N
    put `` into TabSaved
    put N into ActiveTab
    go to ActivateTab

!   -- Open a file (TabItem=relative path, File=display name) --
OpenFile:
    ! Check if already open in a tab
    put 0 into N
    while N is less than TabCount
    begin
        index TabPath to N
        if TabPath is TabItem
        begin
            put N into ActiveTab
            go to ActivateTab
        end
        add 1 to N
    end
    ! Not open -- load from server and create a new tab
    rest get Content from `/read/` cat TabItem or go BrowserError
    if TabItem ends with `.json`
    begin
        put Content into JsonText
        gosub to FormatJson
        put JsonText into Content
    end
    gosub to TabGrow
    index TabPath to N
    put TabItem into TabPath
    index TabName to N
    put File into TabName
    index TabSaved to N
    put Content into TabSaved
    put N into ActiveTab
    go to ActivateTab

!   -- A JSON file arrives minified as often as not, and one line of it is unreadable --
FormatJson:
    ! Only a file that is *one line* is reformatted. A file already laid out, at whatever indent its
    ! author chose, is left exactly as it is — the complaint is that one line of JSON is unreadable,
    ! not that somebody's formatting is wrong, and normalising it would rewrite their file the first
    ! time they saved. `json split` divides on newline by default, so the test costs two statements
    ! and needs no new vocabulary.
    json split JsonText into JsonLines
    if the json count of JsonLines is greater than 1 return
    ! The formatted text is what the tab records as its own, so opening a file does not mark it
    ! modified — and because the poll formats the file it reads in just the same way, the two agree
    ! and the tab settles rather than reloading itself every three seconds. Malformed JSON is left
    ! as it is: a file that will not parse is the one you most want to look at, so the error is
    ! caught rather than reported. The runtime's own formatter does the work — `json format` is
    ! JSON.stringify with a two-space indent, the same indent the Python runtime writes on save.
    json format JsonText or go FormatJsonEnd
FormatJsonEnd:
    return

!   -- Switch to an existing tab --
SwitchTab:
    put the index of TabLabel into ActiveTab
    go to ActivateTab

!   -- Close a tab --
CloseTab:
    put the index of TabClose into M
    ! Shift elements above M down by one
    put M into N
    add 1 to N
    while N is less than TabCount
    begin
        index TabPath to N
        put TabPath into File
        subtract 1 from N
        index TabPath to N
        put File into TabPath
        add 1 to N
        index TabName to N
        put TabName into File
        subtract 1 from N
        index TabName to N
        put File into TabName
        add 1 to N
        index TabSaved to N
        put TabSaved into FileContent
        subtract 1 from N
        index TabSaved to N
        put FileContent into TabSaved
        add 1 to N
        index TabCursor to N
        put TabCursor into Tmp
        subtract 1 from N
        index TabCursor to N
        put Tmp into TabCursor
        add 1 to N
        index TabView to N
        put TabView into Tmp
        subtract 1 from N
        index TabView to N
        put Tmp into TabView
        add 1 to N
        add 1 to N
    end
    subtract 1 from TabCount
    if TabCount is 0
    begin
        put 0 into ActiveTab
        codemirror set content of ContentEditor to ``
        set the content of TabBar to ``
        stop
    end
    ! Adjust ActiveTab if it was after the closed tab
    if ActiveTab is greater than M subtract 1 from ActiveTab
    ! Clamp ActiveTab to valid range
    put TabCount into FileCount
    subtract 1 from FileCount
    if ActiveTab is greater than FileCount
    begin
        put FileCount into ActiveTab
    end
    go to ActivateTab

!   Where the flat editor is standing, remembered per tab and put back on return. The caret and the
!   view are kept apart on purpose: `codemirror cursor to line` does not scroll and
!   `codemirror view to` does not move the caret, so a revisit restores both without one dragging
!   the other. Restoring the caret *and then* the view is the order that matters — the view is the
!   one that has to end up exact, and setting the caret cannot disturb it.
TabRemember:
    if TabCount is 0 return
    index TabCursor to ActiveTab
    codemirror get cursor of ContentEditor into TabCursor
    index TabView to ActiveTab
    codemirror view of ContentEditor into TabView
    return

TabRestore:
    if TabCount is 0 return
    ! `is numeric` and not `is not empty`: a tab that has never been left has an untouched slot, and
    ! zero is a perfectly good caret line and scroll offset — so the test has to be about the kind of
    ! value, not about whether there is one.
    index TabCursor to ActiveTab
    if TabCursor is numeric codemirror cursor to line TabCursor in ContentEditor
    index TabView to ActiveTab
    if TabView is numeric codemirror view to TabView in ContentEditor
    return

ActivateTab:
    gosub to DoExitPanes
    gosub to TabRemember
    index TabSaved to ActiveTab
    codemirror set content of ContentEditor to TabSaved
    gosub to TabRestore
    gosub to RebuildTabBar
    stop
!! @hash a64446ec
!! @verified a64446ec
!!!
!! Rebuilding the tab bar is done by assigning styles to each tab to indicate which one is current.
RebuildTabBar:
!   -- Rebuild tab bar --
    set the content of TabBar to ``
    put 0 into N
    while N is less than TabCount
    begin
        index TabBtn to N
        create TabBtn in TabBar
        if N is ActiveTab
        begin
            set the style of TabBtn to `display:flex;align-items:center;gap:4px;padding:4px 10px;cursor:pointer;background:#555;color:white;border-bottom:2px solid lightgreen`
        end
        else
        begin
            set the style of TabBtn to `display:flex;align-items:center;gap:4px;padding:4px 10px;cursor:pointer;background:#3a3a3a;color:#aaa`
        end
        index TabLabel to N
        create TabLabel in TabBtn
        index TabName to N
        set the text of TabLabel to TabName
        on click TabLabel go to SwitchTab
        index TabClose to N
        create TabClose in TabBtn
        set attribute `src` of TabClose to `https://allspeak.ai/icon/stop.png`
        set the style of TabClose to `width:12px;height:12px;opacity:0.6;cursor:pointer`
        on click TabClose go to CloseTab
        add 1 to N
    end
    return
!! @hash 1347598c
!! @verified 1347598c
!!!
!! Here are some utility functions.
!! DoFind searches in flat mode via CodeMirror's find dialog; in Blocks mode it jumps to the next block whose code or prose contains the text selected in either pane (wrapping around), highlighting the match so repeated presses walk through the hits.
!   -- Find --
DoFind:
    if BlocksMode is 1 go to FindInBlocks
    codemirror find in ContentEditor
    stop

FindInBlocks:
    ! Blocks-mode find: walk the sections after the current one (wrapping)
    ! for the term selected in either pane and jump to the first hit.
    put the selected text into SearchTerm
    if SearchTerm is empty
    begin
        set the content of StatusSpan to `Select text in a pane to search blocks`
        fork to ClearStatus
        stop
    end
    put CurBlock into I
    add 1 to I
    while I is not CurBlock
    begin
        put I modulo SecCount into I
        if I is CurBlock go to FindNotFound
        gosub to BlockContains
        if Found is 1 go to FindMatch
        add 1 to I
    end
FindNotFound:
    set the content of StatusSpan to `No other block contains ` cat SearchTerm
    fork to ClearStatus
    stop
FindMatch:
    put I into CurBlock
    gosub to RenderBlock
    gosub to SelectOccurrence
    put CurBlock into I
    add 1 to I
    set the content of StatusSpan to `Found in block ` cat I cat ` of ` cat SecCount
    fork to ClearStatus
    stop

BlockContains:
    ! Search section I's code then prose for the term (SearchTerm); sets Found and FoundPane.
    put 0 into Found
    index SecCode to I
    put the position of SearchTerm in SecCode into Pos
    if Pos is not less than 0
    begin
        put 1 into Found
        put `code` into FoundPane
        return
    end
    index SecProse to I
    put the position of SearchTerm in SecProse into Pos
    if Pos is not less than 0
    begin
        put 1 into Found
        put `doc` into FoundPane
    end
    return

SelectOccurrence:
    ! Highlight the first occurrence of the term (SearchTerm) in the pane that matched.
    if FoundPane is `code`
    begin
        index SecCode to CurBlock
        put the position of SearchTerm in SecCode into Pos
        if Pos is not less than 0
        begin
            put Pos into N
            put the length of SearchTerm into M
            add N to M
            set the selection of BlocksCodePane from N to M
        end
    end
    else
    begin
        index SecProse to CurBlock
        put the position of SearchTerm in SecProse into Pos
        if Pos is not less than 0
        begin
            put Pos into N
            put the length of SearchTerm into M
            add N to M
            set the selection of BlocksDocPane from N to M
        end
    end
    return

!   -- Utilities --
ClearStatus:
    wait 3 seconds
    set the content of StatusSpan to ``
    stop
!! @hash 74b13222
!! @verified 74b13222
!!!
!! Blocks parser. Walks the current Source line-by-line and populates the per-section arrays (Start, End, Prose, Code, Hash, Verified, HashState, VerifyState) plus the Outside-content array used to preserve text between sections during rebuild.
!!
!! Same classifier logic as tools/asdoc-check.allspeak — the spec is one source of truth even though the code is duplicated here for the editor's in-process use.
ParseSource:
    put 0 into SecCount
    put 0 into InSection
    put `` into Source
    codemirror get content of ContentEditor into Source
    put Source into Lines
    split Lines
    put the elements of Lines into LineCount
    set the elements of Outside to 1
    index Outside to 0
    put `` into Outside
    put `` into OutsideTmp
    put 0 into N
    while N is less than LineCount
    begin
        index Lines to N
        put Lines into Line
        gosub to Classify
        if InSection is 0 gosub to OutsideDispatch
        else gosub to InsideDispatch
        add 1 to N
    end
    if InSection is 1
    begin
        ! Unclosed section — close synthetically so user can still see it.
        gosub to CloseSection
    end
    ! Save trailing outside chunk; need to grow Outside one past the last
    ! per-section index allocated by OpenSection.
    put SecCount into Tmp
    add 1 to Tmp
    set the elements of Outside to Tmp
    index Outside to SecCount
    put OutsideTmp into Outside

    !   -- Review signals --
    ! What the parse cannot see for itself: blocks nothing enters. The viz plugin compiles
    ! the same source and reports it. Nothing here raises an error — a buffer mid-edit
    ! frequently will not compile, which is the editor's ordinary condition, and the plugin
    ! simply reports fewer records. With no flags the TOC renders exactly as it did before.
    put 0 into FlagCount
    index TabPath to ActiveTab
    put TabPath into EditorPath
    model the script in EditorPath as Source giving Model
    put the elements of Model into MarkCount
    put 0 into K
    while K is less than MarkCount
    begin
        index Model to K
        put Model into MarkRecord
        if MarkRecord starts with `anchor | reachable=no` gosub to NoteMarker
        add 1 to K
    end

    ! A script the plugin cannot compile yields no anchors and so no flags — which used to
    ! look exactly like a clean file. The plugin reports why in a `problem` record, so say it:
    ! a reviewer's first question about an empty picture is whether there was anything to draw.
    ! The record carries the runtime's own wording, so it is already in the reader's language.
    put 0 into K
    while K is less than MarkCount
    begin
        index Model to K
        put Model into MarkRecord
        if MarkRecord starts with `problem |` gosub to NoteProblem
        add 1 to K
    end
    return

OutsideDispatch:
    if Kind is `DOC` gosub to OpenSection
    else if Kind is `META` gosub to OpenSection
    else
    begin
        if OutsideTmp is empty put Line into OutsideTmp
        else put OutsideTmp cat newline cat Line into OutsideTmp
    end
    return

InsideDispatch:
    if Kind is `TERM` gosub to CloseSection
    else if Kind is `META` gosub to RecordMeta
    else if Kind is `DOC` gosub to AppendProse
    else if Kind is `CODE` gosub to AppendCode
    return

!   Classify the current line as code/comment or documentation
Classify:
    put `CODE` into Kind
    if Line is `!!!`
    begin
        put `TERM` into Kind
        return
    end
    if Line is `!!`
    begin
        put `DOC` into Kind
        put `` into LContent
        return
    end
    if Line starts with `!! ` or Line starts with `!!` cat tab
    begin
        put `DOC` into Kind
        put from 3 of Line into LContent
        gosub to MaybeMeta
        return
    end
    return

!   Deal with @ (META)
MaybeMeta:
    if LContent starts with `@`
    begin
        put `META` into Kind
        put from 1 of LContent into Tmp
        put the position of ` ` in Tmp into Pos
        if Pos is less than 0
        begin
            put Tmp into MetaKey
            put `` into MetaValue
        end
        else
        begin
            put left Pos of Tmp into MetaKey
            add 1 to Pos
            put from Pos of Tmp into MetaValue
        end
    end
    return

OpenSection:
    ! Finalize the outside chunk that ended with the previous line.
    put SecCount into Tmp
    add 1 to Tmp
    set the elements of Outside to Tmp
    index Outside to SecCount
    put OutsideTmp into Outside
    put `` into OutsideTmp
    put N into SecStartTmp
    add 1 to SecStartTmp
    put 1 into InSection
    put `` into SecProseTmp
    put `` into SecCodeTmp
    put `` into SecHashTmp
    put `` into SecVerifiedTmp
    put 0 into SecHasCode
    if Kind is `META` gosub to RecordMeta
    if Kind is `DOC` gosub to AppendProse
    return

RecordMeta:
    if MetaKey is `hash` put MetaValue into SecHashTmp
    if MetaKey is `verified` put MetaValue into SecVerifiedTmp
    return

AppendProse:
    if SecProseTmp is empty put LContent into SecProseTmp
    else put SecProseTmp cat newline cat LContent into SecProseTmp
    return

AppendCode:
    if SecCodeTmp is empty put Line into SecCodeTmp
    else put SecCodeTmp cat newline cat Line into SecCodeTmp
    if Line is not `` put 1 into SecHasCode
    return

CloseSection:
    ! Compute hash + states.
    if SecHasCode is 0 gosub to ScoreNoCode
    else gosub to ScoreWithCode
    ! Grow all the per-section arrays by one and store this section.
    put SecCount into I
    add 1 to SecCount
    set the elements of SecStart to SecCount
    set the elements of SecEnd to SecCount
    set the elements of SecProse to SecCount
    set the elements of SecCode to SecCount
    set the elements of SecHash to SecCount
    set the elements of SecVerified to SecCount
    set the elements of SecHashState to SecCount
    set the elements of SecVerifyState to SecCount
    index SecStart to I
    put SecStartTmp into SecStart
    index SecEnd to I
    put N into SecEnd
    add 1 to SecEnd
    index SecProse to I
    put SecProseTmp into SecProse
    index SecCode to I
    put SecCodeTmp into SecCode
    index SecHash to I
    put CurHash into SecHash    ! store current hash as the live one (not stale-stored)
    index SecVerified to I
    put SecVerifiedTmp into SecVerified
    index SecHashState to I
    put HashState into SecHashState
    index SecVerifyState to I
    put VerifyState into SecVerifyState
    put 0 into InSection
    put `` into OutsideTmp
    return

ScoreNoCode:
    put `` into CurHash
    put `no-code` into HashState
    if SecVerifiedTmp is empty put `unverified` into VerifyState
    else put `verified-no-code` into VerifyState
    return

ScoreWithCode:
    put hash SecCodeTmp into Tmp
    put left 8 of Tmp into CurHash
    if SecHashTmp is empty put `no-baseline` into HashState
    else if SecHashTmp is CurHash put `fresh` into HashState
    else put `stale` into HashState
    if SecVerifiedTmp is empty put `unverified` into VerifyState
    else if SecVerifiedTmp is CurHash put `verified-fresh` into VerifyState
    else put `verified-stale` into VerifyState
    return
!! @hash fab5b751
!! @verified fab5b751
!!!
!! Blocks view.
!! ToggleBlocks switches between flat and Blocks panes.
!! EnterBlocks parses the current source, opens the block containing the flat editor's cursor line (so the pane lands where you were working), and scrolls the TOC to that block.
!! ExitBlocks flushes pending edits, reveals the flat pane again, and scrolls it to the start of the block just viewed; the work is in DoExitBlocks so ShowBrowser can call it as a subroutine before opening a tab.
!! RenderBlock paints the textareas and the toolbar badge for the current section.
!! UpdateBadge derives badge text/colour from the section's hash and verify states.
ToggleBlocks:
    if BlocksMode is 0 go to EnterBlocks
    go to ExitBlocks

!   Enter Blocks mode
!   **At most one mode is on, and `DoExitPanes` is where that is said.** Every entry point turns the
!   others off through it rather than each naming the ones it happens to know about — which is how
!   this one came to miss the Graph pane: it was written before Graph existed, and nothing pointed at
!   the assumption. The omission had two faces, and Graham found both by the one path that showed it,
!   Graph then Blocks: the Graph button still read `Edit`, so two buttons offered to leave a pane
!   neither of which was on, and `VizHost` was never hidden, so the graph sat under the Blocks pane.
EnterBlocks:
    gosub to DoExitPanes
    gosub to ParseSource
    if SecCount is 0
    begin
        set the content of StatusSpan to `No doc blocks in this file`
        fork to ClearStatus
        stop
    end
    ! Open the block containing the flat editor's cursor: the last section
    ! whose opener line is at or above the cursor's line, so a cursor in the
    ! gap between two blocks lands on the block above. Falls back to block 0
    ! when the cursor is above the first section.
    codemirror get cursor of ContentEditor into Tmp
    add 1 to Tmp
    put 0 into CurBlock
    put 0 into I
    while I is less than SecCount
    begin
        index SecStart to I
        if SecStart is not greater than Tmp put I into CurBlock
        add 1 to I
    end
    put 1 into BlocksMode
    ! The toggle button now leaves Blocks mode, so relabel it.
    set the content of BlocksBtn to `Edit`
    set style `display` of EditorArea to `none`
    set style `display` of BlocksArea to `flex`
    ! Restore divider position from previous session if persisted.
    get StoredWidth from storage as `asedit-blocks-code-width`
    if StoredWidth is `null` put 0 into StoredWidth
    if StoredWidth is `undefined` put 0 into StoredWidth
    if StoredWidth is empty put 0 into StoredWidth
    if StoredWidth is greater than 100
        set style `flex` of BlocksCodePane to `0 0 ` cat StoredWidth cat `px`
    gosub to RenderToc
    ! Reveal the current block's row in the TOC sidebar.
    index TocRow to CurBlock
    scroll TocRow into view
    gosub to RenderBlock
    stop

!   Exit Blocks mode
ExitBlocks:
    gosub to DoExitBlocks
    stop

!   Exit Blocks mode (callable as a subroutine -- e.g. from ShowBrowser)
DoExitBlocks:
    gosub to FlushBlock
    ! Re-parse so SecStart reflects any line shifts from the flush rebuild.
    gosub to ParseSource
    put 0 into BlocksMode
    ! Back in flat mode the toggle button re-enters Blocks mode.
    set the content of BlocksBtn to `Blocks`
    set style `display` of BlocksArea to `none`
    set style `display` of EditorArea to `block`
    ! Scroll the flat editor so the start of the block just viewed is visible.
    if SecCount is greater than 0
    begin
        ! Guard against a stale CurBlock (e.g. tab switched while in Blocks mode).
        if CurBlock is not less than SecCount
        begin
            put SecCount into Tmp
            take 1 from Tmp
            put Tmp into CurBlock
        end
        index SecStart to CurBlock
        put SecStart into Tmp
        take 1 from Tmp
        codemirror scroll to line Tmp in ContentEditor
    end
    ! Remembered here rather than on the way *in*, because leaving is what moves the editor: the
    ! scroll above is deliberate and puts the block's start at the top, and that is where the reader
    ! then is. Every way out of Blocks passes through this subroutine — the button, a tab switch, and
    ! the way into Graph — so one save here covers all of them, and the pair of values is consistent
    ! whichever way the reader came back.
    gosub to TabRemember
    return

NextBlock:
    put SecCount into Tmp
    take 2 from Tmp
    if CurBlock is greater than Tmp stop
    gosub to FlushBlock
    add 1 to CurBlock
    gosub to RenderBlock
    stop

PrevBlock:
    if CurBlock is less than 1 stop
    gosub to FlushBlock
    take 1 from CurBlock
    gosub to RenderBlock
    stop

RenderBlock:
    index SecProse to CurBlock
    set the content of BlocksDocPane to SecProse
    index SecCode to CurBlock
    set the content of BlocksCodePane to SecCode
    gosub to UpdateBadge
    gosub to RenderToc
    return

UpdateBadge:
    put CurBlock into I
    add 1 to I
    set the content of BlocksTitle to `Block ` cat I cat ` of ` cat SecCount
    index SecVerifyState to CurBlock
    put SecVerifyState into VerifyState
    index SecHashState to CurBlock
    put SecHashState into HashState
    if VerifyState is `verified-fresh`
    begin
        set the content of BlocksBadge to `verified · fresh`
        set style `background` of BlocksBadge to `#2e7d32`
    end
    else if VerifyState is `verified-stale`
    begin
        set the content of BlocksBadge to `verified · stale`
        set style `background` of BlocksBadge to `#f9a825`
    end
    else if HashState is `no-code`
    begin
        set the content of BlocksBadge to `no code`
        set style `background` of BlocksBadge to `#666`
    end
    else
    begin
        set the content of BlocksBadge to `unverified`
        set style `background` of BlocksBadge to `#666`
    end
    return
!! @hash 4464102e
!! @verified 4464102e
!!!
!! Blocks save.
!! FlushBlock pushes the current pane edits back into the
!! per-section arrays (recomputing the section's hash if its code changed)
!! and rebuilds the full source by walking Outside + Section + Outside +
!! ... etc. The new source is written to ContentEditor (CodeMirror), which
!! the existing AutoSave loop persists to disk on its next iteration.
!! No-op if neither pane changed.
!!
FlushBlock:
    if BlocksMode is 0 return
    put the text of BlocksDocPane into NewProse
    put the text of BlocksCodePane into NewCode
    index SecProse to CurBlock
    put SecProse into OldProse
    index SecCode to CurBlock
    put SecCode into OldCode
    if NewProse is OldProse and NewCode is OldCode return
    index SecProse to CurBlock
    put NewProse into SecProse
    index SecCode to CurBlock
    put NewCode into SecCode
    ! Recompute hash and states for the edited block.
    put NewCode into SecCodeTmp
    put NewProse into SecProseTmp
    put 0 into SecHasCode
    if NewCode is not empty put 1 into SecHasCode
    index SecVerified to CurBlock
    put SecVerified into SecVerifiedTmp
    index SecHash to CurBlock
    put SecHash into SecHashTmp
    if SecHasCode is 0 gosub to ScoreNoCode
    else gosub to ScoreWithCode
    index SecHash to CurBlock
    put CurHash into SecHash
    index SecHashState to CurBlock
    put HashState into SecHashState
    index SecVerifyState to CurBlock
    put VerifyState into SecVerifyState
    gosub to RebuildSource
    codemirror set content of ContentEditor to Source
    gosub to UpdateBadge
    set the content of StatusSpan to `Block flushed`
    fork to ClearStatus
    return

RebuildSource:
    index Outside to 0
    put Outside into Source
    put 0 into I
    while I is less than SecCount
    begin
        gosub to BuildSectionText
        put Source cat BlkText into Source
        add 1 to I
        index Outside to I
        put Source cat newline cat Outside into Source
    end
    return

BuildSectionText:
    ! Reads I; writes BlkText with section I's reassembled lines.
    put `` into BlkText
    index SecProse to I
    put SecProse into Tmp
    if Tmp is not empty
    begin
        put Tmp into ProseSrc
        split ProseSrc
        put the elements of ProseSrc into PCount
        put 0 into PJ
        while PJ is less than PCount
        begin
            index ProseSrc to PJ
            put ProseSrc into PL
            if PL is empty put BlkText cat `!!` cat newline into BlkText
            else put BlkText cat `!! ` cat PL cat newline into BlkText
            add 1 to PJ
        end
    end
    index SecCode to I
    put SecCode into Tmp
    if Tmp is not empty put BlkText cat Tmp cat newline into BlkText
    index SecHash to I
    put SecHash into Tmp
    if Tmp is not empty put BlkText cat `!! @hash ` cat Tmp cat newline into BlkText
    index SecVerified to I
    put SecVerified into Tmp
    if Tmp is not empty put BlkText cat `!! @verified ` cat Tmp cat newline into BlkText
    put BlkText cat `!!!` into BlkText
    return
!! @hash d3dbcc0b
!! @verified d3dbcc0b
!!!
!! Mark verified — writes the current code's hash into the section's
!! "@verified" slot, then flushes so the file picks it up. The badge turns
!! green on the next render.
!! MarkAllVerified does the same for every code-bearing section in one pass.
!! It is a bulk, self-attestation action, so it asks for confirmation first —
!! a single misclick would otherwise wipe the file's granular verification record.
MarkVerified:
    if BlocksMode is 0 stop
    gosub to FlushBlock      ! ensure SecHash reflects current code first
    index SecHash to CurBlock
    put SecHash into SecHashTmp
    if SecHashTmp is empty stop    ! no-code section, nothing to verify
    index SecVerified to CurBlock
    put SecHashTmp into SecVerified
    put `verified-fresh` into Tmp
    index SecVerifyState to CurBlock
    put Tmp into SecVerifyState
    gosub to RebuildSource
    codemirror set content of ContentEditor to Source
    gosub to UpdateBadge
    set the content of StatusSpan to `Marked verified`
    fork to ClearStatus
    stop

MarkAllVerified:
    if BlocksMode is 0 stop
    gosub to FlushBlock      ! ensure the current block's hash is current too
    ! Count the code-bearing sections; only those can carry a @verified mark.
    put 0 into N
    put 0 into I
    while I is less than SecCount
    begin
        index SecHash to I
        if SecHash is not empty add 1 to N
        add 1 to I
    end
    if N is 0 stop
    if N is 1 put `Mark 1 block as verified?` into Tmp
    else put `Mark all ` cat N cat ` blocks as verified?` into Tmp
    if confirm Tmp
    begin
        put 0 into I
        while I is less than SecCount
        begin
            index SecHash to I
            if SecHash is not empty
            begin
                index SecVerified to I
                put SecHash into SecVerified
                index SecVerifyState to I
                put `verified-fresh` into SecVerifyState
            end
            add 1 to I
        end
        gosub to RebuildSource
        codemirror set content of ContentEditor to Source
        gosub to RenderBlock
        if N is 1 put `Marked 1 block verified` into Tmp
        else put `Marked ` cat N cat ` blocks verified` into Tmp
        set the content of StatusSpan to Tmp
        fork to ClearStatus
    end
    stop
!! @hash b0f5bf9f
!! @verified b0f5bf9f
!!!
!! Take the line out of `anchor | reachable=no | kind=label | line=NN | ...`, so a block
!! can be told whether it is one nothing enters. The anchor record is the documented shape, which is why its line can be read positionally — a finding's line lives in prose and cannot.
NoteMarker:
    put the position of `line=` in MarkRecord into Pos
    add 5 to Pos
    put from Pos of MarkRecord into MarkRest
    put the position of ` ` in MarkRest into MarkSpace
    if MarkSpace is less than 0 put MarkRest into MarkDigits
    else put left MarkSpace of MarkRest into MarkDigits
    ! The line number is read out of a record, so it arrives as text. Comparing text with the
    ! numeric block bounds does not coerce here, so the whole range test silently fails — the
    ! same reason `add 0 to` is used for numbers read from strings elsewhere in this codebase.
    add 0 to MarkDigits
    ! Grow the array first, then write the new last element: sizing to the current count and
    ! indexing it would ask for element 0 of an empty list on the first flag. This is the same
    ! order the editor's own CloseSection uses, for the same reason.
    put FlagCount into I
    add 1 to FlagCount
    set the elements of FlagLine to FlagCount
    index FlagLine to I
    put MarkDigits into FlagLine
    return
!! @hash e3dfc5f8
!! @verified e3dfc5f8
!!!
!! Say, in the status line, why the analysis could not run. The plugin reports a script it could not compile as a `problem` record, and without this the result is indistinguishable from a file with nothing wrong in it.
NoteProblem:
    put the position of `| does not compile` in MarkRecord into Pos
    if Pos is less than 0 put MarkRecord into MarkRest
    else
    begin
        add 13 to Pos
        put from Pos of MarkRecord into MarkRest
    end
    set the content of StatusSpan to MarkRest
    return
!! @hash 09c88156
!! @verified 09c88156
!!!
!! Decide whether one block's line range holds a flagged line. The bounds are widened by one so that both tests can be positive: `is not less than` is a form the editor avoids elsewhere.
BlockFlagged:
    put 0 into Found
    put From into FromCheck
    subtract 1 from FromCheck
    put To into ToCheck
    add 1 to ToCheck
    put 0 into K
    while K is less than FlagCount
    begin
        index FlagLine to K
        put FlagLine into MarkLine
        if MarkLine is greater than FromCheck and MarkLine is less than ToCheck put 1 into Found
        add 1 to K
    end
    return
!! @hash b832c0aa
!! @verified b832c0aa
!!!
!! Blocks TOC. Renders one row per parsed section in the BlocksToc
!! sidebar, highlighting the current block. Each row's label is the
!! first prose line of its section, truncated. Clicking a row flushes
!! any pending edit and jumps to that block.
!! Rows are shaded dark by verification state — green = verified, amber = stale, grey = unverified — so the blue current row stands out at a glance.
RenderToc:
    set the content of BlocksToc to ``
    set the elements of TocRow to SecCount
    set the elements of TocLabel to SecCount
    put 0 into J
    while J is less than SecCount
    begin
        index TocRow to J
        create TocRow in BlocksToc
        ! Colour and tooltip are decided together, so a row can never carry a colour without
        ! saying what it means. The tooltips are the legend: a reviewer should be able to read
        ! every state off the sidebar without being told them anywhere else.
        put `padding:4px 10px;cursor:pointer` into Tmp
        put `Not yet verified` into Tip
        if J is CurBlock
        begin
            put Tmp cat `;background:#1e88e5;color:white` into Tmp
            put `You are reading this block` into Tip
        end
        else
        begin
            index SecVerifyState to J
            put SecVerifyState into VerifyState
            if VerifyState is `verified-fresh`
            begin
                put Tmp cat `;background:#1b5e20` into Tmp
                put `Verified: the prose and the code still agree` into Tip
            end
            else if VerifyState is `verified-stale`
            begin
                put Tmp cat `;background:#a26d18` into Tmp
                put `Verified once, but the code has changed since — worth a look` into Tip
            end
            else put Tmp cat `;background:#3f3f3f` into Tmp
        end
        set the style of TocRow to Tmp
        set attribute `title` of TocRow to Tip
        index SecProse to J
        put SecProse into ProseSrc
        put the position of newline in ProseSrc into NL
        if NL is less than 0 put ProseSrc into FirstLine
        else put left NL of ProseSrc into FirstLine
        put J into Tmp
        add 1 to Tmp
        put Tmp cat `. ` cat FirstLine into FirstLine

        ! Does anything enter this block? The row's own colour already carries the
        ! verification state, so the flag goes on the label and the two signals stay on
        ! separate channels.
        index SecStart to J
        put SecStart into From
        put J into BlockAfter
        add 1 to BlockAfter
        if BlockAfter is less than SecCount
        begin
            index SecStart to BlockAfter
            put SecStart into To
            subtract 1 from To
        end
        else put 1000000 into To
        gosub to BlockFlagged


        index TocLabel to J
        create TocLabel in TocRow
        set the content of TocLabel to FirstLine
        ! A block nothing enters gets a solid background rather than only a struck label: it is
        ! unmissable at a glance, and a reviewer should not have to read every row to find the one
        ! that is unreachable. The trade is that such a row shows this instead of its verification
        ! colour, which is the right way round — an orphaned block is the more urgent fact.
        if Found is 1
        begin
            set the style of TocRow to `background:#b71c1c;color:white`
            set attribute `title` of TocRow to `Orphaned: nothing enters this block, so none of its code can run`
        end
        if Found is 1 set the style of TocLabel to `text-decoration:line-through;opacity:0.55`
        on click TocLabel go to JumpToBlock
        add 1 to J
    end
    return

JumpToBlock:
    put the index of TocLabel into Tmp
    if Tmp is CurBlock stop
    gosub to FlushBlock
    put Tmp into CurBlock
    gosub to RenderBlock
    stop
!! @hash 56b2a0d3
!! @verified 56b2a0d3
!!!
!! Graph mode: a third view — the run drawn, not the script.
!!
!! Blocks mode reads the script's *shape*; this reads what a *run* did. Those are different questions asked of the same file, which is why it is a third pane rather than another setting on either existing one: a code review asks what the code is made of, and a run review asks where the flow went.
!!
!! **The recording is not made here.** It is a file beside the script — `<script>.viz.json`, which the runtime writes with `--trace=` — so a run captured on remote hardware arrives with the project however the project travels, and reviewing a script never has to execute it. This pane reads that file and draws it, nothing more.
!!
!! **The plumbing is one sentence.** Markers decide what is recorded, and a script without them has nothing to show; rather than explain that in the pane, the message names the file it looked for, because that is the one thing a reader needs in order to produce one.
!!
!! The drawing itself is a portable section, appended below and kept verbatim from `various/plotview.allspeak`, so the same AllSpeak can be lifted into another host. Its declarations must come *before* their use in this file, which is why `VizTrace` is declared with the editor's own variables rather than with the section.
!!
!! **Leaving is automatic when a tab changes.** A mode owns the screen, so opening or switching to a file drops back to the flat editor rather than loading the new script into a pane nobody can see — which is what happened the first time this pane was used, and what Blocks has always done. The rule lives in `ActivateTab`, so every path that shows a file obeys it.
ToggleGraph:
    if GraphMode is 0 go to EnterGraph
    gosub to DoExitGraph
    ! Back to the flat editor exactly where it was left — the caret *and* the view, which is what the
    ! pane remembering its own state now means for this side too. It is the same pair a tab switch
    ! restores, through the same two subroutines, so there is one answer to "where was I" rather than
    ! one per way of leaving.
    !
    ! This is the only path out of Graph mode that restores: the other is a tab change, which is a
    ! different file and starts wherever its own record says.
    gosub to TabRestore
    stop

!   Entering shows the pane, reads the recording beside the current script and draws it.
!   Leaving Blocks mode first is deliberate: the panes are alternatives, not layers.
EnterGraph:
    gosub to DoExitPanes
    put 1 into GraphMode
    set the content of GraphBtn to `Edit`
    set style `display` of EditorArea to `none`
    set style `display` of BlocksArea to `none`
    set style `display` of VizHost to `flex`
    ! Where the flat editor was standing, so leaving puts it back there. Read before the editor is
    ! hidden: a hidden editor still answers, but reading it while it is up is the honest order.
    gosub to TabRemember
    index TabPath to ActiveTab
    put TabPath cat `.viz.json` into TracePath
    ! Say so before the wait rather than after it. A recording of a big run takes tens of seconds to
    ! draw, and a pane that sits empty for that long reads as a fault — while a line that says what
    ! is happening costs nothing and answers the only question the reader has. Cleared once it is up.
    set the content of StatusSpan to `Drawing the recording - please wait`
    rest get VizTrace from `/read/` cat TracePath or go GraphNone
    put the length of VizTrace into TraceSize
    ! The script itself, for the source behind the heat. Read separately from the recording because
    ! they are different files, and read *after* it because a missing recording is the one failure
    ! worth reporting: a source that will not read leaves the picture plain, which is legible.
    put `` into VizSource
    rest get VizSource from `/read/` cat TabPath or put `` into VizSource
    ! The view decides for itself whether this is a new run — see the note at that comparison in the
    ! drawing section. It was the host's call until the pane learned to come back: re-fitting here
    ! meant every visit to the Graph pane threw the zoom and the pan away, which is the opposite of
    ! what a return visit is for.
    gosub to VizPredict
    put now into DrawStarted
    gosub to Draw
    subtract DrawStarted from now giving DrawMillis
    gosub to VizRemember
    fork to ClearStatus
    stop

!   What a recording will cost, said before the wait rather than discovered during it. A recording
!   costs roughly in proportion to its size, so one number learned on this machine predicts the next.
!   Nothing is said on a first run: there is no measurement yet, and a guess would be worse than
!   silence. The two constants at the end are the whole of the judgement.
VizPredict:
    if TraceSize is 0 return
    put 0 into VizMillisPerKb
    rest get VizCalib from `/read/.viz-calibration.json` or go VizPredictJudged
    put json of VizCalib into VizCalibParsed
    put property `millis_per_kb` of VizCalibParsed into VizMillisPerKb
VizPredictJudged:
    if VizMillisPerKb is 0 return
    ! Multiply before dividing: the rate is per kilobyte and the recording is counted in bytes.
    multiply TraceSize by VizMillisPerKb giving VizPredicted
    divide VizPredicted by 1024 giving VizPredicted
    if VizPredicted is less than 5000 return
    divide VizPredicted by 1000 giving VizPredicted
    ! Say where the number comes from. It is a measurement of the last drawing, not a promise, and
    ! a stale one is self-explanatory when the reader knows that — which matters, because a single
    ! slow run sets the rate and the next run corrects it.
    alert `This recording is ` cat TraceSize cat ` bytes, and the last drawing of one this size took about ` cat VizPredicted cat ` seconds on this machine, so this may too. Carry on, or narrow the viz start and viz stop markers to the part you want to watch.`
    return

!   And remember what it actually cost, so the next prediction is a measurement rather than a guess.
!   Overwritten rather than averaged: a machine's speed is not a thing to smooth, and the last
!   measurement is the only evidence there is.
VizRemember:
    if TraceSize is 0 or DrawMillis is less than 1 return
    multiply DrawMillis by 1024 giving VizPredicted
    divide VizPredicted by TraceSize giving VizMillisPerKb
    put `{` cat `"millis_per_kb": ` cat VizMillisPerKb cat `}` into VizCalibText
    rest post VizCalibText to `/write/.viz-calibration.json` or return
    return

!   Nothing to draw, and the message names the file that was missing rather than what a marker is.
GraphNone:
    set the content of StatusSpan to `No recording beside this script: ` cat TracePath
    fork to ClearStatus
    stop

!   Leaving puts the flat editor back and relabels the button, so the pane's state is legible from
!   the button alone.
DoExitGraph:
    put 0 into GraphMode
    set the content of GraphBtn to `Graph`
    set style `display` of VizHost to `none`
    set style `display` of EditorArea to `block`
    return

!   Turn off every mode there is. The panes are alternatives, not layers, so each one's entry point
!   has to turn the others off before turning itself on — and the list of "the others" belongs in one
!   place, or the next pane added is missed by whichever entrant was written before it existed. That
!   is exactly what happened to `EnterBlocks` and the Graph pane, and it showed as the Graph button
!   still reading `Edit` (two buttons offering to leave a pane neither of which was on) with the
!   graph left lying under the Blocks pane.
!
!   Called by `EnterBlocks`, `EnterGraph` and `ActivateTab`. A fourth pane means changing this and
!   nothing else.
DoExitPanes:
    if BlocksMode is 1 gosub to DoExitBlocks
    if GraphMode is 1 gosub to DoExitGraph
    return
!! @hash c21eb940
!! @verified c21eb940
!!!
!! plotview.allspeak — the run as a picture, drawn in AllSpeak with the svg plugin.
!!
!! The third view's drawing, grown from the front. Plot-only on purpose: the editor already renders
!! the script beside it, so this draws what the editor cannot — the sequence, the arrivals, and the
!! flow between them.
!!
!! **One path per kind of mark.** An AllSpeak element is a declared symbol, so a script cannot
!! create N elements for N marks. What it can do is grow one path's `d` attribute by concatenation
!! and let the browser draw the whole layer from it, so the marks cost string building rather than
!! DOM nodes. A trace of 9 arrivals and 10 transfers is two elements. Per-mark colour would need one
!! path per colour band, which is what the heat ramp will use.
!!
!! **Geometry is in viewBox units, and the run is shown through a window.** Nothing is measured in pixels: the frame is fixed at 1000x700 and the browser fits it to whatever panel it is given, which is what lets the whole script run against a stub DOM in node. What the window decides is *which part of the run* fills that frame. It starts fitted to the whole recording, so the first picture is the one this pane has always drawn; then wheel-alone scrolls it, shift-wheel zooms it, and a drag pans it. Graham's scheme, from Kdenlive and Audacity.
!!
!! **The window is held as two ranges in the trace's own units, never as a scale factor.** A factor would have to be relative to a fit that changes with the recording, and an absolute one ends up pinned at one end — the prototype's own lesson, where the same control read 51.6 px a step for one window and 0.7 for another. Multiplying before dividing keeps that arithmetic exact, as it does for the marks.
!!
!! **The window doubles as the reset.** Both gestures clamp at the edges of the run, so zooming out returns to the whole picture and panning stops at its ends; there is no reset button to find. The window is fitted once per *recording* and kept across visits, so the pane comes back as it was left; opening a different run is what re-fits it, and `VizReset` is there for a host that wants to force one.
!!
!! **The gestures are four entry points, and the host wires them up.** `VizGrab` on pick, `VizPan` on drag, `VizWheel` on wheel and `VizReset` for a host that wants the window fitted afresh. They live here rather than in the host because the window is the view's own state, and a host that wants the picture to move has only to call them.
!!
!! **The source is drawn behind the heat, once, and shown through a window.** An element is a declared symbol, so there cannot be one `svgtext` per source line — but one `<image>` carries the whole run, and its `href` is an SVG *document* the view builds itself out of `json split` and `replace`. That is why it is a document rather than a canvas raster: the language can already build one, so nothing new had to be invented to reach a canvas it has no words for, and it stays vector, so the text does not go soft past the scale it was rendered at.
!!
!! **The picture never changes; the window over it does.** `VizPane` is a nested `<svg>` the size of the frame, and its `viewBox` is the whole of the zoom and the pan — one attribute per draw, and the picture itself is drawn once when the run is opened. That is what keeps the text the shape it was written in: a window whose aspect followed the zoom instead is what stretched the letters as you zoomed in. The pane's size being the frame is also the clipping, which is the one thing a picture cannot do for itself — an `<image>` either scales its content to its own box or is clipped by the outer viewport.
!!
!! **The zoom stops where the text is drawn at its own size.** A source line is eighteen units tall, so a window of fewer than `VizGlyphRows` rows would only blow the text up, and there is nothing more to see. Applied before the clamp to the run, so a recording shorter than that many lines simply has no vertical zoom — the whole run is already legible and there is nothing to zoom into.
!!
!! **The key is part of the drawing, not a caption on it.** The colours are the whole of the heat, so a
!! reader who cannot see which counts each band covers is looking at a picture with no scale — and the
!! boundaries move with the run, because the band size is derived from the busiest line in it. So the
!! ranges are computed per draw from the same division that chose the colours, and printed beside
!! swatches in the ramp's own colours.
!!
!! **The trap this had to dodge:** numbers read out of the trace stay *text*, and text compares
!! lexically — `9` is not less than `10` — so the range-finding below converts with `add 0 to …`
!! before it compares anything. Without that the picture is silently wrong, which is the failure
!! mode the project's own notes warn about.
!! The view's own symbols, all prefixed `Viz…`.
!!
!! Names are the scarce resource in a flat table of declared symbols — which is not a figure of
!! speech: an earlier version collided with the host's own `Y2` and the compiler refused it as a
!! duplicate. Everything the section declares is therefore `Viz…`, so it can sit inside an editor
!! that has its own drawings, elements and variables.
!!
!! `VizHost` (the panel it draws in) and `VizTrace` (the trace, already fetched) are the host's, and
!! are declared by whoever embeds this. Acquisition stays on the host side, as the plugin contract
!! says, so this section never fetches anything and never has to execute a script to draw a run.
    variable VizReady        ! set once the elements exist, so a redraw only redraws
    variable VizParsed
    variable VizEvents
    variable VizEvent
    variable VizArgs
    variable VizCategory
    variable VizIndex
    variable VizLine
    variable VizSteps
    variable VizOffset
    variable VizMinLine
    variable VizMaxLine
    variable VizMaxSteps
    variable VizSpanLines
    variable VizDotSize
    variable VizCaptionText
    variable VizBreathe
    variable VizLineCounts  ! per-line command counts, from the window
    variable VizMaxCount
    variable VizBandSize
    variable VizCount
    variable VizBand
    variable VizHeatD
    variable VizHeatE
    variable VizHeatF
    variable VizHeatG
    variable VizBands
    variable VizKeyX
    variable VizKeyTextX
    variable VizKeyPitch
    variable VizKeyLo
    variable VizKeyHi
    variable VizMargin
    variable VizPlotW
    variable VizPlotH
    variable VizPlotRight
    variable VizPlotBottom
    ! The flow, one path per kind of movement, because the colour *is* the kind. `branch` — the
    ! compiler's own `if`/`while`/`wait` jumps — is deliberately not among them: scaffolding is not a
    ! program jump, and the trace keeps it a separate kind precisely so a reader can be spared it.
    ! The prototype drew it in grey behind a "compiler jumps" toggle; wanted here, that is a fourth
    ! path and a button.
    variable VizFlowCallD
    variable VizFlowJumpD
    variable VizFlowReturnD
    ! The arrow head's three corners, computed per transfer — the head is what tells a reader which
    ! end of a vertical segment is the destination, which at low zoom is otherwise a coin toss.
    variable VizHeadL
    variable VizHeadR
    variable VizHeadY
    ! One faint rule across the frame for every line the run touched, so that a mark or a transfer's
    ! end can be placed on a line at low zoom, where the text is a texture and a mark is a dot.
    variable VizRulesD
    ! The lines the recording *names* — an arrival, or an end of a transfer — as a padded string, and
    ! one line of it at a time for the membership test. See `VizRuleAdd`: the language has no set.
    variable VizRuledLines
    variable VizRuledLine
    variable VizRuleLine
    variable VizRuleEnd
    variable VizRuleY
    variable VizKind           ! the transfer's kind, while choosing its path
    variable VizSegment        ! one transfer's path data, segment and head together
    variable VizX
    variable VizY
    variable VizY2
    variable VizTickStep
    variable VizXStep
    variable VizTickValue
    variable VizTickPos
    variable VizOutside
    ! The window on the run that the picture shows, in the trace's own units — steps across, lines
    ! down. A *window*, not a pair of scale factors: a factor would have to be relative to a fit that
    ! changes with the recording, where an absolute one sits pinned at one end — the prototype's own
    ! lesson, the same control reading 51.6 px a step for one window and 0.7 for another. It is
    ! fitted to the whole recording when a run is opened, so the first picture is the one this pane
    ! has always drawn; a gesture then moves the window, and nothing else about the drawing changes.
    variable VizViewX0
    variable VizViewXW
    variable VizViewY0
    variable VizViewYH
    variable VizViewTemp
    variable VizViewFit
    variable VizDrawing
    ! The source behind the heat. It is a *picture* rather than text — one `<image>` for the whole
    ! run — because an element is a declared symbol, so there cannot be one `svgtext` per line; the
    ! picture is built once per run and only its geometry moves after that.
    variable VizSourceLines      ! the script, split into lines by `json split`
    variable VizSourceCount
    variable VizSourceLine
    variable VizSourceIndex
    variable VizSourceAt
    ! The recording this window was fitted to. The *same* recording is the same run, and a visit back
    ! to the pane should find the zoom and the pan where they were left; a different one means the
    ! window means nothing, and is fitted afresh. This is what replaced the host calling `VizReset` on
    ! every entry — which was the same thing as throwing the view away each time, and is not what a
    ! return visit is for.
    variable VizLastTrace
    variable VizLastSource    ! and the script the picture was drawn from, for the same reason
    variable VizNewRun        ! 1 when this draw's recording is not the last one drawn
    variable VizGlyphBody         ! the picture's rows, escaped and encoded once per run
    variable VizGlyphWidth        ! the document's natural size, in the units the text is drawn at
    variable VizGlyphHeight
    variable VizGlyphRows         ! a window may not go below this: past it the text is at its own size
    variable VizGlyphMax
    variable VizWindowX
    variable VizWindowY
    variable VizWindowW
    variable VizWindowH
    ! Which axes a zoom notch applies to. Shift is the lines, control is the steps, and both together
    ! are both — the modifiers decide, so one handler serves all three cases.
    variable VizZoomAcross
    variable VizZoomDown
    ! The gestures' own scratch. `VizGrabFromX/Y` is where the window stood when the drag began, so
    ! a pan is measured from the grab rather than accumulated step by step — an accumulated one
    ! drifts, because the runtime's division truncates and every step loses its remainder.
    variable VizGrabPos
    variable VizGrabbed
    variable VizGrabX
    variable VizGrabY
    variable VizGrabFromX
    variable VizGrabFromY
    variable VizDragPos
    variable VizDragX
    variable VizDragY
    variable VizDx
    variable VizDy
    variable VizPixelsW
    variable VizPixelsH
    variable VizPixelsK
    variable VizWheelAmount
    variable VizZoomXW
    variable VizZoomYH
    variable VizMove
    ! The window as it was before the gesture now running, so `VizRedraw` can tell whether anything
    ! changed. See `VizNote` for why it is kept rather than re-derived.
    variable VizMoved
    variable VizWasX0
    variable VizWasXW
    variable VizWasY0
    variable VizWasYH

    svg VizCanvas
    rect VizFrame
    ! The source, drawn behind everything else: declared and created first, so the marks sit on top of
    ! it. It is shown through `VizPane`, a nested `<svg>` the size of the frame, and `VizGlyphs` is the
    ! picture itself. See the note where they are created for why it takes two elements to do it.
    svg VizPane
    svgimage VizGlyphs
    path VizRules         ! a faint rule across the frame for every line the run touched
    path VizHeat0           ! the marks, coloured by how much work the line carried
    path VizHeat1
    path VizHeat2
    path VizHeat3
    path VizFlowCall      ! the flow, one path per kind of movement: the colour is the kind
    path VizFlowJump
    path VizFlowReturn
    ! Scratch values are named by role rather than pushed on a stack, which would be the neater
    ! idiom in Python: the view has to run in the JS runtime, where there is no `stack` type and
    ! `push`/`pop` mean the argument and call stacks instead. See language-pack-issues.md #16.
    !
    ! The y labels are a pool, not a set built to fit: an element is a declared symbol, so the view
    ! cannot make a label per tick any more than it can make a mark per arrival. Four are declared and
    ! assigned; the count is the axis's resolution, which is all a tick count is.
    svgtext VizYLabel0
    svgtext VizYLabel1
    svgtext VizYLabel2
    svgtext VizYLabel3
    svgtext VizXLabel0
    svgtext VizXLabel1
    svgtext VizXLabel2
    svgtext VizXLabel3
    svgtext VizCaption      ! says which run the picture is of, so a stale one shows
    ! The key: a swatch per colour band with the counts it covers beside it. A pool for the same
    ! reason the axis labels are one, and it carries the only thing the colours cannot say for
    ! themselves — a heat picture without it is a mystery, since a reader has no way to tell whether
    ! a shade means two visits or two hundred.
    rect VizKeyBox0
    rect VizKeyBox1
    rect VizKeyBox2
    rect VizKeyBox3
    svgtext VizKeyLabel0
    svgtext VizKeyLabel1
    svgtext VizKeyLabel2
    svgtext VizKeyLabel3
Draw:
    ! A draw gives the browser a turn every hundred marks, so it can still be *running* when the next
    ! gesture arrives — and two draws interleaved would each resume at the other's position. This flag
    ! is what the gestures check: a pan or a zoom that lands mid-draw is dropped rather than allowed to
    ! collide, and the next wheel notch or drag event is a moment away.
    put 1 into VizDrawing
    put json of VizTrace into VizParsed
    put property `traceEvents` of VizParsed into VizEvents

    ! ---- built once, on the first draw ----
    ! The panel is the host's (`VizHost`, declared and created by whoever embeds this) and the trace
    ! arrives in `VizTrace` already fetched: acquisition stays on the host side, as the plugin
    ! contract says. Building the elements once is what makes a redraw a redraw — the marks are
    ! attributes, so a second call replaces them instead of adding a second picture.
    if VizReady is 1 go to VizBuilt

    ! The drawing's frame, in viewBox units. These belong to the host's panel in the end — they are
    ! the one place the view still assumes a size — but a constant keeps the maths in whole numbers,
    ! which this runtime wants anyway: its arithmetic is integer-first and division truncates.
    put 60 into VizMargin
    put 880 into VizPlotW
    put 580 into VizPlotH
    put VizMargin into VizPlotRight
    add VizPlotW to VizPlotRight
    put VizMargin into VizPlotBottom
    add VizPlotH to VizPlotBottom
    ! The rows a window may not go below. The text is drawn at eighteen units a line, so a window of
    ! this many rows is one where a source line is already as tall as it is drawn — there is no more
    ! detail to be had past it, and zooming further only blows the picture up. Derived rather than
    ! chosen, so it follows the frame if the frame ever comes from the host.
    divide VizPlotH by 18 giving VizGlyphRows

    create VizCanvas in VizHost
    set attribute `viewBox` of VizCanvas to `0 0 1000 700`
    set attribute `preserveAspectRatio` of VizCanvas to `xMidYMid meet`
    set attribute `font-size` of VizCanvas to 15
    set attribute `fill` of VizCanvas to `#8b93a1`

    create VizFrame in VizCanvas
    set attribute `x` of VizFrame to 60
    set attribute `y` of VizFrame to 60
    set attribute `width` of VizFrame to 880
    set attribute `height` of VizFrame to 580
    set attribute `fill` of VizFrame to `none`
    set attribute `stroke` of VizFrame to `#3a4048`

    ! The source, behind the frame's contents, shown through a window. `VizPane` is a nested `<svg>`
    ! the size of the frame — and it is there because it is the one thing a picture cannot do for
    ! itself. An `<image>` either scales its content to its own box, which is what stretched the text
    ! as the zoom changed, or is clipped by the outer viewport, which is the whole canvas. A picture
    ! that is *moved* rather than resized therefore needs a container that clips, and a nested viewport
    ! does that by default: it is `overflow: hidden`, and it has no viewBox of its own until one is
    ! given. That viewBox is the whole of the zoom and the pan — one attribute per draw.
    !
    ! The style is not decoration. With none, the plugin defaults to `width:100%;height:100%`, and CSS
    ! beats the width and height attributes, so the pane would fill the canvas whatever it was told.
    create VizPane in VizCanvas style `overflow:hidden`
    set attribute `preserveAspectRatio` of VizPane to `none`
    set attribute `x` of VizPane to VizMargin
    set attribute `y` of VizPane to VizMargin
    set attribute `width` of VizPane to VizPlotW
    set attribute `height` of VizPane to VizPlotH
    ! The picture, one document unit to one unit — the size the text is actually written at — and
    ! placed by the pane's viewBox rather than by its own rectangle. Its width and height are set by
    ! `VizSourceMeasure`, because they depend on the run.
    create VizGlyphs in VizPane
    set attribute `preserveAspectRatio` of VizGlyphs to `none`
    set attribute `x` of VizGlyphs to 0
    set attribute `y` of VizGlyphs to 0

    ! A rule per line the run touched, faint and across the whole frame. It is drawn *over* the source
    ! so a line can be picked out of the texture, and *under* everything else so it never competes
    ! with a mark: at low zoom a mark is a dot in mid-space, and the rule is what says which line the
    ! dot belongs to. Kept faint deliberately — it is a grid, not a reading.
    create VizRules in VizCanvas
    set attribute `stroke` of VizRules to `#eee`
    set attribute `stroke-width` of VizRules to 1
    set attribute `fill` of VizRules to `none`

    create VizYLabel0 in VizCanvas
    create VizYLabel1 in VizCanvas
    create VizYLabel2 in VizCanvas
    create VizYLabel3 in VizCanvas
    set attribute `text-anchor` of VizYLabel0 to `end`
    set attribute `text-anchor` of VizYLabel1 to `end`
    set attribute `text-anchor` of VizYLabel2 to `end`
    set attribute `text-anchor` of VizYLabel3 to `end`

    create VizXLabel0 in VizCanvas
    create VizXLabel1 in VizCanvas
    create VizXLabel2 in VizCanvas
    create VizXLabel3 in VizCanvas
    set attribute `text-anchor` of VizXLabel0 to `middle`
    set attribute `text-anchor` of VizXLabel1 to `middle`
    set attribute `text-anchor` of VizXLabel2 to `middle`
    set attribute `text-anchor` of VizXLabel3 to `middle`

    ! The caption sits under the plot and names the window this run covered. A recording is a
    ! file beside the script, so a run that failed to record leaves the *previous* one in place
    ! and the picture looks exactly as convincing as a fresh one — the line numbers are what
    ! let a reader tell, and they are only useful if they are on the picture.
    create VizCaption in VizCanvas
    set attribute `text-anchor` of VizCaption to `start`

    ! A mark is a *stroked* hairline with a round cap, not a filled one: `M x y h0.01` alone fills to
    ! nothing at all, and stroked without the cap it is a 0.01-long rectangle — so the cap belongs to
    ! the mark, not to a scheme. Its width is set with the geometry on every draw, where the span is
    ! known; see the note at that site.
    !
    ! The heat ramp's four bands, coolest first, and the only scheme. The marks were once drawn a
    ! second time by a plain single-colour path; the fold removed the duplication, and with it the
    ! template that the mark-size and line-cap mistakes were both copied from.
    create VizHeat0 in VizCanvas
    set attribute `fill` of VizHeat0 to `none`
    set attribute `stroke` of VizHeat0 to `#6b8fa8`
    set attribute `stroke-linecap` of VizHeat0 to `round`
    create VizHeat1 in VizCanvas
    set attribute `fill` of VizHeat1 to `none`
    set attribute `stroke` of VizHeat1 to `#c9a227`
    set attribute `stroke-linecap` of VizHeat1 to `round`
    create VizHeat2 in VizCanvas
    set attribute `fill` of VizHeat2 to `none`
    set attribute `stroke` of VizHeat2 to `#e07b39`
    set attribute `stroke-linecap` of VizHeat2 to `round`
    create VizHeat3 in VizCanvas
    set attribute `fill` of VizHeat3 to `none`
    set attribute `stroke` of VizHeat3 to `#e5484d`
    set attribute `stroke-linecap` of VizHeat3 to `round`

    ! The flow, a path per kind, in the prototype's own colours. A transfer says where control went,
    ! and *how* it went is the interesting part: a `gosub` and a `return` are the same gesture drawn
    ! the same way until the colour tells them apart. `branch` is not drawn at all — see the note on
    ! the declarations for why the scaffolding is left out rather than greyed.
    create VizFlowCall in VizCanvas
    set attribute `stroke` of VizFlowCall to `#e0a44a`
    set attribute `stroke-width` of VizFlowCall to 2
    set attribute `fill` of VizFlowCall to `none`
    create VizFlowJump in VizCanvas
    set attribute `stroke` of VizFlowJump to `#43c6a8`
    set attribute `stroke-width` of VizFlowJump to 2
    set attribute `fill` of VizFlowJump to `none`
    create VizFlowReturn in VizCanvas
    set attribute `stroke` of VizFlowReturn to `#c07ad0`
    set attribute `stroke-width` of VizFlowReturn to 2
    set attribute `fill` of VizFlowReturn to `none`

    ! The key, laid out once — only the ranges it names change with the run. It sits on the caption's
    ! line, in the right half of the frame so a long caption cannot run into it, and its swatches are
    ! the ramp's own colours: the two things a reader needs in order to trust the picture, which run
    ! this is and what the colours mean, end up side by side.
    divide VizPlotW by 2 giving VizKeyX
    add VizMargin to VizKeyX
    divide VizPlotW by 8 giving VizKeyPitch

    create VizKeyBox0 in VizCanvas
    set attribute `x` of VizKeyBox0 to VizKeyX
    set attribute `y` of VizKeyBox0 to 679
    set attribute `width` of VizKeyBox0 to 10
    set attribute `height` of VizKeyBox0 to 10
    set attribute `fill` of VizKeyBox0 to `#6b8fa8`
    create VizKeyLabel0 in VizCanvas
    set attribute `text-anchor` of VizKeyLabel0 to `start`
    add 14 to VizKeyX
    move VizKeyLabel0 to VizKeyX 690
    add VizKeyPitch to VizKeyX
    take 14 from VizKeyX

    create VizKeyBox1 in VizCanvas
    set attribute `x` of VizKeyBox1 to VizKeyX
    set attribute `y` of VizKeyBox1 to 679
    set attribute `width` of VizKeyBox1 to 10
    set attribute `height` of VizKeyBox1 to 10
    set attribute `fill` of VizKeyBox1 to `#c9a227`
    create VizKeyLabel1 in VizCanvas
    set attribute `text-anchor` of VizKeyLabel1 to `start`
    add 14 to VizKeyX
    move VizKeyLabel1 to VizKeyX 690
    add VizKeyPitch to VizKeyX
    take 14 from VizKeyX

    create VizKeyBox2 in VizCanvas
    set attribute `x` of VizKeyBox2 to VizKeyX
    set attribute `y` of VizKeyBox2 to 679
    set attribute `width` of VizKeyBox2 to 10
    set attribute `height` of VizKeyBox2 to 10
    set attribute `fill` of VizKeyBox2 to `#e07b39`
    create VizKeyLabel2 in VizCanvas
    set attribute `text-anchor` of VizKeyLabel2 to `start`
    add 14 to VizKeyX
    move VizKeyLabel2 to VizKeyX 690
    add VizKeyPitch to VizKeyX
    take 14 from VizKeyX

    create VizKeyBox3 in VizCanvas
    set attribute `x` of VizKeyBox3 to VizKeyX
    set attribute `y` of VizKeyBox3 to 679
    set attribute `width` of VizKeyBox3 to 10
    set attribute `height` of VizKeyBox3 to 10
    set attribute `fill` of VizKeyBox3 to `#e5484d`
    create VizKeyLabel3 in VizCanvas
    set attribute `text-anchor` of VizKeyLabel3 to `start`
    add 14 to VizKeyX
    move VizKeyLabel3 to VizKeyX 690

    put 1 into VizReady

VizBuilt:
    ! ---- drawn every time ----
    ! **The drawing is swapped, not cleared and redrawn.** Everything a draw produces is built in the
    ! variables below — the four mark strings, the flow string, every label's text and the picture's
    ! window — and *nothing* is written to the DOM until the end, in one run of statements that cannot
    ! be interrupted. So the screen always shows one whole picture or another, never a half-built one,
    ! and there is no buffer to keep: the buffer is the variables and the swap is the last block.
    !
    ! **Why nothing is written here any more, and it is worth knowing.** This block used to blank the
    ! marks and every label before the passes began, on the reasoning that a redraw interrupted by a
    ! yield would otherwise show the last run's marks under the new run's axis. It did not, because the
    ! axis and the marks are written in the same uninterrupted run — and it made things worse, because
    ! the passes *do* yield (every hundred marks, so a long draw cannot freeze the browser) and a blank
    ! is exactly what the browser then painted: the flash on a slow machine. A redraw now leaves the
    ! previous picture up until the next one is complete, which is what a double buffer would do.
    !
    ! What remains here is the resetting of the accumulators, which are grown by `cat` and would
    ! otherwise double up. Nothing else may live here: no value may depend on what the passes below
    ! measure, because on a redraw it would silently carry the *previous* draw's number. The size of a
    ! mark is where that cost two rounds to spot — its own note says how.
    put `` into VizHeatD
    put `` into VizHeatE
    put `` into VizHeatF
    put `` into VizHeatG
    put `` into VizFlowCallD
    put `` into VizFlowJumpD
    put `` into VizFlowReturnD
    put `` into VizRulesD
    ! A leading and trailing space, so that every entry added is padded on both sides and ` 15 ` can
    ! never match inside ` 115 `.
    put ` ` into VizRuledLines

    ! ---- pass one: the frame the picture is drawn in ----
    put 4 into VizBands       ! the count range is split into this many, and the ramp is the only scheme
    put 0 into VizMaxCount
    put 0 into VizBreathe
    put 999999 into VizMinLine
    put 0 into VizMaxLine
    put 0 into VizMaxSteps
    put 0 into VizIndex
    while VizEvents has element VizIndex
    begin
        ! Give the browser a turn every hundred marks. Without this the page's thread is held for the
        ! whole pass — tens of seconds on a big recording — and the browser offers to stop the script
        ! instead of painting the frame that is already built.
        add 1 to VizBreathe
        if VizBreathe is greater than 100
        begin
            put 0 into VizBreathe
            wait 1 millis
        end
        put element VizIndex of VizEvents into VizEvent
        put property `cat` of VizEvent into VizCategory
        put property `args` of VizEvent into VizArgs
        if VizCategory is `window`
        begin
            put property `steps` of VizArgs into VizMaxSteps
            put property `line_counts` of VizArgs into VizLineCounts
            add 0 to VizMaxSteps
        end
        if VizCategory is `anchor`
        begin
            put property `line` of VizArgs into VizLine
            add 0 to VizLine
            put property VizLine of VizLineCounts into VizCount
            add 0 to VizCount
            if VizCount is greater than VizMaxCount put VizCount into VizMaxCount
            if VizLine is less than VizMinLine put VizLine into VizMinLine
            if VizLine is greater than VizMaxLine put VizLine into VizMaxLine
            put property `steps` of VizArgs into VizSteps
            add 0 to VizSteps
            if VizSteps is greater than VizMaxSteps put VizSteps into VizMaxSteps
            gosub to VizRuleAdd
        end
        if VizCategory is `transfer`
        begin
            put property `from_line` of VizArgs into VizLine
            add 0 to VizLine
            if VizLine is less than VizMinLine put VizLine into VizMinLine
            if VizLine is greater than VizMaxLine put VizLine into VizMaxLine
            gosub to VizRuleAdd
            put property `to_line` of VizArgs into VizLine
            add 0 to VizLine
            if VizLine is less than VizMinLine put VizLine into VizMinLine
            if VizLine is greater than VizMaxLine put VizLine into VizMaxLine
            gosub to VizRuleAdd
        end
        add 1 to VizIndex
    end

    if VizMaxSteps is less than 1 put 1 into VizMaxSteps
    take VizMinLine from VizMaxLine giving VizSpanLines
    add 1 to VizSpanLines

    ! ---- the size of a mark ----
    ! One size for every mark, and it is set *here* because this is the first point at which the span
    ! is known. It used to live in the per-draw block at the top of this pass, which is before pass
    ! one has measured anything, so it divided VizPlotH by the span of the *previous* draw — and by
    ! nothing at all on the first draw, where an empty span divides to Infinity and clamps down to
    ! the ceiling of 14. So a first draw drew 14-unit dots and every redraw drew 3-unit ones, which
    ! is what "returning to Graph reduces the markers to tiny dots" was.
    !
    ! The row-proportional rule it replaces also only ever applied between 41 and 193 lines: shorter
    ! runs were clamped up to 14 anyway, and on a long run a row is a couple of units, so the floor
    ! of 3 was a pinprick by construction. That clamp — not the cap — was the mistake, and a mark has
    ! to stay legible at the pane's scale to be a mark at all. When this view takes the host panel's
    ! size rather than asserting a 1000x700 frame, this is the number that should come from it.
    put 14 into VizDotSize

    ! ---- the window on the run ----
    ! Fitted to the whole recording the first time that recording is drawn and left alone after that:
    ! a redraw is what a gesture causes, and re-fitting there would undo the gesture that asked for
    ! it. The recording is the key rather than the visit, because leaving the pane and coming back to
    ! the *same* run should find the window exactly as it was — coming back is how a reader works, and
    ! a visit that resets is a visit that has to be redone.
    !
    ! The comparison is over the whole recording, and it is the honest one: a recording is a file
    ! beside the script, so editing the script leaves it alone and the window still means what it
    ! meant, while re-running the script writes a new one and the window is fitted again.
    put 0 into VizNewRun
    if VizTrace is not VizLastTrace put 1 into VizNewRun
    put VizTrace into VizLastTrace
    if VizNewRun is 1 gosub to VizReset
    if VizViewFit is 1 go to VizWindow
    put 0 into VizViewX0
    put VizMaxSteps into VizViewXW
    put VizMinLine into VizViewY0
    put VizSpanLines into VizViewYH
    put 1 into VizViewFit
VizWindow:
    gosub to VizClamp

    ! ---- the source behind the heat ----
    ! Built when either of its two inputs has changed, and not otherwise. A new script is new text to
    ! draw; a new recording is a new range of lines to draw it for. Both are compared as whole strings,
    ! which is what they are — and it is the same reasoning as the window's, on the other input: the
    ! thing that decides is the *content*, not the visit. Drawing on every draw would be the redraw
    ! Graham asked to be rid of, and drawing only on a new recording would leave an edited script
    ! showing its old text.
    if VizNewRun is 1 go to VizPictureFresh
    if VizSource is not VizLastSource go to VizPictureFresh
    go to VizPictureDone
VizPictureFresh:
    gosub to VizSourceMeasure
    put VizSource into VizLastSource
VizPictureDone:

    ! No scale factors are kept, and that is deliberate. AllSpeak's arithmetic is integer-first and
    ! division truncates (`divide 10 by 3` is 3), so a fraction here would be lost: a 626-line span
    ! against a 580-unit pane gives 0, and the picture would collapse onto a single line. Multiplying
    ! *before* dividing keeps the intermediate large and the result exact to a unit — the documented
    ! scaled-integer pattern, applied where it matters most.

    divide VizMaxCount by VizBands giving VizBandSize
    if VizBandSize is less than 1 put 1 into VizBandSize

    ! ---- pass two: the marks, at those scales ----
    put 0 into VizIndex
    while VizEvents has element VizIndex
    begin
        ! Give the browser a turn every hundred marks. Without this the page's thread is held for the
        ! whole pass — tens of seconds on a big recording — and the browser offers to stop the script
        ! instead of painting the frame that is already built.
        add 1 to VizBreathe
        if VizBreathe is greater than 100
        begin
            put 0 into VizBreathe
            wait 1 millis
        end
        put element VizIndex of VizEvents into VizEvent
        put property `cat` of VizEvent into VizCategory
        put property `args` of VizEvent into VizArgs
        if VizCategory is `anchor`
        begin
            put property `steps` of VizArgs into VizSteps
            add 0 to VizSteps
            take VizViewX0 from VizSteps giving VizX
            multiply VizX by VizPlotW giving VizX
            divide VizX by VizViewXW giving VizX
            add VizMargin to VizX
            put property `line` of VizArgs into VizLine
            add 0 to VizLine
            take VizViewY0 from VizLine giving VizOffset
            multiply VizOffset by VizPlotH giving VizY
            divide VizY by VizViewYH giving VizY
            add VizMargin to VizY
            ! A mark outside the window is left out rather than drawn and clipped. There is no clip
            ! rectangle to draw into — the plugin has no element for one — and a mark outside the
            ! frame paints over the axis and the key, so leaving it out is the honest version. The
            ! tests are strict, which by itself lets a mark *on* an edge through: 940 is the right
            ! edge, and `940 is greater than 940` is false, so a mark on the last step is kept.
            put 0 into VizOutside
            if VizX is less than VizMargin put 1 into VizOutside
            if VizX is greater than VizPlotRight put 1 into VizOutside
            if VizY is less than VizMargin put 1 into VizOutside
            if VizY is greater than VizPlotBottom put 1 into VizOutside
            if VizOutside is 0
            begin
                put property VizLine of VizLineCounts into VizCount
                add 0 to VizCount
                divide VizCount by VizBandSize giving VizBand
                if VizBand is greater than 3 put 3 into VizBand
                if VizBand is 0 put VizHeatD cat `M` cat VizX cat ` ` cat VizY cat `h0.01` into VizHeatD
                if VizBand is 1 put VizHeatE cat `M` cat VizX cat ` ` cat VizY cat `h0.01` into VizHeatE
                if VizBand is 2 put VizHeatF cat `M` cat VizX cat ` ` cat VizY cat `h0.01` into VizHeatF
                if VizBand is 3 put VizHeatG cat `M` cat VizX cat ` ` cat VizY cat `h0.01` into VizHeatG
            end
        end
        if VizCategory is `transfer`
        begin
            put property `steps` of VizArgs into VizSteps
            add 0 to VizSteps
            take VizViewX0 from VizSteps giving VizX
            multiply VizX by VizPlotW giving VizX
            divide VizX by VizViewXW giving VizX
            add VizMargin to VizX
            put property `from_line` of VizArgs into VizLine
            add 0 to VizLine
            take VizViewY0 from VizLine giving VizOffset
            multiply VizOffset by VizPlotH giving VizY
            divide VizY by VizViewYH giving VizY
            add VizMargin to VizY
            put property `to_line` of VizArgs into VizLine
            add 0 to VizLine
            take VizViewY0 from VizLine giving VizOffset
            multiply VizOffset by VizPlotH giving VizY2
            divide VizY2 by VizViewYH giving VizY2
            add VizMargin to VizY2
            ! One x decides a transfer, because a transfer is a vertical segment: its two ends differ
            ! only in their line, so if the x is outside the window the whole segment is. A segment
            ! whose ends straddle the window is kept — but its ends are *clamped to the frame* rather
            ! than left where they fall, because a line drawn from above the plot to below it would
            ! run across the axis and the caption. Clamping is what a clip rectangle would do here,
            ! and there is no clip rectangle to use.
            if VizY is less than VizMargin put VizMargin into VizY
            if VizY is greater than VizPlotBottom put VizPlotBottom into VizY
            if VizY2 is less than VizMargin put VizMargin into VizY2
            if VizY2 is greater than VizPlotBottom put VizPlotBottom into VizY2
            put 0 into VizOutside
            if VizX is less than VizMargin put 1 into VizOutside
            if VizX is greater than VizPlotRight put 1 into VizOutside
            if VizOutside is 0
            begin
                ! The head is a chevron drawn in the path data, not a marker element — the plugin has
                ! none, and a stroked chevron needs no fill, so it joins the segment's own stroke.
                !
                ! It goes at the *destination* end, `to_line`, with its wings behind the tip rather
                ! than in front of it — and which side is behind depends on which way the segment
                ! runs, so the wings are placed nine units back from the tip in the direction it came
                ! from. No head is drawn when both ends are the same line: a head with no direction
                ! would be claiming one.
                put property `kind` of VizArgs into VizKind
                take 5 from VizX giving VizHeadL
                add 5 to VizX giving VizHeadR
                if VizY2 is greater than VizY take 9 from VizY2 giving VizHeadY
                if VizY2 is less than VizY add 9 to VizY2 giving VizHeadY
                put `M` cat VizX cat ` ` cat VizY cat `L` cat VizX cat ` ` cat VizY2 into VizSegment
                if VizY2 is not VizY put VizSegment cat `M` cat VizHeadL cat ` ` cat VizHeadY cat `L` cat VizX cat ` ` cat VizY2 cat `L` cat VizHeadR cat ` ` cat VizHeadY into VizSegment
                ! One path per kind, because the colour is the kind. `branch` — the compiler's own
                ! jumps — is left off rather than drawn faintly: scaffolding is not a program jump,
                ! and drawing it would put the `if` and `while` machinery into the flow.
                if VizKind is `call` put VizFlowCallD cat VizSegment into VizFlowCallD
                if VizKind is `jump` put VizFlowJumpD cat VizSegment into VizFlowJumpD
                if VizKind is `return` put VizFlowReturnD cat VizSegment into VizFlowReturnD
            end
        end
        add 1 to VizIndex
    end

    ! ---- the axis ----
    ! Four ticks a side, spaced by a third of the *window* rather than of the whole run, and placed
    ! with the same mapping the marks use, so a label sits on the line it names at any zoom. A tick
    ! whose line falls outside the window is left with no text rather than dragged to the edge: the
    ! pool is four labels, and a label that lies about where it sits is worse than an absent one.
    divide VizViewYH by 3 giving VizTickStep
    if VizTickStep is less than 1 put 1 into VizTickStep
    divide VizViewXW by 3 giving VizXStep
    if VizXStep is less than 1 put 1 into VizXStep

    put VizViewY0 into VizTickValue
    gosub to VizPlaceY
    move VizYLabel0 to 52 VizTickPos
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizYLabel0 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotBottom set the text of VizYLabel0 to VizTickValue

    add VizTickStep to VizTickValue
    gosub to VizPlaceY
    move VizYLabel1 to 52 VizTickPos
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizYLabel1 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotBottom set the text of VizYLabel1 to VizTickValue

    add VizTickStep to VizTickValue
    gosub to VizPlaceY
    move VizYLabel2 to 52 VizTickPos
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizYLabel2 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotBottom set the text of VizYLabel2 to VizTickValue

    add VizTickStep to VizTickValue
    gosub to VizPlaceY
    move VizYLabel3 to 52 VizTickPos
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizYLabel3 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotBottom set the text of VizYLabel3 to VizTickValue

    put VizViewX0 into VizTickValue
    gosub to VizPlaceX
    move VizXLabel0 to VizTickPos 664
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizXLabel0 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotRight set the text of VizXLabel0 to VizTickValue

    add VizXStep to VizTickValue
    gosub to VizPlaceX
    move VizXLabel1 to VizTickPos 664
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizXLabel1 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotRight set the text of VizXLabel1 to VizTickValue

    add VizXStep to VizTickValue
    gosub to VizPlaceX
    move VizXLabel2 to VizTickPos 664
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizXLabel2 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotRight set the text of VizXLabel2 to VizTickValue

    add VizXStep to VizTickValue
    gosub to VizPlaceX
    move VizXLabel3 to VizTickPos 664
    ! Cleared here rather than at the top of the draw, so that the blank and the value land in the
    ! same uninterrupted run: a label set to nothing and left there is a label that flickers.
    set the text of VizXLabel3 to ``
    if VizTickPos is not less than VizMargin
        and VizTickPos is not greater than VizPlotRight set the text of VizXLabel3 to VizTickValue

    move VizCaption to 60 690
    put `lines ` cat VizMinLine cat `-` cat VizMaxLine cat `, ` cat VizMaxSteps cat ` steps` into VizCaptionText
    set the text of VizCaption to VizCaptionText

    ! ---- the key's ranges ----
    ! Computed, never fixed: the band size is `VizMaxCount / VizBands`, the same division that chose
    ! each mark's colour, so a quieter or shorter run moves every boundary. Bands 0-2 name both ends;
    ! the last takes everything above it, which is what the clamp in the mark loop does. The coolest
    ! band's lower end reads 1 rather than 0 because a mark exists only for a line that ran — 0 is in
    ! its range and is never drawn — and it keeps 0 only in the one case where that is the whole band.
    put 0 into VizKeyLo
    if VizBandSize is greater than 1 put 1 into VizKeyLo
    take 1 from VizBandSize giving VizKeyHi
    set the text of VizKeyLabel0 to VizKeyLo cat `-` cat VizKeyHi

    put VizBandSize into VizKeyLo
    multiply VizBandSize by 2 giving VizKeyHi
    take 1 from VizKeyHi giving VizKeyHi
    set the text of VizKeyLabel1 to VizKeyLo cat `-` cat VizKeyHi

    multiply VizBandSize by 2 giving VizKeyLo
    multiply VizBandSize by 3 giving VizKeyHi
    take 1 from VizKeyHi giving VizKeyHi
    set the text of VizKeyLabel2 to VizKeyLo cat `-` cat VizKeyHi

    multiply VizBandSize by 3 giving VizKeyLo
    set the text of VizKeyLabel3 to VizKeyLo cat `+`

    ! ---- the rules ----
    ! A hairline across the frame at every line the run touched, taken from the counts the window
    ! carries rather than from the arrivals — so a line visited forty times gets one rule and not
    ! forty. Lines the run never reached get none, which is what makes this a picture of the
    ! recording rather than of the file.
    !
    ! It exists for the zoomed-out view, where a mark is a dot in mid-space and the text behind it is
    ! a texture: the rule is what says which line the dot belongs to, and it spares a reader the
    ! choice between zooming in to find out and hovering to ask the sidebar.
    put `` into VizRulesD
    put VizMinLine into VizRuleLine
    add VizSpanLines to VizMinLine giving VizRuleEnd
    while VizRuleLine is less than VizRuleEnd
    begin
        put ` ` cat VizRuleLine cat ` ` into VizRuledLine
        if VizRuledLines includes VizRuledLine
        begin
            take VizViewY0 from VizRuleLine giving VizRuleY
            multiply VizRuleY by VizPlotH giving VizRuleY
            divide VizRuleY by VizViewYH giving VizRuleY
            add VizMargin to VizRuleY
            ! Only the rules in view. The loop runs over the whole run and the window is a slice of it,
            ! so a line outside the window maps to a y outside the frame — and a rule drawn there
            ! would be a line across the axis or the caption. The test is the marks' own test, and
            ! inclusive for the same reason: a line on the very edge is on the edge, not outside it.
            put 0 into VizOutside
            if VizRuleY is less than VizMargin put 1 into VizOutside
            if VizRuleY is greater than VizPlotBottom put 1 into VizOutside
            if VizOutside is 0 put VizRulesD cat `M` cat VizMargin cat ` ` cat VizRuleY cat `h` cat VizPlotW into VizRulesD
        end
        add 1 to VizRuleLine
    end

    ! ---- the source's picture ----
    ! Rebuilt from the window on every draw. The document holds the lines the window shows and
    ! nothing else, so it is exactly as tall as the frame and cannot spill past it — which is what
    ! the rectangle alone could not do while the whole run was in one document and the element had to
    ! be taller than the frame to keep the rows in step. It is also the cheaper picture: what is
    ! rebuilt is the rows in view, not the whole file.
    gosub to VizSourcePicture

    set attribute `d` of VizHeat0 to VizHeatD
    set attribute `d` of VizHeat1 to VizHeatE
    set attribute `d` of VizHeat2 to VizHeatF
    set attribute `d` of VizHeat3 to VizHeatG
    set attribute `stroke-width` of VizHeat0 to VizDotSize
    set attribute `stroke-width` of VizHeat1 to VizDotSize
    set attribute `stroke-width` of VizHeat2 to VizDotSize
    set attribute `stroke-width` of VizHeat3 to VizDotSize
    set attribute `stroke-linecap` of VizHeat0 to `round`
    set attribute `stroke-linecap` of VizHeat1 to `round`
    set attribute `stroke-linecap` of VizHeat2 to `round`
    set attribute `stroke-linecap` of VizHeat3 to `round`
    set attribute `d` of VizFlowCall to VizFlowCallD
    set attribute `d` of VizFlowJump to VizFlowJumpD
    set attribute `d` of VizFlowReturn to VizFlowReturnD
    set attribute `d` of VizRules to VizRulesD
    put 0 into VizDrawing
    return

!   ---- the gestures ----
!   The host registers two events and calls in here: `VizGrab` on pick, `VizPan` on drag, and
!   `VizWheel` on wheel. They live with the view rather than with the host because they are the
!   view's own state; a host that wants the picture to move has only to wire them up. There are
!   four entry points in all — those three and `VizReset` — and that is the whole of the interface.
!
!   Graham's scheme, from Kdenlive and Audacity: the wheel scrolls, shift-wheel zooms, drag pans.
!   The modifier therefore decides and the direction does not, which is why the wheel handler asks
!   for `the wheel shift` rather than reading the sign of the amount.
VizWheel:
    ! Which axis a notch applies to is the modifiers' business, not the wheel's. Shift zooms the
    ! lines, control zooms the steps, both together do both — and with neither, the wheel scrolls
    ! down the run, which is what it does in every other application. Control is the horizontal
    ! modifier here against the usual pull of the browser's own page zoom, which this takes over:
    ! the listener is registered on the pane and calls `preventDefault`, so the page never sees it,
    ! and the pane is where the gesture is being aimed.
    if VizDrawing is 1 return
    put the wheel amount into VizWheelAmount
    add 0 to VizWheelAmount
    if VizWheelAmount is 0 return
    put 0 into VizZoomAcross
    put 0 into VizZoomDown
    if the wheel shift is 1 put 1 into VizZoomDown
    if the wheel control is 1 put 1 into VizZoomAcross
    put VizZoomAcross into VizMove
    add VizZoomDown to VizMove
    if VizMove is 0 gosub to VizScroll
    if VizMove is not 0 gosub to VizZoom
    return

VizGrab:
    ! Where the window stands when the drag begins. Kept rather than accumulated: a pan measured
    ! step by step from the last event drifts, because the runtime's division truncates and every
    ! step throws its remainder away. Measured from the grab instead, the picture is where the
    ! pointer says it is, however many events there have been.
    put the pick position into VizGrabPos
    put property `x` of VizGrabPos into VizGrabX
    put property `y` of VizGrabPos into VizGrabY
    put VizViewX0 into VizGrabFromX
    put VizViewY0 into VizGrabFromY
    put 1 into VizGrabbed
    return

VizRelease:
    put 0 into VizGrabbed
    return

VizPan:
    ! Move the window so the picture follows the pointer. Two scales sit between a pointer and a
    ! window: the panel's pixels against the drawing's viewBox units, which differ because the
    ! browser fits the drawing to the panel; and those units against the window, which differ
    ! because the window is a slice of the run. Both are divisions, and the runtime truncates, so
    ! each is multiplied out first — the same scaled-integer rule the marks use.
    if VizDrawing is 1 or VizGrabbed is 0 return
    gosub to VizNote
    put the drag position into VizDragPos
    put property `x` of VizDragPos into VizDragX
    put property `y` of VizDragPos into VizDragY
    take VizGrabX from VizDragX giving VizDx
    take VizGrabY from VizDragY giving VizDy
    gosub to VizPixelScale
    multiply VizDx by 1000 giving VizDx
    divide VizDx by VizPixelsK giving VizDx
    multiply VizDy by 1000 giving VizDy
    divide VizDy by VizPixelsK giving VizDy
    multiply VizDx by VizViewXW giving VizDx
    divide VizDx by VizPlotW giving VizDx
    multiply VizDy by VizViewYH giving VizDy
    divide VizDy by VizPlotH giving VizDy
    take VizDx from VizGrabFromX giving VizViewX0
    take VizDy from VizGrabFromY giving VizViewY0
    gosub to VizClamp
    gosub to VizRedraw
    return

VizPixelScale:
    ! How long a viewBox unit is, in *thousandths of a pixel of the panel*. The drawing keeps its own
    ! 1000x700 frame and the browser fits it to the panel with `meet`, so the scale is the smaller of
    ! the two ratios. The thousandths are not decoration: the ratio is well under one, the runtime's
    ! division truncates, and without them it would come out as zero and a drag would move nothing.
    !
    ! The panel is read from `VizHost` rather than from the canvas, and that is a limitation worth
    ! naming: the canvas is an `svg`, and `svg` is the one element type the plugin registers without
    ! the `dom` extra, so `the width of` will not compile for it. The host's box is the canvas's box
    ! in practice, since the canvas is created to fill it.
    put the width of VizHost into VizPixelsW
    put the height of VizHost into VizPixelsH
    multiply VizPixelsH by 1000 giving VizPixelsH
    divide VizPixelsH by 700 giving VizPixelsH
    put VizPixelsH into VizPixelsK
    if VizPixelsW is less than VizPixelsK put VizPixelsW into VizPixelsK
    if VizPixelsK is less than 1 put 1 into VizPixelsK
    return

VizScroll:
    ! The wheel alone scrolls down the run. A quarter of the window rather than a number of lines, so
    ! it feels the same at every zoom: a fixed step is a nudge on a long run and a leap on a short
    ! one, which is the prototype's lesson in its smallest form.
    gosub to VizNote
    divide VizViewYH by 4 giving VizMove
    if VizMove is less than 1 put 1 into VizMove
    add VizMove to VizViewY0
    gosub to VizClamp
    gosub to VizRedraw
    return

VizZoom:
    ! A notch in or out, on whichever axes `VizWheel` marked. Two steps rather than one, and they are
    ! exact inverses of each other: in shrinks a window by a fifth and out grows it by a quarter, and
    ! four fifths times five quarters is one, so a notch in and a notch out land back where they
    ! started. A single step could not do that here, because the runtime truncates every division.
    !
    ! The two axes are independent because the questions are: the steps are *when* and the lines are
    ! *where*, and how far apart two arrivals are in time says nothing about how far apart the lines
    ! they land on are. An axis that is not marked is left exactly as it was.
    gosub to VizNote
    if VizWheelAmount is greater than 0 go to VizZoomOut
    if VizZoomAcross is 1
    begin
        divide VizViewXW by 5 giving VizMove
        if VizMove is less than 1 put 1 into VizMove
        take VizMove from VizViewXW giving VizViewXW
    end
    if VizZoomDown is 1
    begin
        divide VizViewYH by 5 giving VizMove
        if VizMove is less than 1 put 1 into VizMove
        take VizMove from VizViewYH giving VizViewYH
    end
    go to VizZoomSettled
VizZoomOut:
    if VizZoomAcross is 1
    begin
        divide VizViewXW by 4 giving VizMove
        if VizMove is less than 1 put 1 into VizMove
        add VizMove to VizViewXW
    end
    if VizZoomDown is 1
    begin
        divide VizViewYH by 4 giving VizMove
        if VizMove is less than 1 put 1 into VizMove
        add VizMove to VizViewYH
    end
VizZoomSettled:
    ! The *size* is clamped before the origin is moved to follow it, and that order is the whole of
    ! this. `VizClamp` has the last word on how small a window may get, so a centring computed from
    ! the size before the clamp slides the window every time a notch is refused: at the legible floor
    ! each notch shortened the window by a fifth, the clamp put it back, and the origin kept the
    ! centring's share of a change that never happened — which is "the wheel scrolls up one line".
    gosub to VizClamp
    ! Now hold the middle still, using the size the clamp actually allowed.
    take VizViewXW from VizWasXW giving VizMove
    divide VizMove by 2 giving VizMove
    add VizMove to VizViewX0
    take VizViewYH from VizWasYH giving VizMove
    divide VizMove by 2 giving VizMove
    add VizMove to VizViewY0
    gosub to VizClamp
    gosub to VizRedraw
    return

VizNote:
    ! What the window was before a gesture, so the gesture can tell whether it changed anything. Kept
    ! here rather than re-derived, because `VizClamp` writes the window in place and the old value is
    ! gone by the time the answer is wanted.
    put VizViewX0 into VizWasX0
    put VizViewXW into VizWasXW
    put VizViewY0 into VizWasY0
    put VizViewYH into VizWasYH
    return

VizRedraw:
    ! A draw only if the window actually moved. A refused gesture — a zoom at its limit, a pan against
    ! the edge of the run — would otherwise redraw the whole picture to produce the picture that is
    ! already on screen, which is wasted work and a visible flash on a slow machine.
    put 0 into VizMoved
    if VizViewX0 is not VizWasX0 put 1 into VizMoved
    if VizViewXW is not VizWasXW put 1 into VizMoved
    if VizViewY0 is not VizWasY0 put 1 into VizMoved
    if VizViewYH is not VizWasYH put 1 into VizMoved
    if VizMoved is 1 gosub to Draw
    return

VizClamp:
    ! Keep the window inside the run, and never empty. The upper clamps are the outer limit of both
    ! gestures — the whole picture is as far as either can go — and they double as the way back to
    ! it, so the pane needs no reset button. The lower ones matter only on a tiny run: a window of
    ! under four units maps to under four pixels, and every division above would then round away.
    ! No zoom past the size the text is written at — see `VizGlyphRows`. It is applied *before* the
    ! clamp to the run, so a recording shorter than that many lines simply has no vertical zoom in it,
    ! which is right: the whole run is already legible and there is nothing to zoom into.
    if VizViewYH is less than VizGlyphRows put VizGlyphRows into VizViewYH
    if VizViewXW is greater than VizMaxSteps put VizMaxSteps into VizViewXW
    if VizViewYH is greater than VizSpanLines put VizSpanLines into VizViewYH
    if VizViewXW is less than 4 put 4 into VizViewXW
    if VizViewYH is less than 4 put 4 into VizViewYH
    if VizViewX0 is less than 0 put 0 into VizViewX0
    if VizViewY0 is less than VizMinLine put VizMinLine into VizViewY0
    put VizViewX0 into VizViewTemp
    add VizViewXW to VizViewTemp
    if VizViewTemp is greater than VizMaxSteps
    begin
        take VizViewXW from VizMaxSteps giving VizViewX0
    end
    add VizSpanLines to VizMinLine giving VizViewTemp
    put VizViewY0 into VizMove
    add VizViewYH to VizMove
    if VizMove is greater than VizViewTemp
    begin
        take VizViewYH from VizViewTemp giving VizViewY0
    end
    return

VizReset:
    ! Fit the window to the run again on the next draw. The view calls this itself when the recording
    ! changes — see the comparison at the fit in `Draw`, which is where "a different run" is decided —
    ! and it stays an entry point because a host may have its own reason to start again. It is no
    ! longer what a visit does: leaving the pane and coming back keeps the window, which is what the
    ! reader wants and what a reset on entry destroyed.
    put 0 into VizViewFit
    return

VizRuleAdd:
    ! Note a line the recording names, once. The rules are drawn for *these* lines and not for every
    ! line the run executed, which is what the window's counts carry: on a recording that walks a
    ! chain of labels the counts cover more than twice as many lines as carry anything, and a grid
    ! that dense stops being a guide. A line qualifies if an arrival landed on it or a transfer began
    ! or ended on it — which is exactly the set of lines the picture has something to say about.
    !
    ! The set is a padded string and the test is `includes`, because the language has one of those and
    ! no set type. The dedupe is not an optimisation: a rule is a line drawn right across the frame,
    ! so a line visited two hundred times would contribute two hundred identical rules to the same
    ! path attribute — invisible, and a waste that grows with the recording.
    put ` ` cat VizLine cat ` ` into VizRuledLine
    if VizRuledLines includes VizRuledLine return
    put VizRuledLines cat VizRuledLine into VizRuledLines
    return

VizSourceMeasure:
    ! ---- reading the source, and drawing it once ----
    ! `json split` with no `on` splits on the newline, and it is the one to use: it leaves a JSON array
    ! behind, which `element N of` can read. The plain `split` does not — it stores value objects, and
    ! `element N of` tries to `JSON.parse` each one and reports "Can't parse JSON".
    !
    ! Every row of the run is drawn here, once, at the size the text is written at, and nothing about
    ! it changes afterwards: a zoom or a pan moves the *window* rather than redrawing the picture. That
    ! is the whole point of the pane, and it is also why the width is measured over the run's own lines
    ! — the picture's proportions are fixed by its longest line, and the window decides how much of it
    ! is in view.
    json split VizSource giving VizSourceLines
    put the json count of VizSourceLines into VizSourceCount
    put 0 into VizGlyphMax
    put VizMinLine into VizSourceIndex
    while VizSourceIndex is not greater than VizMaxLine
    begin
        take 1 from VizSourceIndex giving VizSourceAt
        if VizSourceAt is less than VizSourceCount
        begin
            put element VizSourceAt of VizSourceLines into VizSourceLine
            if the length of VizSourceLine is greater than VizGlyphMax put the length of VizSourceLine into VizGlyphMax
        end
        add 1 to VizSourceIndex
    end
    if VizGlyphMax is less than 1 put 1 into VizGlyphMax
    multiply VizGlyphMax by 8 giving VizGlyphWidth
    multiply VizSpanLines by 18 giving VizGlyphHeight

    ! The rows are `<tspan dy="18">` inside one `<text>`: the offset accumulates as the text is laid
    ! out, so a whole file is one element and no per-line coordinate is computed at all. `y="-4"` puts
    ! the first baseline four units down a row, so the last row's descenders sit inside the document
    ! rather than on its very edge.
    put `<text x="0" y="-4" xml:space="preserve" font-family="monospace" font-size="13" fill="#5b6472">` into VizGlyphBody
    put VizMinLine into VizSourceIndex
    while VizSourceIndex is not greater than VizMaxLine
    begin
        put `` into VizSourceLine
        take 1 from VizSourceIndex giving VizSourceAt
        if VizSourceAt is less than VizSourceCount
        begin
            put element VizSourceAt of VizSourceLines into VizSourceLine
        end
        ! A line the run names but the file does not have is left as an empty row rather than skipped:
        ! the rows are what lines up with the axis, so a missing one has to keep its place.
        !
        ! Three entities, and the ampersand first — escaping it after the others would escape the `&`
        ! of the escapes just written.
        replace `&` with `&amp;` in VizSourceLine
        replace `<` with `&lt;` in VizSourceLine
        replace `>` with `&gt;` in VizSourceLine
        put VizGlyphBody cat `<tspan x="0" dy="18">` cat VizSourceLine cat `</tspan>` into VizGlyphBody
        add 1 to VizSourceIndex
    end
    put VizGlyphBody cat `</text>` into VizGlyphBody

    ! Encoded once, here, because the picture is never redrawn: a data URL has two characters an SVG
    ! document cannot spell for it, and `%` goes first or the `#` replacement would have its own `%`
    ! turned into `%25`. The header written per draw has neither, so re-encoding it is not needed.
    replace `%` with `%25` in VizGlyphBody
    replace `#` with `%23` in VizGlyphBody

    set attribute `width` of VizGlyphs to VizGlyphWidth
    set attribute `height` of VizGlyphs to VizGlyphHeight
    return

VizSourcePicture:
    ! ---- the window on the picture ----
    ! A viewBox in the document's own units, and the whole of the zoom and the pan. Its aspect is the
    ! frame's, which is what gives the text the proportions it was written at — a window whose shape
    ! followed the zoom instead is what stretched the letters — and its height is one row per line in
    ! view, so a row lands on the line the axis names.
    !
    ! The window's width is therefore *derived*: the panel is so many rows tall wide, and a wider
    ! window is not available. A line longer than the window shows goes off the right-hand edge, which
    ! is the point — the picture is a backdrop, and the detail is had by zooming or by asking the
    ! sidebar. Panning moves the window along the source far enough to reach the right-hand end of it,
    ! which is what makes a long line reachable without losing the recording it belongs to.
    take VizMinLine from VizViewY0 giving VizWindowY
    multiply VizWindowY by 18 giving VizWindowY
    multiply VizViewYH by 18 giving VizWindowH
    multiply VizWindowH by VizPlotW giving VizWindowW
    divide VizWindowW by VizPlotH giving VizWindowW
    put 0 into VizWindowX
    if VizGlyphWidth is greater than VizWindowW
    begin
        take VizWindowW from VizGlyphWidth giving VizWindowX
        multiply VizWindowX by VizViewX0 giving VizWindowX
        divide VizWindowX by VizMaxSteps giving VizWindowX
    end
    set attribute `viewBox` of VizPane to VizWindowX cat ` ` cat VizWindowY cat ` ` cat VizWindowW cat ` ` cat VizWindowH
    set attribute `href` of VizGlyphs to `data:image/svg+xml;charset=utf-8,<svg xmlns="http://www.w3.org/2000/svg" width="` cat VizGlyphWidth cat `" height="` cat VizGlyphHeight cat `">` cat VizGlyphBody cat `</svg>`
    return

VizPlaceY:
    ! Where a tick's line number lands in the frame, by the same mapping the marks use — so a label
    ! sits on the line it names at any zoom.
    take VizViewY0 from VizTickValue giving VizTickPos
    multiply VizTickPos by VizPlotH giving VizTickPos
    divide VizTickPos by VizViewYH giving VizTickPos
    add VizMargin to VizTickPos
    return

VizPlaceX:
    take VizViewX0 from VizTickValue giving VizTickPos
    multiply VizTickPos by VizPlotW giving VizTickPos
    divide VizTickPos by VizViewXW giving VizTickPos
    add VizMargin to VizTickPos
    return
!! @hash fefa5a95
!! @verified fefa5a95
!!!
