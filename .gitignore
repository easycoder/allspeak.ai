__pycache__/
*.pyc
various/

# Local secrets — supply your own; never commit
config/gmap-key.txt
deploy/config/gmap-key.txt

# The step summary the agent rewrites for every prompt. A working aid, opened in the
# editor, not a record of the project — it must never land in a commit.
DIFF.md

# diffshow — a local working tool that opens DIFF.md in a desktop window. Its script and
# the window geometry it saves (rewritten on close) are local to this machine and stay
# out of the repo.
.diffshow.conf
diffshow.allspeak

# Reasonix agent state and its per-project config — machine-local, rewritten on every
# session, and no use to anyone else. The desktop-topic files hold session titles and
# timestamps, the task tree holds runtime logs and lock files, and the autoresearch specs
# embed pasted conversation transcripts. None of that belongs in a public repo.
.reasonix/
reasonix.toml

# Sync-tool conflict copies (Syncthing and friends) — never merge these by hand.
*.sync-conflict-*

# The per-session conversation logs. They are a working record for the human, not project
# documentation, and they expose the thinking behind decisions rather than the decisions.
# Local only — never commit them.
conversation/

# The visualiser's calibration: how long a drawing took on *this* machine, written by the editor
# after each Graph. It describes the machine rather than the project, would be wrong for anyone
# else, and the editor relearns it in one run — so it stays local.
.viz-calibration.json
