!!  Tabbed script editor with auto-save and external change detection.
!!  Served by server.allspeak locally, or any web server with /list, /read, /write routes.
!   viz.allspeak

    script Viz
!! @hash 9e6e7696
!! @verified 9e6e7696
!!!
!! Variable declarations
!! The script uses a lot of variables; they are grouped here by function.
!   -- DOM --
    div Body
    div TabBar
    div TabBtn
    div Overlay
    div MenuMask            ! the sheet that takes the click that closes the menu
    div Menu                ! the popup itself, placed where the right-click was
    div MenuItem            ! a pool: one row per item
    div GraphPic            ! the picture's host, for its own right-click
    div GraphSidePane       ! and the sidebar's box, for its
!   -- the menu's own state --
    variable MenuBuilt      ! 1 once the rows exist
    variable MenuItemCount  ! how many there are
    variable MenuItemName   ! array: the label on each
    variable MenuI          ! scratch: index over them
    variable MenuItemLabel  ! scratch: one label
    variable MenuPick       ! which row was clicked, from `the index of MenuItem`
    variable MenuFrozen     ! 1 while the picture's hover is held still, so that row reads `Cancel`
    variable MenuAt         ! what `the pick position` gave the right-click
    variable MenuX          ! scratch: where the menu goes, in client pixels
    variable MenuY
    variable MenuPad        ! scratch: a title, before it is shown
    div Scroller
    div FileRow
    div EditorArea       ! flat-mode pane (CodeMirror-wrapped textarea)
    div BlocksArea       ! Blocks-mode pane (toolbar + split)
    textarea ContentEditor
    textarea BlocksCodePane
    textarea BlocksDocPane
    span StatusSpan
    span TabLabel
    span BlocksTitle
    span BlocksBadge
    div AlertPanel       ! the alert/info panel, near the top of the page and in front of everything
    div AlertText        ! what it says
    button AlertCloseBtn ! the one control it carries
    button OpenBtn
    button FindBtn
    button BlocksBtn
    button GraphBtn
    button RecordBtn     ! record the open script and put the recording beside it
    button LaunchBtn     ! open the page this script's `@app` names, in a window of its own
    button BlocksPrev
    button BlocksNext
    button BlocksVerify
    button BlocksVerifyAll
    button CloseBtn
    img PlusBtn
    img TabClose
    a FileName
    pre UIPre
    div Welcome          ! the first-run panel over the editor — gone on the first click anywhere
    div WelcomeTitle
    div WelcomeIntro
    div WelcomeButtons
    div WelcomeNote
    span WelcomePre      ! the sentence around the website link, which is the `a` in `viz.json`
    span WelcomePost

!   -- State --
    variable Lang
    variable StrOpen
    variable StrFind
    variable StrFlowCall
    variable StrFlowJump
    variable StrFlowReturn
    variable StrClose
    variable StrSaved
    variable StrSaveFailed
    variable StrRecording
    variable StrReloaded
    variable StrExtChange
    variable StrNoConnect
    variable StrSaveAs
    variable StrEmpty
    variable StrUpLevel
    variable StrRoot
    variable StrUpdated
    ! The welcome panel: the first thing a new reader sees, and the only place the buttons are explained.
    ! Six strings rather than one paragraph, so each is a plain line a translator can read on its own and
    ! the layout between them is `viz.json`'s business.
    variable StrWelcomeTitle
    variable StrWelcomeIntro
    variable StrWelcomeButtons
    variable StrWelcomeNote
    variable StrWelcomePre   ! the website sentence, around the link
    variable StrWelcomePost
    ! What the alert panel is asked to say. A variable rather than an argument, because the language has
    ! no parameters: `ShowAlert` reads it and nothing else.
    variable AlertMsg
    variable TabPath       ! array: full file path per tab (relative to project root)
    variable TabName       ! array: display name (basename) per tab
    variable TabSaved      ! array: last content saved to server per tab
    ! Where the flat editor was standing, per tab: the caret's line and the viewport's scroll offset.
    ! Two values and not one, because they are independent — scrolling does not move the insertion
    ! point, and coming back must not carry the view to the caret. A video editor teaches you to
    ! expect that; a text editor usually does not, and the jump is what catches you out.
    variable TabCursor     ! array: the caret's line, per tab
    variable TabView       ! array: the viewport's scroll offset, per tab
    variable TabCount
    variable ActiveTab
    variable Content       ! scratch: current editor content
    variable FileContent   ! scratch: content fetched from server
    variable FileList      ! scratch: JSON array from /list
    variable JsonLines     ! scratch: a JSON file's text split into lines
    variable JsonText      ! scratch: text on its way to the JSON formatter
    variable N
    variable M
    variable Item          ! scratch: single entry object from list
    variable File          ! scratch: single filename
    variable FileCount
    variable TabItem
    variable UIWebson
    variable VersionResult
    variable CurrentPath   ! current directory being browsed (relative, no leading /)
    variable EntryName
    variable EntryType

!   -- Blocks mode (parser + view + edit) --
    variable BlocksMode    ! 0 = flat, 1 = Blocks pane visible
    div GraphArea        ! the Graph pane's whole area — the drawing, the grip and the sidebar — shown and hidden here
    div GraphGrip        ! the draggable splitter between the drawing and the sidebar
    div GraphSide        ! the sidebar's box, which is the module's; this file only sizes it
    variable GripPicked    ! 1 while the drag in progress began on the Graph grip
    variable GripWidthAtPick ! the sidebar's width when that drag began
    variable GripMost      ! the widest the sidebar may get, which depends on the window
    variable SideStored    ! the sidebar width kept from a previous session
    variable GraphMode     ! 0 = not graphed, 1 = Graph pane visible
    variable TracePath     ! the recording this tab expects, sent to the pane so a miss can name it
    module VizModule       ! the Graph pane, a companion module fetched and run on demand
    variable VizSrc         ! its source, as fetched — `run` compiles the text
    variable VizLoaded      ! 1 once it is running, so the fetch happens once
    module SideModule      ! the Graph sidebar, a second companion module beside the pane
    variable SideSrc        ! its source, as fetched
    variable SideLoaded     ! 1 once it is running
    module AlertModule     ! the drawing notice, a third companion module — the panel the editor shares
    variable AlertSrc       ! its source, as fetched
    variable AlertLoaded    ! 1 once it is running
    variable PanelMsg       ! the dict the notice is told with when it must stand down
    variable SideIn         ! the dict the pane reported, as it arrived
    variable SideInKind     ! which report it is: the line under the pointer, the mark a press named, or the freeze lifting
    variable SideSel        ! the line the pane last reported, which is what the sidebar is about
    variable SideVisit      ! which arrival on that line the clicked dot was
    variable SideValues     ! what that arrival captured, passed on untouched
    variable SideTotal      ! how many arrivals that line had in the whole recording
    variable SideMsg        ! the dict sent to the sidebar: which kind of news, and what it is
    variable SideFound      ! 1 if a doc block holds that line
    variable SideTitle      ! the block's first prose line, for the sidebar's heading
    variable SideProse      ! its prose
    variable SideI          ! scratch: index over the sections looking for one
    variable VizRun         ! the dict the pane is sent: the run, the script, the words, the path
    variable RecordSource   ! the open buffer, handed to the plugin as the script to run
    variable RecordTrace     ! what that run collected, as the trace document's text
    variable RecordVerdict   ! what the recording amounts to — visits and windows, or why there is none
    variable AppPage         ! the page this script's `@app` attribute names, if it has one
    variable TabFlavour      ! this tab's script: `py` or `js`, as the plugin resolved it — the script's own
                             ! marker, then the project's `#editor-runtime`, then `js`
    variable LaunchHide     ! 1 when the Launch button does not belong on this tab's bar, which is when the tab
                            ! is Python-side; resolved per parse, like `TabFlavour` itself
    variable LaunchHidden   ! what the button is currently set to, so a parse that changes nothing writes nothing
    variable RecordReply     ! what the server says after it ran a Python script and recorded the run
    variable TraceText      ! the recording, as read — the `trace` field of that dict
    variable SourceText     ! the script, as read — the `source` field of it
    variable CurBlock      ! 0-based index into Sections arrays
    variable BlockDirty    ! 1 if user edited the current block since last splice
    variable SecCount      ! number of parsed sections
    variable SecStart      ! array: 1-based opener line number
    variable SecEnd        ! array: 1-based terminator line number
    variable SecProse      ! array: prose text (one entry, joined by newline, !! prefix stripped)
    variable SecCode       ! array: code text (joined by newline, verbatim)
    variable SecHash       ! array: stored @hash, or empty
    variable SecVerified   ! array: stored @verified, or empty
    variable SecHashState  ! array: fresh / stale / no-baseline / no-code
    variable SecVerifyState ! array: verified-fresh / verified-stale / unverified / verified-no-code
    variable Found         ! 1 if the search term was found in section I
    variable FoundPane     ! `code` or `doc` — pane that holds the match
    variable SearchTerm    ! the text being searched for (survives RenderBlock/RenderToc, which reuse Tmp)

!   -- Parser scratch (rebuilt every parse) --
    variable Lines         ! source split on newline
    variable LineCount
    variable Line
    variable Kind          ! `TERM`, `DOC`, `META`, `CODE`
    variable LContent      ! body of a DOC/META line
    variable MetaKey
    variable MetaValue
    variable Pos
    variable Tmp
    variable Tip              ! a sidebar row's tooltip, decided with its colour
    variable InSection
    variable SecHasCode
    variable SecStartTmp
    variable SecCodeTmp
    variable SecProseTmp
    variable SecHashTmp
    variable SecVerifiedTmp
    variable CurHash
    variable HashState
    variable VerifyState
    variable I
    variable Source        ! whole source text being parsed
    variable Outside       ! array: text between sections (length SecCount + 1)
    variable OutsideTmp    ! accumulator for the current outside chunk
    variable ProseSrc      ! scratch: prose text being split into lines
    variable PCount        ! scratch: count of prose lines
    variable PJ            ! scratch: index over prose lines
    variable PL            ! scratch: one prose line
    variable BlkText       ! scratch: assembled section text
    variable NewProse      ! scratch: edited prose pulled from BlocksDocPane
    variable NewCode       ! scratch: edited code pulled from BlocksCodePane
    variable OldProse      ! scratch: previously stored prose for this section
    variable OldCode       ! scratch: previously stored code for this section

!   -- Blocks: TOC + draggable divider --
    div BlocksToc          ! left sidebar listing all blocks
    div BlocksDivider      ! draggable splitter between code and doc panes
    div TocRow             ! one row per block in the TOC
    span TocLabel          ! the clickable label inside each TocRow
    variable PickPos       ! pick coords at mousedown on divider
    variable DragPos       ! drag coords during mousemove
    variable PickX
    variable DragX
    variable CodeWidthAtPick
    variable NewWidth
    variable StoredWidth
    variable FinalWidth
    variable FirstLine     ! first prose line of a block (for TOC label)
    variable From          ! first line of a block, for the review-signal test
    variable To            ! and its last line
    variable SideGapFrom   ! the line after the block before the pointer, for a line no block holds
    variable SideGapTo     ! and the line before the block after it — the run the code tab shows as a gap
    variable BlockAfter    ! index of the block after this one, which bounds it
    variable FromCheck     ! the two bounds moved out by one, so both tests can be positive
    variable ToCheck
    variable FlagCount     ! lines the plugin says nothing enters, over all blocks
    variable FlagLine      ! array: those lines
    variable K             ! walk index over the records, and over the flagged lines
    variable MarkRecord    ! one model record, as the walk reaches it
    variable MarkCount     ! how many records the plugin returned
    variable MarkLine      ! one flagged line, as the walk reaches it
    variable MarkRest      ! scratch: the record after `line=`
    variable MarkSpace     ! scratch: where its number ends
    variable MarkDigits    ! scratch: the number itself
    variable EditorPath    ! the current tab's path, handed to the plugin as its target
    variable Model         ! array: what the plugin returned
    variable NL
    variable J
!! @hash 9ca5fe1f
!! @verified fb41cca7
!!!
!! The UI is described by a DOM element 'viz-ui',
!! a <pre> element that contains all the DOM elements that go to make up the editor.
!! These are formatted using Webson, a JSON representation of any number of DOM elements,
!! which is rendered into an existing element using the 'render' command
!! 'body' without a capital, is the HTML <body> element
!! 'Body', where the first letter is a capital, is a variable that is attached to the page body
!! so that other elements - in this case those represented by the Webson -  can be added to it.
!   -- Build UI --
    attach Body to body
    attach UIPre to `viz-ui`
    put the content of UIPre into UIWebson
    render UIWebson in Body
    attach TabBar to `se-tabbar`
    attach ContentEditor to `se-textarea`
    attach StatusSpan to `se-status`
    attach OpenBtn to `se-open`
    attach FindBtn to `se-findbtn`
    attach PlusBtn to `se-plusbtn`
    attach Overlay to `se-overlay`
    attach MenuMask to `se-menu-mask`
    attach Menu to `se-menu`
    ! **The two surfaces the menu answers on, each attached by the id its own module also uses.** A symbol
    ! and an element are not one to one — a module attaches its own name to the same box — and that is what
    ! makes this possible without either program knowing about the other: `on right click GraphPic` registers
    ! a handler on `se-graph-host`, and the pane's `VizHost`, attached to the same element, is untouched.
    attach GraphPic to `se-graph-host`
    attach GraphSidePane to `se-graph-side`
    attach Scroller to `se-scroller`
    attach CloseBtn to `se-closebtn`
    attach BlocksBtn to `se-blocksbtn`
    attach GraphBtn to `se-graphbtn`
    attach RecordBtn to `se-recordbtn`
    attach LaunchBtn to `se-launchbtn`
    attach GraphArea to `se-graph-area`
    attach GraphGrip to `se-graph-grip`
    attach GraphSide to `se-graph-side`
    attach EditorArea to `se-editor-area`
    ! The welcome panel's own boxes, by id. Its container (`se-welcome-box`), the `<a>` and the two
    ! surrounding spans are attached by nothing: the box is hidden by its container's id, the link's href and
    ! text are `viz.json`'s, and only the words change with the language.
    attach Welcome to `se-welcome`
    attach WelcomeTitle to `se-welcome-title`
    attach WelcomeIntro to `se-welcome-intro`
    attach WelcomeButtons to `se-welcome-buttons`
    attach WelcomeNote to `se-welcome-note`
    attach WelcomePre to `se-welcome-pre`
    attach WelcomePost to `se-welcome-post`
    attach BlocksArea to `se-blocks-area`
    attach BlocksTitle to `se-blocks-title`
    attach BlocksPrev to `se-blocks-prev`
    attach BlocksNext to `se-blocks-next`
    attach BlocksBadge to `se-blocks-badge`
    attach BlocksVerify to `se-blocks-verify`
    attach BlocksVerifyAll to `se-blocks-verify-all`
    attach BlocksCodePane to `se-blocks-code`
    attach BlocksDocPane to `se-blocks-doc`
    attach BlocksToc to `se-blocks-toc`
    attach BlocksDivider to `se-blocks-divider`
    attach AlertPanel to `se-alert`
    attach AlertText to `se-alert-text`
    attach AlertCloseBtn to `se-alert-close`
    ! Every control is named while the UI is still being built: see `SetTips`, below the startup
    ! loops, for what a tooltip is here and why it is a subroutine rather than lines in this block.
    gosub to SetTips
!! @hash d61f049f
!! @verified d61f049f
!!!
!! Some general initialisation
!   -- CodeMirror --
    codemirror attach to ContentEditor

    put 0 into TabCount
    put 0 into ActiveTab
    put `` into CurrentPath
    ! **The three module flags start at 0 rather than merely set nowhere.** A variable with nothing in it
    ! is not zero to a comparison, so `if AlertLoaded is 0` would never fire and the notice would never be
    ! fetched — the trap that also cost the pane its hover guard (`AGENTS.md`, and `VizReady`).
    put 0 into VizLoaded
    put 0 into SideLoaded
    put 0 into AlertLoaded
!! @hash d66872e1
!! @verified 3a601096
!!!
!! Language detection
!! The command 'language xx' switches the system to the given language (fr, de, it etc.)
!! and defaults to 'en'. All of the language-specific strings are then defined for each language.
!!
!! Appendix
!!
!! §1 **Textareas, and the reason is in how `the text of` reads an element.** The branches switch on the *symbol's* type: a `div` reads `innerHTML` with every newline removed, which turns a 2,700-line module into one line — and its first line is a `!!` comment, which then comments out the lot. Measured 2026-10-04: the pane compiled as `1 lines (0 tokens)` and nothing was ever drawn. A `pre` would keep the newlines but hands back *escaped* markup, and the module has 25 `<` in it. A textarea's `value` is the text and only the text.
!   -- Detect language and set strings for each supported language --
    div LangDiv
    textarea VizSrcDiv ! §1
    textarea AlertSrcDiv
    textarea SideSrcDiv
    put `en` into Lang
    attach LangDiv to `editor-lang` or go to SetStrings
    put the text of LangDiv into Lang
    replace ` ` with `` in Lang
    replace newline with `` in Lang
    if Lang is empty put `en` into Lang

SetStrings:
    if Lang is `it`
    begin
        put `Apri` into StrOpen
        put `Cerca` into StrFind
        put `Chiudi` into StrClose
        put `Salvato` into StrSaved
        put `Salvataggio fallito` into StrSaveFailed
        put `Registrazione dell'app` into StrRecording
        put `Ricaricato` into StrReloaded
        put `Modifica esterna rilevata` into StrExtChange
        put `Impossibile connettersi al server` into StrNoConnect
        put `Salva come (nome file senza .allspeak):` into StrSaveAs
        put `(cartella vuota)` into StrEmpty
        put `.. (livello superiore)` into StrUpLevel
        put `/ (radice progetto)` into StrRoot
        put `Il visualizzatore è stato aggiornato. Ferma il server nel terminale e riavvialo, poi ricarica questa pagina.` into StrUpdated
        put `Benvenuto in Viz` into StrWelcomeTitle
        put `L'editor, il visualizzatore e il debugger di AllSpeak — un linguaggio per un mondo dove l'IA scrive il codice e tu guidi e rivedi.` into StrWelcomeIntro
        put `I pulsanti qui sopra coprono tutto il lavoro: aprire uno script, leggerlo a blocchi — la prosa di ogni parte accanto al codice che descrive — eseguirlo, catturare l'esecuzione, vedere dove è andata e saltare a una parte. Passa il puntatore su un pulsante per vedere esattamente cosa fa.` into StrWelcomeButtons
        put `Questa finestra scompare appena clicchi uno dei pulsanti.` into StrWelcomeNote
        put `Per saperne di più, visita il nostro sito a ` into StrWelcomePre
        put ` e clicca su Primer per un esempio guidato e una documentazione completa su AllSpeak.` into StrWelcomePost
        put `vaisub` into StrFlowCall
        put `vai` into StrFlowJump
        put `ritorna` into StrFlowReturn
    end
    else if Lang is `fr`
    begin
        put `Ouvrir` into StrOpen
        put `Rechercher` into StrFind
        put `Fermer` into StrClose
        put `Enregistré` into StrSaved
        put `Échec de l'enregistrement` into StrSaveFailed
        put `Enregistrement de l'app` into StrRecording
        put `Rechargé` into StrReloaded
        put `Modification externe détectée` into StrExtChange
        put `Impossible de se connecter au serveur` into StrNoConnect
        put `Enregistrer sous (nom de fichier sans .allspeak) :` into StrSaveAs
        put `(dossier vide)` into StrEmpty
        put `.. (niveau supérieur)` into StrUpLevel
        put `/ (racine du projet)` into StrRoot
        put `Le visualiseur a été mis à jour. Arrête le serveur dans le terminal et redémarre-le, puis recharge cette page.` into StrUpdated
        put `Bienvenue dans Viz` into StrWelcomeTitle
        put `L'éditeur, le visualiseur et le débogueur d'AllSpeak — un langage pour un monde où l'IA écrit le code et où vous guidez et relisez.` into StrWelcomeIntro
        put `Les boutons ci-dessus couvrent tout le travail : ouvrir un script, le lire en blocs — la prose de chaque partie à côté du code qu'elle décrit — l'exécuter, capturer l'exécution, voir où elle est passée, et sauter à une partie. Survolez un bouton pour voir exactement ce qu'il fait.` into StrWelcomeButtons
        put `Cette boîte disparaît dès que vous cliquez sur l'un des boutons.` into StrWelcomeNote
        put `Pour en savoir plus, visitez notre site à ` into StrWelcomePre
        put ` et cliquez sur Primer pour un exemple guidé et une documentation complète sur AllSpeak.` into StrWelcomePost
        put `vasous` into StrFlowCall
        put `va` into StrFlowJump
        put `retourne` into StrFlowReturn
    end
    else if Lang is `de`
    begin
        put `Öffnen` into StrOpen
        put `Suchen` into StrFind
        put `Schließen` into StrClose
        put `Gespeichert` into StrSaved
        put `Speichern fehlgeschlagen` into StrSaveFailed
        put `Aufzeichnung der App` into StrRecording
        put `Neu geladen` into StrReloaded
        put `Externe Änderung erkannt` into StrExtChange
        put `Verbindung zum Server nicht möglich` into StrNoConnect
        put `Speichern unter (Dateiname ohne .allspeak):` into StrSaveAs
        put `(leerer Ordner)` into StrEmpty
        put `.. (Ebene höher)` into StrUpLevel
        put `/ (Projektstamm)` into StrRoot
        put `Der Visualisierer wurde aktualisiert. Beenden Sie den Server im Terminal, starten Sie ihn erneut und laden Sie dann diese Seite neu.` into StrUpdated
        put `Willkommen bei Viz` into StrWelcomeTitle
        put `Der Editor, Visualisierer und Debugger für AllSpeak — eine Sprache für eine Welt, in der die KI den Code schreibt und Sie führen und prüfen.` into StrWelcomeIntro
        put `Die Schaltflächen oben decken die ganze Arbeit ab: ein Skript öffnen, es als Blöcke lesen — die Prosa jedes Teils neben dem Code, den sie beschreibt — es ausführen, den Lauf aufzeichnen, sehen, wohin er ging, und zu einem Teil springen. Zeigen Sie auf eine Schaltfläche, um genau zu sehen, was sie tut.` into StrWelcomeButtons
        put `Dieses Fenster verschwindet, sobald Sie eine der Schaltflächen anklicken.` into StrWelcomeNote
        put `Mehr dazu auf unserer Website ` into StrWelcomePre
        put ` — klicken Sie dort auf Primer für ein geführtes Beispiel und die vollständige Dokumentation zu AllSpeak.` into StrWelcomePost
        put `gosub` into StrFlowCall
        put `gehe` into StrFlowJump
        put `retourniere` into StrFlowReturn
    end
    else
    begin
        put `Open` into StrOpen
        put `Find` into StrFind
        put `Close` into StrClose
        put `Saved` into StrSaved
        put `Save failed` into StrSaveFailed
        put `Recording the app` into StrRecording
        put `Reloaded` into StrReloaded
        put `External change detected` into StrExtChange
        put `Cannot connect to server` into StrNoConnect
        put `Save as (filename without .allspeak):` into StrSaveAs
        put `(empty directory)` into StrEmpty
        put `.. (up one level)` into StrUpLevel
        put `/ (project root)` into StrRoot
        put `The visualizer has been updated. Stop the server in your terminal and start it again, then reload this page.` into StrUpdated
        put `Welcome to Viz` into StrWelcomeTitle
        put `The editor, visualizer and debugger for AllSpeak — a language for a world where AI does the coding and you do the guiding and reviewing.` into StrWelcomeIntro
        put `The buttons above take you through the whole job: open a script, read it as blocks — each part's prose beside the code it describes — run it, capture the run, see where the run went, and jump to a part. Hover over any button to see exactly what it does.` into StrWelcomeButtons
        put `This box goes as soon as you click any of the buttons.` into StrWelcomeNote
        put `To learn more, visit our website at ` into StrWelcomePre
        put ` and click Primer to see a worked example and comprehensive documentation about AllSpeak.` into StrWelcomePost
        put `gosub` into StrFlowCall
        put `go` into StrFlowJump
        put `return` into StrFlowReturn
    end
    set the content of OpenBtn to StrOpen
    set the content of FindBtn to StrFind
    set the content of CloseBtn to StrClose
    ! The welcome panel's words, once, from whichever language's set is in hand. **The panel is *up* from the
    ! moment the page renders and goes on the first click anywhere** — see `DismissWelcome` — so there is
    ! nothing here to show or hide, only to say.
    set the content of WelcomeTitle to StrWelcomeTitle
    set the content of WelcomeIntro to StrWelcomeIntro
    set the content of WelcomeButtons to StrWelcomeButtons
    set the content of WelcomeNote to StrWelcomeNote
    set the content of WelcomePre to StrWelcomePre
    set the content of WelcomePost to StrWelcomePost
!! @hash 8ac5f712
!! @verified 8a667163
!!!
!! Tells the reader when the dev server they are running has been superseded.
!!
!! The page asks the server's own `/version`, and `updated` means a restart would run a script newer than the one this process is running — the route in `server.allspeak` is where that is decided, and a copy the project keeps itself answers `OK`, because a restart would re-run it unchanged. **Nothing here restarts anything, and that is deliberate** (Graham, 2026-10-12): the dialog used to offer a restart, and the restart ran in the background — leaving a server that a Ctrl+C in the reader's own terminal could not reach, so the reader could not stop what they had started. The advice is now their own two steps in the terminal they are already looking at. `alert` rather than `confirm`, because there is no longer an action for the page to take, and the reader reloads the page themselves once the new server is up.
!   -- Tell the reader the server is out of date --
    rest get VersionResult from `/version` or go VersionDone
    if VersionResult is `updated`
        alert StrUpdated
VersionDone:
!! @hash b847cbd5
!! @verified b847cbd5
!!!
!! Set up click handlers for the various editor functions.
!! Blocks-mode handlers (toggle, navigate, mark verified) live alongside
!! the existing flat-mode handlers. The pane editor textareas have
!! keyboard input handlers wired in EnterBlocks so we can stop watching
!! them when the pane is hidden.
!!
!! Appendix
!!
!! §1 **The welcome panel goes on the first click of anything that *does* something** — and there is no single line that says so, which is worth knowing before anyone looks for one. `on click document` reads as "any click anywhere" and is not: the runtime runs a document click handler only when the click was on an `<a href>` **into this same page** (`Browser.js`, `clickDocument` — the editor's own file links are what it exists for). Measured in a browser, 2026-10-12: a click on `Blocks` left the panel standing.
!!
!! §2 So the dismissal is the first line of each control's handler — the `gosub to DismissWelcome` that opens `ShowBrowser`, `NewFile`, `DoFind`, `ToggleBlocks`, `ToggleGraph`, `RecordRun` and `LaunchApp` — with the panel itself clickable too, for a reader who clicks the prose rather than a button. **The cost is that a new button has to carry its own `gosub`**, which a list of handlers cannot be made to imply: the check below runs all seven and insists that each one puts the panel away.
!!
!! §3 **The menu opens where the pointer's other button was pressed, on each of the two surfaces it is about.** `GraphPic` and `GraphSidePane` are this file's own handles on the pane's box and the sidebar's — the pane attaches `VizHost` to the same element under its own name and the sidebar `SideHost` to the other, so one box carries two symbols and neither module has to know the editor exists. The press's own coordinates arrive in `the pick position`, which is what places the menu.
!!
!! §4 **The Graph grip, which is the one drag that belongs to Graph mode.** It moves the sidebar's *left* edge, so a pointer travelling left makes the panel wider — the opposite sense to the Blocks splitter, whose right edge the pointer carries. The clamps are a floor and a ceiling: at the floor the prose has no width left to be read in, and at the ceiling the drawing is the thing being squeezed, which is the pane's whole purpose. The ceiling is the panel's own width less a floor for the picture, so a narrow window cannot let the sidebar eat the run.
!!
!! §5 **The width kept at the pick is added *to* the travel, and the destination is the travel.** Written the other way round — `add NewWidth to GripWidthAtPick` — this compiles and runs, and is wrong twice over: the sum lands in the width kept at the pick, so the travel is left as it was and every drag clamps, and the starting width grows by the travel on *every* pointer move, so a drag that went on long enough would accelerate. The two idioms differ by which operand is the destination, and both look reasonable; the harness's grip checks exist for this line.
!!
!! §6 **The grip answers first**, because it is the one that can be held while Graph mode is up — the Blocks splitter's own guard below refuses to do anything there and would otherwise swallow this drop, losing the width the reader just chose.
!!
!! §7 Nothing is redrawn on the way out, and that is deliberate rather than an omission: the pane measures its own box on every gesture (`VizPixelScale` is called from the pick), so the picture needs no telling that its box has changed, and a redraw here would re-fit the drawing under the reader's hand for nothing.
!   -- Handlers --
    on click OpenBtn go to ShowBrowser
    on click PlusBtn go to NewFile
    on click FindBtn go to DoFind
    on click BlocksBtn go to ToggleBlocks
    on click GraphBtn go to ToggleGraph
    on click RecordBtn go to RecordRun
    on click LaunchBtn go to LaunchApp
    on click BlocksPrev go to PrevBlock
    on click BlocksNext go to NextBlock
    on click BlocksVerify go to MarkVerified
    on click BlocksVerifyAll go to MarkAllVerified
    on click AlertCloseBtn go to HideAlert
    on click Welcome go to DismissWelcome ! §1–§2
    on click MenuMask go to HideMenu
    on right click GraphPic go to ShowMenu ! §3
    on right click GraphSidePane go to ShowMenu

    on pick BlocksDivider
    begin
        ! Two splitters and one document-level drag, so the flag says which of them was taken hold of —
        ! the drag and the drop then know which they are moving without having to ask the pointer.
        put 0 into GripPicked
        put the pick position into PickPos
        put property `x` of PickPos into PickX
        put the width of BlocksCodePane into CodeWidthAtPick
    end
    on pick GraphGrip
    begin
        put 1 into GripPicked
        put the pick position into PickPos
        put property `x` of PickPos into PickX
        put the width of GraphSide into GripWidthAtPick
    end
    on drag
    begin
        put the drag position into DragPos
        if GripPicked is 1 ! §4
        begin
            put property `x` of DragPos into DragX
            take DragX from PickX giving NewWidth
            add GripWidthAtPick to NewWidth ! §5
            put 700 into GripMost
            put the width of GraphArea into Tmp
            take 320 from Tmp
            if Tmp is less than GripMost put Tmp into GripMost
            if GripMost is less than 200 put 200 into GripMost
            if NewWidth is less than 200 put 200 into NewWidth
            if NewWidth is greater than GripMost put GripMost into NewWidth
            set style `flex` of GraphSide to `0 0 ` cat NewWidth cat `px`
            return
        end
        ! A drag in Graph mode belongs to the picture, and the pane's own handler is registered on the
        ! document too — so this one has nothing to do while that pane is up, and says so by doing
        ! nothing rather than by asking the pane whether it wants it.
        if GraphMode is 0
        begin
            put property `x` of DragPos into DragX
            put DragX into NewWidth
            take PickX from NewWidth
            add CodeWidthAtPick to NewWidth
            if NewWidth is less than 100 put 100 into NewWidth
            set style `flex` of BlocksCodePane to `0 0 ` cat NewWidth cat `px`
        end
    end
    on drop
    begin
        if GripPicked is 1 ! §6–§7
        begin
            put 0 into GripPicked
            put the width of GraphSide into FinalWidth
            put FinalWidth into storage as `viz-graph-side-width`
            return
        end
        if GraphMode is 1 return
        put the width of BlocksCodePane into FinalWidth
        put FinalWidth into storage as `viz-blocks-code-width`
    end

    put 0 into BlocksMode
    put 0 into GraphMode
    put 0 into BlockDirty
!! @hash a046db0d
!! @verified a046db0d
!!!
!! One `on message`, registered here rather than with the code it runs.
!!
!! **A handler is registered by *executing* the line, and this file stops in the block below.** Everything after `fork to AutoSave` is a subroutine, so a registration written beside its own handler at the end of the file would never run: the pane's report would arrive at a program with no handler and be dropped in silence. The rule that falls out of it is worth keeping — in this editor a handler goes where the flow reaches it, and only its *body* may live at the end.
!!
!! It is named here with its body for that reason: the handler is `VizInbound`, in the Graph sidebar section, and the two are one thing split by the shape of the file rather than by design. `VizInbound` is a front door rather than the body itself because the pane now reports two kinds of news — the line under the pointer, and the freeze lifting — and one registration has to answer for both.
on message go to VizInbound
!! @hash 3e648bef
!! @verified 3e648bef
!!!
!! While editor is running it periodically saves changes made by the user
!! and updates the display to show updates made externally.
!! This avoids the need for any Save mechanism.
!   -- Start background loops --
    fork to AutoSave
    fork to PollFile
    stop
!! @hash f86feb98
!! @verified f86feb98
!!!
!! What each control says when the pointer rests on it.
!!
!! **A `title` is the browser's own rollover, and this file already uses it** — the Graph sidebar's tabs are named the same way, in `viz-side.allspeak`. It costs no element of ours, needs no positioning, and cannot be left standing by a pointer that has moved on, which is the whole of what a hand-drawn tip would have to solve for itself.
!!
!! **A control that changes what it does is named in both of its states.** `Blocks` and `Graph` are toggles whose label flips to `Edit` while their pane is up, so each tooltip is set beside its label — see `EnterBlocks`, `DoExitBlocks`, `EnterGraph` and `DoExitGraph` — and this block is the state a freshly opened editor is in. **And the one that reads `Edit` also moves to the head of the bar**: the way back should be in the same place whichever pane the reader is in, so the five buttons each state an `order` in `viz.json` and `EnterGraph` shifts the group along by one for its `Edit` to take the first place. A hidden button takes no place, and the sequence with any of them missing is still `Edit - Blocks - Launch - Record - Graph - Find`.
!!
!! **The words are English, and that is the standing gap rather than a choice made here.** Only the chrome in `SetStrings` is translated; the status line and every message in this file are English already, so a tooltip localised on its own would read as a third language. The batch that closes it is in `TODO.md`.
SetTips:
    set attribute `title` of OpenBtn to `Open a file from this project`
    set attribute `title` of PlusBtn to `Start a new file`
    set attribute `title` of FindBtn to `Find a block holding the text you have selected`
    set attribute `title` of BlocksBtn to `Show this script as blocks, one block at a time`
    set attribute `title` of GraphBtn to `Show the run this script recorded, as a picture`
    set attribute `title` of RecordBtn to `Run this script and save its recording beside it`
    set attribute `title` of LaunchBtn to `Open the page this script names with '@app', in a new window`
    set attribute `title` of BlocksPrev to `Previous block`
    set attribute `title` of BlocksNext to `Next block`
    set attribute `title` of BlocksVerify to `Mark this block verified, at its present hash`
    set attribute `title` of BlocksVerifyAll to `Mark every block in this file verified`
    set attribute `title` of CloseBtn to `Close the file browser`
    set attribute `title` of AlertCloseBtn to `Put this message away`
    return
!! @hash 21476b47
!! @verified 21476b47
!!!
!! The alert panel: one box that says what is happening and stays until it is read.
!!
!! **Why a panel rather than the status line, which is where messages go now.** The status line is a strip at the far end of the window, one line wide, and every message on it is cleared after three seconds whether or not anybody read it. That is right for `Saved` and wrong for anything a reader has to *understand* — the two module-load failures below are the ones that were worst served by it, because the editor also leaves the mode they belong to, so the explanation and the symptom arrived a line apart and both went. A panel near the top, in front of everything, with a Close button, is the shape Graham asked for.
!!
!! **The same panel is the Graph pane's.** `viz-graph.allspeak` attaches to `se-alert` and `se-alert-text` by the same ids this file uses and writes its own message there — the long-drawing notice and the number it counts while it waits — so there is one place on the page a message of this kind appears, and neither program has to know about the other's text. The Close button is this file's (`HideAlert`), because the panel is named in `viz.json` beside the editor's own elements and a page element's controls belong to whoever rendered them.
!!
!! **A message is written with `set the content of`, so it must not carry markup.** That is the trap the Launch message fell into — a `<page>` placeholder in angle brackets was parsed as a tag and never rendered — so anything meant to be read as a literal wants a concrete example rather than a placeholder. The pane's messages are its own and obey the same rule.
ShowAlert:
    ! Reads `AlertMsg`; the panel's visibility is the whole of the state it keeps. A subroutine rather
    ! than an entry point, because the two callers below are in the middle of their own flow — the
    ! sidebar's failure in particular must let `EnterGraph` carry on, since a missing sidebar is not a
    ! reason to stop showing a picture.
    set the content of AlertText to AlertMsg
    set style `display` of AlertPanel to `flex`
    return

HideAlert:
    ! The Close button's own entry, and the one place the panel is put away. `on click` reaches a label
    ! rather than a subroutine, so this ends the flow it started instead of returning to a caller that
    ! does not exist.
    set style `display` of AlertPanel to `none`
    stop
!! @hash 5b38b66f
!! @verified 5b38b66f
!!!
!! Every half-second, changes to the content are saved.
!!
!! TabSaved is an array of tab contents. If its content differs from that currently held in the editor, the current content is saved to the file and TabSaved is updated.
!   -- Auto-save loop --
AutoSave:
    wait 500 millis
    if TabCount is 0
    begin
        fork to AutoSave
        stop
    end
    codemirror get content of ContentEditor into Content
    index TabSaved to ActiveTab
    if Content is not TabSaved
    begin
        index TabPath to ActiveTab
        if TabPath is empty
        begin
            if Content is empty
            begin
                fork to AutoSave
                stop
            end
            put prompt StrSaveAs into File
            if File is empty
            begin
                fork to AutoSave
                stop
            end
            put File cat `.allspeak` into File
            ! Save into the currently browsed directory
            if CurrentPath is not empty
                put CurrentPath cat `/` cat File into File
            index TabPath to ActiveTab
            put File into TabPath
            index TabName to ActiveTab
            put File into TabName
            gosub to RebuildTabBar
        end
        rest post Content to `/write/` cat TabPath or go SaveFailed
        index TabSaved to ActiveTab
        put Content into TabSaved
        set the content of StatusSpan to StrSaved
        fork to ClearStatus
    end
    fork to AutoSave
    stop

SaveFailed:
    set the content of StatusSpan to StrSaveFailed
    fork to ClearStatus
    fork to AutoSave
    stop
!! @hash 63538f67
!! @verified 63538f67
!!!
!! Every 3 seconds, the current file is re-read into FileContent.
!!
!! If this differs from what is currently held in TabSaved for this tab, the editor content is updated and a message is displayed briefly.
!!
!! Appendix
!!
!! §1 Formatted as it is read, exactly as the loader formats it. Without this the poll compares a one-line file on disk against the formatted text in the tab, sees a difference on every pass, and reloads the file over the formatted text every three seconds — which is what "it formats it, then after a couple of seconds reverts to a one-liner" turned out to be. Like has to be compared with like for the poll to settle.
!   -- External change polling --
PollFile:
    wait 3 seconds
    if TabCount is 0
    begin
        fork to PollFile
        stop
    end
    ! A mode that owns the screen must not have its content reloaded underneath it. In Blocks mode the
    ! in-memory Sections array is the source of truth and a silent reload would clobber the user's pane
    ! edits; in Graph mode the poll replaced the editor's content every three seconds while the graph was
    ! up, which is when the drawing was seen to be overwritten. Either way, skip until the pane is left.
    if BlocksMode is 1 or GraphMode is 1 go to PollNext
    index TabPath to ActiveTab
    if TabPath is empty go to PollNext
    rest get FileContent from `/read/` cat TabPath or go PollNext
    if TabPath ends with `.json` ! §1
    begin
        put FileContent into JsonText
        gosub to FormatJson
        put JsonText into FileContent
    end
    codemirror get content of ContentEditor into Content
    index TabSaved to ActiveTab
    if FileContent is not TabSaved
    begin
        if Content is TabSaved
        begin
            ! Editor is clean -- silently reload
            put FileContent into TabSaved
            codemirror set content of ContentEditor to FileContent
            set the content of StatusSpan to StrReloaded
            fork to ClearStatus
        end
        else
        begin
            set the content of StatusSpan to StrExtChange
        end
    end
PollNext:
    fork to PollFile
    stop
!! @hash 6d5bfafb
!! @verified 6d5bfafb
!!!
!! File browser overlay behind the Open button: lists the current directory, navigates into folders and back to the project root, and hands the chosen file to the tab-management section to open.
!   -- File browser with directory navigation --
ShowBrowser:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    ! Opening a tab while Blocks mode is up leaves the panes out of sync with
    ! the active tab's source; switch back to flat mode first.
    if BlocksMode is 1 gosub to DoExitBlocks
    rest get FileList from `/list/` cat CurrentPath or go BrowserError
    put the json count of FileList into FileCount
    set the elements of FileRow to FileCount
    set the elements of FileName to FileCount
    set the content of Scroller to ``

    ! Show current path at top
    create FileRow in Scroller
    set the style of FileRow to `padding:4px 8px;font-size:0.85em;color:#666;border-bottom:1px solid #ddd`
    if CurrentPath is empty
        set the content of FileRow to StrRoot
    else
        set the content of FileRow to `/` cat CurrentPath

    ! Show "back" row if inside a subdirectory
    if CurrentPath is not empty
    begin
        create FileRow in Scroller
        set the style of FileRow to `padding:4px 8px;cursor:pointer;background:#f0f0ff`
        set the content of FileRow to StrUpLevel
        on click FileRow go to GoUp
    end

    if FileCount is 0
    begin
        create FileRow in Scroller
        set the style of FileRow to `padding:4px 8px;color:#999`
        set the content of FileRow to StrEmpty
    end

    put 0 into N
    while N is less than FileCount
    begin
        put element N of FileList into Item
        put property `name` of Item into EntryName
        put property `type` of Item into EntryType
        index FileRow to N
        create FileRow in Scroller
        set the style of FileRow to `padding:3px 8px;cursor:pointer`
        index FileName to N
        create FileName in FileRow
        if EntryType is `dir`
        begin
            set the style of FileName to `display:block;padding:3px 0;cursor:pointer;font-weight:bold`
            set the content of FileName to `📁 ` cat EntryName
        end
        else
        begin
            set the style of FileName to `display:block;padding:3px 0;cursor:pointer`
            set the content of FileName to EntryName
        end
        on click FileName go to SelectEntry
        add 1 to N
    end
    on click CloseBtn go to CloseBrowser
    set style `display` of Overlay to `block`
    stop

GoUp:
    put the position of the last `/` in CurrentPath into N
    if N is less than 0
        put `` into CurrentPath
    else
        put left N of CurrentPath into CurrentPath
    go to ShowBrowser

BrowserError:
    set the content of StatusSpan to StrNoConnect
    fork to ClearStatus
    stop

!   -- Entry selected in browser --
SelectEntry:
    put the index of FileName into N
    put element N of FileList into Item
    put property `name` of Item into EntryName
    put property `type` of Item into EntryType
    if EntryType is `dir`
    begin
        ! Navigate into directory
        if CurrentPath is empty
            put EntryName into CurrentPath
        else
            put CurrentPath cat `/` cat EntryName into CurrentPath
        go to ShowBrowser
    end
    ! Build full relative path and open file
    if CurrentPath is empty
        put EntryName into TabItem
    else
        put CurrentPath cat `/` cat EntryName into TabItem
    set style `display` of Overlay to `none`
    put EntryName into File
    go to OpenFile

CloseBrowser:
    set style `display` of Overlay to `none`
    stop
!! @hash 4dfa3b5b
!! @verified 4dfa3b5b
!!!
!! This section is tab management; creating a new tab, opening a file, selecting a tab and closing a tab.
!! Activating a tab leaves Blocks mode first. A tab is a different file, and Blocks mode belongs to the file you were reading — so switching tabs, and opening a file, both land in the flat editor rather than refusing to move until you leave the mode by hand.
!! **A tab remembers where the flat editor was standing** — the caret's line and the viewport's scroll offset — and puts both back on return, whether the reader left by the tab bar, the Blocks button or the Graph one. Two values rather than one because they are independent: scrolling must not move the insertion point, and coming back must not carry the view to the caret, which is the jump a video editor teaches you to distrust. `codemirror` carries a command for each half and each half only — `cursor to line` does not scroll and `view to` does not move the caret — and the scroll one refreshes the editor on the way, which a CodeMirror hidden by a mode switch needs.
!!
!! Appendix
!!
!! §1 Make room for one more tab: the count up by one and every per-tab array grown to match. **In one place, and that is the point of it.** There are two ways to open a tab — the + button and the file browser — and each used to grow the arrays itself, so an array added for one of them is a tab that fails in the other. That is not hypothetical: the caret and view records added for the tab restoration above went into `NewFile` only, and opening a *file* then died with "Array index 1 is out of range for 'TabCursor'" the moment a second tab existed with no slot to hold it. `CloseTab` shifts the value-carrying arrays back down when a tab goes — the element ones are rebuilt from the count instead — so it is the other place that has to know this list, and there are only two.
!!
!! §2 **The new slot is cleared, not assumed empty.** Growing an array does not shorten it, so a slot vacated when a tab was closed keeps whatever it held — and the two records below are only ever *read*, so a stale caret and scroll would be put back on a tab that has never been anywhere. The other arrays are written by their callers straight afterwards, which is why they never showed it. Empty is also what `TabRestore` wants: it asks whether a value is *numeric*, so a cleared slot is a tab with nowhere to restore to, which is the honest answer for one that has never been left.
!!
!! §3 Only a file that is *one line* is reformatted. A file already laid out, at whatever indent its author chose, is left exactly as it is — the complaint is that one line of JSON is unreadable, not that somebody's formatting is wrong, and normalising it would rewrite their file the first time they saved. `json split` divides on newline by default, so the test costs two statements and needs no new vocabulary.
!!
!! §4 The formatted text is what the tab records as its own, so opening a file does not mark it modified — and because the poll formats the file it reads in just the same way, the two agree and the tab settles rather than reloading itself every three seconds. Malformed JSON is left as it is: a file that will not parse is the one you most want to look at, so the error is caught rather than reported. The runtime's own formatter does the work — `json format` is JSON.stringify with a two-space indent, the same indent the Python runtime writes on save.
!!
!! §5 Where the flat editor is standing, remembered per tab and put back on return. The caret and the view are kept apart on purpose: `codemirror cursor to line` does not scroll and `codemirror view to` does not move the caret, so a revisit restores both without one dragging the other. Restoring the caret *and then* the view is the order that matters — the view is the one that has to end up exact, and setting the caret cannot disturb it.
TabGrow: ! §1–§2
    add 1 to TabCount
    set the elements of TabPath to TabCount
    set the elements of TabName to TabCount
    set the elements of TabSaved to TabCount
    set the elements of TabCursor to TabCount
    set the elements of TabView to TabCount
    set the elements of TabBtn to TabCount
    set the elements of TabLabel to TabCount
    set the elements of TabClose to TabCount
    ! `TabCount - 1`, because an index is counted from zero and the count is not: the slot just made is
    ! the last one, not the next one. (`Tmp` rather than `N`, which the callers are holding the new
    ! tab's index in.)
    put TabCount into Tmp
    subtract 1 from Tmp
    index TabCursor to Tmp
    put `` into TabCursor
    index TabView to Tmp
    put `` into TabView
    return

!   -- New empty tab --
NewFile:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    put TabCount into N
    gosub to TabGrow
    index TabPath to N
    put `` into TabPath
    index TabName to N
    put `new` into TabName
    index TabSaved to N
    put `` into TabSaved
    put N into ActiveTab
    go to ActivateTab

!   -- Open a file (TabItem=relative path, File=display name) --
OpenFile:
    ! Check if already open in a tab
    put 0 into N
    while N is less than TabCount
    begin
        index TabPath to N
        if TabPath is TabItem
        begin
            put N into ActiveTab
            go to ActivateTab
        end
        add 1 to N
    end
    ! Not open -- load from server and create a new tab
    rest get Content from `/read/` cat TabItem or go BrowserError
    if TabItem ends with `.json`
    begin
        put Content into JsonText
        gosub to FormatJson
        put JsonText into Content
    end
    gosub to TabGrow
    index TabPath to N
    put TabItem into TabPath
    index TabName to N
    put File into TabName
    index TabSaved to N
    put Content into TabSaved
    put N into ActiveTab
    go to ActivateTab

!   -- A JSON file arrives minified as often as not, and one line of it is unreadable --
FormatJson:
    json split JsonText into JsonLines ! §3
    if the json count of JsonLines is greater than 1 return
    json format JsonText or go FormatJsonEnd ! §4
FormatJsonEnd:
    return

!   -- Switch to an existing tab --
SwitchTab:
    put the index of TabLabel into ActiveTab
    go to ActivateTab

!   -- Close a tab --
CloseTab:
    put the index of TabClose into M
    ! Shift elements above M down by one
    put M into N
    add 1 to N
    while N is less than TabCount
    begin
        index TabPath to N
        put TabPath into File
        subtract 1 from N
        index TabPath to N
        put File into TabPath
        add 1 to N
        index TabName to N
        put TabName into File
        subtract 1 from N
        index TabName to N
        put File into TabName
        add 1 to N
        index TabSaved to N
        put TabSaved into FileContent
        subtract 1 from N
        index TabSaved to N
        put FileContent into TabSaved
        add 1 to N
        index TabCursor to N
        put TabCursor into Tmp
        subtract 1 from N
        index TabCursor to N
        put Tmp into TabCursor
        add 1 to N
        index TabView to N
        put TabView into Tmp
        subtract 1 from N
        index TabView to N
        put Tmp into TabView
        add 1 to N
        add 1 to N
    end
    subtract 1 from TabCount
    if TabCount is 0
    begin
        put 0 into ActiveTab
        codemirror set content of ContentEditor to ``
        set the content of TabBar to ``
        stop
    end
    ! Adjust ActiveTab if it was after the closed tab
    if ActiveTab is greater than M subtract 1 from ActiveTab
    ! Clamp ActiveTab to valid range
    put TabCount into FileCount
    subtract 1 from FileCount
    if ActiveTab is greater than FileCount
    begin
        put FileCount into ActiveTab
    end
    go to ActivateTab

TabRemember: ! §5
    if TabCount is 0 return
    index TabCursor to ActiveTab
    codemirror get cursor of ContentEditor into TabCursor
    index TabView to ActiveTab
    codemirror view of ContentEditor into TabView
    return

TabRestore:
    if TabCount is 0 return
    ! `is numeric` and not `is not empty`: a tab that has never been left has an untouched slot, and
    ! zero is a perfectly good caret line and scroll offset — so the test has to be about the kind of
    ! value, not about whether there is one.
    index TabCursor to ActiveTab
    if TabCursor is numeric codemirror cursor to line TabCursor in ContentEditor
    index TabView to ActiveTab
    if TabView is numeric codemirror view to TabView in ContentEditor
    return

ActivateTab:
    gosub to DoExitPanes
    gosub to TabRemember
    index TabSaved to ActiveTab
    codemirror set content of ContentEditor to TabSaved
    gosub to TabRestore
    gosub to RebuildTabBar
    stop
!! @hash 8a69e9c5
!! @verified 8a69e9c5
!!!
!! Rebuilding the tab bar is done by assigning styles to each tab to indicate which one is current.
RebuildTabBar:
!   -- Rebuild tab bar --
    set the content of TabBar to ``
    put 0 into N
    while N is less than TabCount
    begin
        index TabBtn to N
        create TabBtn in TabBar
        if N is ActiveTab
        begin
            set the style of TabBtn to `display:flex;align-items:center;gap:4px;padding:4px 10px;cursor:pointer;background:#555;color:white;border-bottom:2px solid lightgreen`
        end
        else
        begin
            set the style of TabBtn to `display:flex;align-items:center;gap:4px;padding:4px 10px;cursor:pointer;background:#3a3a3a;color:#aaa`
        end
        index TabLabel to N
        create TabLabel in TabBtn
        index TabName to N
        set the text of TabLabel to TabName
        on click TabLabel go to SwitchTab
        index TabClose to N
        create TabClose in TabBtn
        set attribute `src` of TabClose to `https://allspeak.ai/icon/stop.png`
        set attribute `title` of TabClose to `Close this tab`
        set the style of TabClose to `width:12px;height:12px;opacity:0.6;cursor:pointer`
        on click TabClose go to CloseTab
        add 1 to N
    end
    return
!! @hash 2ade580b
!! @verified 2ade580b
!!!
!! Here are some utility functions.
!! DoFind searches in flat mode via CodeMirror's find dialog; in Blocks mode it jumps to the next block whose code or prose contains the text selected in either pane (wrapping around), highlighting the match so repeated presses walk through the hits.
!   -- Find --
DoFind:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    if BlocksMode is 1 go to FindInBlocks
    codemirror find in ContentEditor
    stop

FindInBlocks:
    ! Blocks-mode find: walk the sections after the current one (wrapping)
    ! for the term selected in either pane and jump to the first hit.
    put the selected text into SearchTerm
    if SearchTerm is empty
    begin
        set the content of StatusSpan to `Select text in a pane to search blocks`
        fork to ClearStatus
        stop
    end
    put CurBlock into I
    add 1 to I
    while I is not CurBlock
    begin
        put I modulo SecCount into I
        if I is CurBlock go to FindNotFound
        gosub to BlockContains
        if Found is 1 go to FindMatch
        add 1 to I
    end
FindNotFound:
    set the content of StatusSpan to `No other block contains ` cat SearchTerm
    fork to ClearStatus
    stop
FindMatch:
    put I into CurBlock
    gosub to RenderBlock
    gosub to SelectOccurrence
    put CurBlock into I
    add 1 to I
    set the content of StatusSpan to `Found in block ` cat I cat ` of ` cat SecCount
    fork to ClearStatus
    stop

BlockContains:
    ! Search section I's code then prose for the term (SearchTerm); sets Found and FoundPane.
    put 0 into Found
    index SecCode to I
    put the position of SearchTerm in SecCode into Pos
    if Pos is not less than 0
    begin
        put 1 into Found
        put `code` into FoundPane
        return
    end
    index SecProse to I
    put the position of SearchTerm in SecProse into Pos
    if Pos is not less than 0
    begin
        put 1 into Found
        put `doc` into FoundPane
    end
    return

SelectOccurrence:
    ! Highlight the first occurrence of the term (SearchTerm) in the pane that matched.
    if FoundPane is `code`
    begin
        index SecCode to CurBlock
        put the position of SearchTerm in SecCode into Pos
        if Pos is not less than 0
        begin
            put Pos into N
            put the length of SearchTerm into M
            add N to M
            set the selection of BlocksCodePane from N to M
        end
    end
    else
    begin
        index SecProse to CurBlock
        put the position of SearchTerm in SecProse into Pos
        if Pos is not less than 0
        begin
            put Pos into N
            put the length of SearchTerm into M
            add N to M
            set the selection of BlocksDocPane from N to M
        end
    end
    return

!   -- Utilities --
ClearStatus:
    wait 3 seconds
    set the content of StatusSpan to ``
    stop
!! @hash 674162f4
!! @verified 674162f4
!!!
!! Blocks parser. Walks the current Source line-by-line and populates the per-section arrays (Start, End, Prose, Code, Hash, Verified, HashState, VerifyState) plus the Outside-content array used to preserve text between sections during rebuild.
!!
!! Same classifier logic as tools/asdoc-check.allspeak — the spec is one source of truth even though the code is duplicated here for the editor's in-process use.
!!
!! Appendix
!!
!! §1 -- Review signals -- What the parse cannot see for itself: blocks nothing enters. The viz plugin compiles the same source and reports it. Nothing here raises an error — a buffer mid-edit frequently will not compile, which is the editor's ordinary condition, and the plugin simply reports fewer records. With no flags the TOC renders exactly as it did before.
!!
!! §2 **The attributes the program carries — the real spelling.** The plugin reads them off the compiled program, which is the only place they can be read correctly: the tokeniser is what knows an `@` inside a literal from an attribute, so a reader scanning the buffer's text would be a second, worse implementation of that rule. A file-level attribute like `@app parser.html` is a line of its own, and its record carries the line it is on, so a tool that wants to point at it can.
!!
!! §3 Which runtime this tab's script is for, and where that came from: `flavour | py | from=script`.
!!
!! §4 **Read from the model and not from the script's own attributes**, and that is the fault this replaced. An `attr` record is emitted only for a program the runtime *compiled* — and a script carrying `@py` is by definition one the JavaScript runtime cannot compile, because `dictionary` and `list` are Python's. So the marker was invisible to the editor exactly when it mattered: `parser.allspeak` with `@py` at the top and `dictionary` at line 43 modelled to `commands=0`, no `attr` records, `TabFlavour` fell through to the project's answer and Record refused a script it had been built to run. Reported by Graham, 2026-10-05. The plugin reports this from the *token stream*, so it is there whether the compile succeeded or not.
!!
!! §5 **A `@py` script cannot be launched, so its Launch button is hidden.** Launching hands the script to the page's JavaScript runtime, and `@py` is by definition a script that runtime cannot compile — `dictionary` and `list` are Python's — so the button would open a window that does nothing, which is worse than a button that is not there. Graham asked for it on 2026-10-11, in the same breath as the tab order.
!!
!! §6 **Whose flavour it follows is the *tab's*, and this is called from the parse**, so adding or deleting the marker moves the button on the next keystroke. That is the same rule `AppPage` and `TabFlavour` already follow: a cleared value re-resolved per parse, never a memory of the last script. A tab the model says nothing about is not `py` — the plugin's own answer is `js` when neither the script nor the project says otherwise — so an empty `TabFlavour` shows the button.
!!
!! §7 The value written back is the one `viz.json` states for the button, and it states it rather than leaving it to the browser's default for a `<button>`: a hide has to know what it is hiding *from*, and a stylesheet that names the value is one the button can be put back to. Launch is the only button that carries it, because it is the only one ever hidden.
!!
!! §8 **Written only when it changes, because the auto-save loop parses twice a second.** The editor rewrites a good deal per keystroke; this is one write that can simply not happen.
!!
!! §9 A key and the rest of it, from an attribute's text.
!!
!! §10 **The one reading of an attribute's text, shared by both places attributes arrive.** A `@`-line inside a `!!` doc block is the analyser's metadata and never reaches the compiler; an attribute in the script itself is carried into the program and comes back through the model. They are the same thing to a reader — a key, a space, and the rest — so they are split in one place rather than two, and a tool vocabulary read here reads the same either way.
!!
!! §11 The spelling `!! @app` is accepted and is not the real thing: the doc-block form says nothing to the compiler, so a page named there launches a page that the *program* does not know about. Prefer `@app`.
ParseSource:
    put `` into AppPage
    ! The flavour is re-resolved on every parse, for the same reason `AppPage` is cleared: a marker that has
    ! just been deleted, or a `@py` that has just been added, must not go on deciding.
    put `` into TabFlavour
    put 0 into SecCount
    put 0 into InSection
    put `` into Source
    codemirror get content of ContentEditor into Source
    put Source into Lines
    split Lines
    put the elements of Lines into LineCount
    set the elements of Outside to 1
    index Outside to 0
    put `` into Outside
    put `` into OutsideTmp
    put 0 into N
    while N is less than LineCount
    begin
        index Lines to N
        put Lines into Line
        gosub to Classify
        if InSection is 0 gosub to OutsideDispatch
        else gosub to InsideDispatch
        add 1 to N
    end
    if InSection is 1
    begin
        ! Unclosed section — close synthetically so user can still see it.
        gosub to CloseSection
    end
    ! Save trailing outside chunk; need to grow Outside one past the last
    ! per-section index allocated by OpenSection.
    put SecCount into Tmp
    add 1 to Tmp
    set the elements of Outside to Tmp
    index Outside to SecCount
    put OutsideTmp into Outside

    put 0 into FlagCount ! §1
    index TabPath to ActiveTab
    put TabPath into EditorPath
    model the script in EditorPath as Source giving Model
    put the elements of Model into MarkCount
    put 0 into K
    while K is less than MarkCount
    begin
        index Model to K
        put Model into MarkRecord
        if MarkRecord starts with `anchor | reachable=no` gosub to NoteMarker
        add 1 to K
    end

    ! A script the plugin cannot compile yields no anchors and so no flags — which used to
    ! look exactly like a clean file. The plugin reports why in a `problem` record, so say it:
    ! a reviewer's first question about an empty picture is whether there was anything to draw.
    ! The record carries the runtime's own wording, so it is already in the reader's language.
    put 0 into K
    while K is less than MarkCount
    begin
        index Model to K
        put Model into MarkRecord
        if MarkRecord starts with `problem |` gosub to NoteProblem
        add 1 to K
    end

    put 0 into K ! §2
    while K is less than MarkCount
    begin
        index Model to K
        put Model into MarkRecord
        if MarkRecord starts with `attr | ` gosub to NoteAttribute
        if MarkRecord starts with `flavour | ` gosub to NoteFlavour
        add 1 to K
    end
    ! Last, because it is the one thing here that is not a parse result: the flavour decides whether the
    ! Launch button belongs on the bar at all. See `LaunchButton`.
    gosub to LaunchButton
    return

!   One attribute, as the model reports it: `attr | line=N | <text>`.
!   The text is the language's to carry and a tool's to read — the runtime never splits a key from a value — so
!   the split below is the tool's, on the record's own separator, which the text cannot contain.
NoteAttribute:
    split MarkRecord on ` | `
    if the elements of MarkRecord is less than 3 return
    index MarkRecord to 2
    put MarkRecord into LContent
    gosub to SplitMeta
    return

NoteFlavour: ! §3–§4
    split MarkRecord on ` | `
    if the elements of MarkRecord is less than 3 return
    index MarkRecord to 1
    put MarkRecord into TabFlavour
    return

LaunchButton:
    put 0 into LaunchHide ! §5–§8
    if TabFlavour is `py` put 1 into LaunchHide
    if LaunchHide is LaunchHidden return
    put LaunchHide into LaunchHidden
    if LaunchHide is 0
    begin
        set style `display` of LaunchBtn to `inline-block`
        return
    end
    set style `display` of LaunchBtn to `none`
    return

OutsideDispatch:
    if Kind is `DOC` gosub to OpenSection
    else if Kind is `META` gosub to OpenSection
    else
    begin
        if OutsideTmp is empty put Line into OutsideTmp
        else put OutsideTmp cat newline cat Line into OutsideTmp
    end
    return

InsideDispatch:
    if Kind is `TERM` gosub to CloseSection
    else if Kind is `META` gosub to RecordMeta
    else if Kind is `DOC` gosub to AppendProse
    else if Kind is `CODE` gosub to AppendCode
    return

!   Classify the current line as code/comment or documentation
Classify:
    put `CODE` into Kind
    if Line is `!!!`
    begin
        put `TERM` into Kind
        return
    end
    if Line is `!!`
    begin
        put `DOC` into Kind
        put `` into LContent
        return
    end
    if Line starts with `!! ` or Line starts with `!!` cat tab
    begin
        put `DOC` into Kind
        put from 3 of Line into LContent
        gosub to MaybeMeta
        return
    end
    return

!   Deal with @ (META)
MaybeMeta:
    if LContent starts with `@`
    begin
        put `META` into Kind
        put from 1 of LContent into LContent
        gosub to SplitMeta
    end
    return

SplitMeta: ! §9–§11
    put the position of ` ` in LContent into Pos
    if Pos is less than 0
    begin
        put LContent into MetaKey
        put `` into MetaValue
    end
    else
    begin
        put left Pos of LContent into MetaKey
        add 1 to Pos
        put from Pos of LContent into MetaValue
    end
    if MetaKey is `app` put MetaValue into AppPage
    return

OpenSection:
    ! Finalize the outside chunk that ended with the previous line.
    put SecCount into Tmp
    add 1 to Tmp
    set the elements of Outside to Tmp
    index Outside to SecCount
    put OutsideTmp into Outside
    put `` into OutsideTmp
    put N into SecStartTmp
    add 1 to SecStartTmp
    put 1 into InSection
    put `` into SecProseTmp
    put `` into SecCodeTmp
    put `` into SecHashTmp
    put `` into SecVerifiedTmp
    put 0 into SecHasCode
    if Kind is `META` gosub to RecordMeta
    if Kind is `DOC` gosub to AppendProse
    return

RecordMeta:
    if MetaKey is `hash` put MetaValue into SecHashTmp
    if MetaKey is `verified` put MetaValue into SecVerifiedTmp
    return

AppendProse:
    if SecProseTmp is empty put LContent into SecProseTmp
    else put SecProseTmp cat newline cat LContent into SecProseTmp
    return

AppendCode:
    if SecCodeTmp is empty put Line into SecCodeTmp
    else put SecCodeTmp cat newline cat Line into SecCodeTmp
    if Line is not `` put 1 into SecHasCode
    return

CloseSection:
    ! Compute hash + states.
    if SecHasCode is 0 gosub to ScoreNoCode
    else gosub to ScoreWithCode
    ! Grow all the per-section arrays by one and store this section.
    put SecCount into I
    add 1 to SecCount
    set the elements of SecStart to SecCount
    set the elements of SecEnd to SecCount
    set the elements of SecProse to SecCount
    set the elements of SecCode to SecCount
    set the elements of SecHash to SecCount
    set the elements of SecVerified to SecCount
    set the elements of SecHashState to SecCount
    set the elements of SecVerifyState to SecCount
    index SecStart to I
    put SecStartTmp into SecStart
    index SecEnd to I
    put N into SecEnd
    add 1 to SecEnd
    index SecProse to I
    put SecProseTmp into SecProse
    index SecCode to I
    put SecCodeTmp into SecCode
    index SecHash to I
    put CurHash into SecHash    ! store current hash as the live one (not stale-stored)
    index SecVerified to I
    put SecVerifiedTmp into SecVerified
    index SecHashState to I
    put HashState into SecHashState
    index SecVerifyState to I
    put VerifyState into SecVerifyState
    put 0 into InSection
    put `` into OutsideTmp
    return

ScoreNoCode:
    put `` into CurHash
    put `no-code` into HashState
    if SecVerifiedTmp is empty put `unverified` into VerifyState
    else put `verified-no-code` into VerifyState
    return

ScoreWithCode:
    put hash SecCodeTmp into Tmp
    put left 8 of Tmp into CurHash
    if SecHashTmp is empty put `no-baseline` into HashState
    else if SecHashTmp is CurHash put `fresh` into HashState
    else put `stale` into HashState
    if SecVerifiedTmp is empty put `unverified` into VerifyState
    else if SecVerifiedTmp is CurHash put `verified-fresh` into VerifyState
    else put `verified-stale` into VerifyState
    return
!! @hash 5fc18a1f
!! @verified 5fc18a1f
!!!
!! Blocks view.
!! ToggleBlocks switches between flat and Blocks panes.
!! EnterBlocks parses the current source, opens the block containing the flat editor's cursor line (so the pane lands where you were working), and scrolls the TOC to that block.
!! ExitBlocks flushes pending edits, reveals the flat pane again, and scrolls it to the start of the block just viewed; the work is in DoExitBlocks so ShowBrowser can call it as a subroutine before opening a tab.
!! RenderBlock paints the textareas and the toolbar badge for the current section.
!! UpdateBadge derives badge text/colour from the section's hash and verify states.
!!
!! Appendix
!!
!! §1 Enter Blocks mode **At most one mode is on, and `DoExitPanes` is where that is said.** Every entry point turns the others off through it rather than each naming the ones it happens to know about — which is how this one came to miss the Graph pane: it was written before Graph existed, and nothing pointed at the assumption. The omission had two faces, and Graham found both by the one path that showed it, Graph then Blocks: the Graph button still read `Edit`, so two buttons offered to leave a pane neither of which was on, and `VizHost` was never hidden, so the graph sat under the Blocks pane.
!!
!! §2 Remembered here rather than on the way *in*, because leaving is what moves the editor: the scroll above is deliberate and puts the block's start at the top, and that is where the reader then is. Every way out of Blocks passes through this subroutine — the button, a tab switch, and the way into Graph — so one save here covers all of them, and the pair of values is consistent whichever way the reader came back.
ToggleBlocks:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    if BlocksMode is 0 go to EnterBlocks
    go to ExitBlocks

EnterBlocks: ! §1
    gosub to DoExitPanes
    gosub to ParseSource
    if SecCount is 0
    begin
        set the content of StatusSpan to `No doc blocks in this file`
        fork to ClearStatus
        stop
    end
    ! Open the block containing the flat editor's cursor: the last section
    ! whose opener line is at or above the cursor's line, so a cursor in the
    ! gap between two blocks lands on the block above. Falls back to block 0
    ! when the cursor is above the first section.
    codemirror get cursor of ContentEditor into Tmp
    add 1 to Tmp
    put 0 into CurBlock
    put 0 into I
    while I is less than SecCount
    begin
        index SecStart to I
        if SecStart is not greater than Tmp put I into CurBlock
        add 1 to I
    end
    put 1 into BlocksMode
    ! The toggle button now leaves Blocks mode, so relabel it.
    set the content of BlocksBtn to `Edit`
    set attribute `title` of BlocksBtn to `Back to the plain editor`
    set style `display` of EditorArea to `none`
    set style `display` of BlocksArea to `flex`
    ! Restore divider position from previous session if persisted.
    get StoredWidth from storage as `viz-blocks-code-width`
    if StoredWidth is `null` put 0 into StoredWidth
    if StoredWidth is `undefined` put 0 into StoredWidth
    if StoredWidth is empty put 0 into StoredWidth
    if StoredWidth is greater than 100
        set style `flex` of BlocksCodePane to `0 0 ` cat StoredWidth cat `px`
    gosub to RenderToc
    ! Reveal the current block's row in the TOC sidebar.
    index TocRow to CurBlock
    scroll TocRow into view
    gosub to RenderBlock
    stop

!   Exit Blocks mode
ExitBlocks:
    gosub to DoExitBlocks
    stop

!   Exit Blocks mode (callable as a subroutine -- e.g. from ShowBrowser)
DoExitBlocks:
    gosub to FlushBlock
    ! Re-parse so SecStart reflects any line shifts from the flush rebuild.
    gosub to ParseSource
    put 0 into BlocksMode
    ! Back in flat mode the toggle button re-enters Blocks mode.
    set the content of BlocksBtn to `Blocks`
    set attribute `title` of BlocksBtn to `Show this script as blocks, one block at a time`
    set style `display` of BlocksArea to `none`
    set style `display` of EditorArea to `block`
    ! Scroll the flat editor so the start of the block just viewed is visible.
    if SecCount is greater than 0
    begin
        ! Guard against a stale CurBlock (e.g. tab switched while in Blocks mode).
        if CurBlock is not less than SecCount
        begin
            put SecCount into Tmp
            take 1 from Tmp
            put Tmp into CurBlock
        end
        index SecStart to CurBlock
        put SecStart into Tmp
        take 1 from Tmp
        codemirror scroll to line Tmp in ContentEditor
    end
    gosub to TabRemember ! §2
    return

NextBlock:
    put SecCount into Tmp
    take 2 from Tmp
    if CurBlock is greater than Tmp stop
    gosub to FlushBlock
    add 1 to CurBlock
    gosub to RenderBlock
    stop

PrevBlock:
    if CurBlock is less than 1 stop
    gosub to FlushBlock
    take 1 from CurBlock
    gosub to RenderBlock
    stop

RenderBlock:
    index SecProse to CurBlock
    set the content of BlocksDocPane to SecProse
    index SecCode to CurBlock
    set the content of BlocksCodePane to SecCode
    gosub to UpdateBadge
    gosub to RenderToc
    return

UpdateBadge:
    put CurBlock into I
    add 1 to I
    set the content of BlocksTitle to `Block ` cat I cat ` of ` cat SecCount
    index SecVerifyState to CurBlock
    put SecVerifyState into VerifyState
    index SecHashState to CurBlock
    put SecHashState into HashState
    if VerifyState is `verified-fresh`
    begin
        set the content of BlocksBadge to `verified · fresh`
        set style `background` of BlocksBadge to `#2e7d32`
    end
    else if VerifyState is `verified-stale`
    begin
        set the content of BlocksBadge to `verified · stale`
        set style `background` of BlocksBadge to `#f9a825`
    end
    else if HashState is `no-code`
    begin
        set the content of BlocksBadge to `no code`
        set style `background` of BlocksBadge to `#666`
    end
    else
    begin
        set the content of BlocksBadge to `unverified`
        set style `background` of BlocksBadge to `#666`
    end
    return
!! @hash a8e720ab
!! @verified a8e720ab
!!!
!! Blocks save.
!! FlushBlock pushes the current pane edits back into the
!! per-section arrays (recomputing the section's hash if its code changed)
!! and rebuilds the full source by walking Outside + Section + Outside +
!! ... etc. The new source is written to ContentEditor (CodeMirror), which
!! the existing AutoSave loop persists to disk on its next iteration.
!! No-op if neither pane changed.
!!
FlushBlock:
    if BlocksMode is 0 return
    put the text of BlocksDocPane into NewProse
    put the text of BlocksCodePane into NewCode
    index SecProse to CurBlock
    put SecProse into OldProse
    index SecCode to CurBlock
    put SecCode into OldCode
    if NewProse is OldProse and NewCode is OldCode return
    index SecProse to CurBlock
    put NewProse into SecProse
    index SecCode to CurBlock
    put NewCode into SecCode
    ! Recompute hash and states for the edited block.
    put NewCode into SecCodeTmp
    put NewProse into SecProseTmp
    put 0 into SecHasCode
    if NewCode is not empty put 1 into SecHasCode
    index SecVerified to CurBlock
    put SecVerified into SecVerifiedTmp
    index SecHash to CurBlock
    put SecHash into SecHashTmp
    if SecHasCode is 0 gosub to ScoreNoCode
    else gosub to ScoreWithCode
    index SecHash to CurBlock
    put CurHash into SecHash
    index SecHashState to CurBlock
    put HashState into SecHashState
    index SecVerifyState to CurBlock
    put VerifyState into SecVerifyState
    gosub to RebuildSource
    codemirror set content of ContentEditor to Source
    gosub to UpdateBadge
    set the content of StatusSpan to `Block flushed`
    fork to ClearStatus
    return

RebuildSource:
    index Outside to 0
    put Outside into Source
    put 0 into I
    while I is less than SecCount
    begin
        gosub to BuildSectionText
        put Source cat BlkText into Source
        add 1 to I
        index Outside to I
        put Source cat newline cat Outside into Source
    end
    return

BuildSectionText:
    ! Reads I; writes BlkText with section I's reassembled lines.
    put `` into BlkText
    index SecProse to I
    put SecProse into Tmp
    if Tmp is not empty
    begin
        put Tmp into ProseSrc
        split ProseSrc
        put the elements of ProseSrc into PCount
        put 0 into PJ
        while PJ is less than PCount
        begin
            index ProseSrc to PJ
            put ProseSrc into PL
            if PL is empty put BlkText cat `!!` cat newline into BlkText
            else put BlkText cat `!! ` cat PL cat newline into BlkText
            add 1 to PJ
        end
    end
    index SecCode to I
    put SecCode into Tmp
    if Tmp is not empty put BlkText cat Tmp cat newline into BlkText
    index SecHash to I
    put SecHash into Tmp
    if Tmp is not empty put BlkText cat `!! @hash ` cat Tmp cat newline into BlkText
    index SecVerified to I
    put SecVerified into Tmp
    if Tmp is not empty put BlkText cat `!! @verified ` cat Tmp cat newline into BlkText
    put BlkText cat `!!!` into BlkText
    return
!! @hash d3dbcc0b
!! @verified d3dbcc0b
!!!
!! Mark verified — writes the current code's hash into the section's
!! "@verified" slot, then flushes so the file picks it up. The badge turns
!! green on the next render.
!! MarkAllVerified does the same for every code-bearing section in one pass.
!! It is a bulk, self-attestation action, so it asks for confirmation first —
!! a single misclick would otherwise wipe the file's granular verification record.
MarkVerified:
    if BlocksMode is 0 stop
    gosub to FlushBlock      ! ensure SecHash reflects current code first
    index SecHash to CurBlock
    put SecHash into SecHashTmp
    if SecHashTmp is empty stop    ! no-code section, nothing to verify
    index SecVerified to CurBlock
    put SecHashTmp into SecVerified
    put `verified-fresh` into Tmp
    index SecVerifyState to CurBlock
    put Tmp into SecVerifyState
    gosub to RebuildSource
    codemirror set content of ContentEditor to Source
    gosub to UpdateBadge
    set the content of StatusSpan to `Marked verified`
    fork to ClearStatus
    stop

MarkAllVerified:
    if BlocksMode is 0 stop
    gosub to FlushBlock      ! ensure the current block's hash is current too
    ! Count the code-bearing sections; only those can carry a @verified mark.
    put 0 into N
    put 0 into I
    while I is less than SecCount
    begin
        index SecHash to I
        if SecHash is not empty add 1 to N
        add 1 to I
    end
    if N is 0 stop
    if N is 1 put `Mark 1 block as verified?` into Tmp
    else put `Mark all ` cat N cat ` blocks as verified?` into Tmp
    if confirm Tmp
    begin
        put 0 into I
        while I is less than SecCount
        begin
            index SecHash to I
            if SecHash is not empty
            begin
                index SecVerified to I
                put SecHash into SecVerified
                index SecVerifyState to I
                put `verified-fresh` into SecVerifyState
            end
            add 1 to I
        end
        gosub to RebuildSource
        codemirror set content of ContentEditor to Source
        gosub to RenderBlock
        if N is 1 put `Marked 1 block verified` into Tmp
        else put `Marked ` cat N cat ` blocks verified` into Tmp
        set the content of StatusSpan to Tmp
        fork to ClearStatus
    end
    stop
!! @hash b0f5bf9f
!! @verified b0f5bf9f
!!!
!! Take the line out of `anchor | reachable=no | kind=label | line=NN | ...`, so a block
!! can be told whether it is one nothing enters. The anchor record is the documented shape, which is why its line can be read positionally — a finding's line lives in prose and cannot.
NoteMarker:
    put the position of `line=` in MarkRecord into Pos
    add 5 to Pos
    put from Pos of MarkRecord into MarkRest
    put the position of ` ` in MarkRest into MarkSpace
    if MarkSpace is less than 0 put MarkRest into MarkDigits
    else put left MarkSpace of MarkRest into MarkDigits
    ! The line number is read out of a record, so it arrives as text. Comparing text with the
    ! numeric block bounds does not coerce here, so the whole range test silently fails — the
    ! same reason `add 0 to` is used for numbers read from strings elsewhere in this codebase.
    add 0 to MarkDigits
    ! Grow the array first, then write the new last element: sizing to the current count and
    ! indexing it would ask for element 0 of an empty list on the first flag. This is the same
    ! order the editor's own CloseSection uses, for the same reason.
    put FlagCount into I
    add 1 to FlagCount
    set the elements of FlagLine to FlagCount
    index FlagLine to I
    put MarkDigits into FlagLine
    return
!! @hash e3dfc5f8
!! @verified e3dfc5f8
!!!
!! Say, in the status line, why the analysis could not run. The plugin reports a script it could not compile as a `problem` record, and without this the result is indistinguishable from a file with nothing wrong in it.
NoteProblem:
    put the position of `| does not compile` in MarkRecord into Pos
    if Pos is less than 0 put MarkRecord into MarkRest
    else
    begin
        add 13 to Pos
        put from Pos of MarkRecord into MarkRest
    end
    set the content of StatusSpan to MarkRest
    return
!! @hash 09c88156
!! @verified 09c88156
!!!
!! Decide whether one block's line range holds a flagged line. The bounds are widened by one so that both tests can be positive: `is not less than` is a form the editor avoids elsewhere.
BlockFlagged:
    put 0 into Found
    put From into FromCheck
    subtract 1 from FromCheck
    put To into ToCheck
    add 1 to ToCheck
    put 0 into K
    while K is less than FlagCount
    begin
        index FlagLine to K
        put FlagLine into MarkLine
        if MarkLine is greater than FromCheck and MarkLine is less than ToCheck put 1 into Found
        add 1 to K
    end
    return
!! @hash b832c0aa
!! @verified b832c0aa
!!!
!! Blocks TOC. Renders one row per parsed section in the BlocksToc
!! sidebar, highlighting the current block. Each row's label is the
!! first prose line of its section, truncated. Clicking a row flushes
!! any pending edit and jumps to that block.
!! Rows are shaded dark by verification state — green = verified, amber = stale, grey = unverified — so the blue current row stands out at a glance.
RenderToc:
    set the content of BlocksToc to ``
    set the elements of TocRow to SecCount
    set the elements of TocLabel to SecCount
    put 0 into J
    while J is less than SecCount
    begin
        index TocRow to J
        create TocRow in BlocksToc
        ! Colour and tooltip are decided together, so a row can never carry a colour without
        ! saying what it means. The tooltips are the legend: a reviewer should be able to read
        ! every state off the sidebar without being told them anywhere else.
        put `padding:4px 10px;cursor:pointer` into Tmp
        put `Not yet verified` into Tip
        if J is CurBlock
        begin
            put Tmp cat `;background:#1e88e5;color:white` into Tmp
            put `You are reading this block` into Tip
        end
        else
        begin
            index SecVerifyState to J
            put SecVerifyState into VerifyState
            if VerifyState is `verified-fresh`
            begin
                put Tmp cat `;background:#1b5e20` into Tmp
                put `Verified: the prose and the code still agree` into Tip
            end
            else if VerifyState is `verified-stale`
            begin
                put Tmp cat `;background:#a26d18` into Tmp
                put `Verified once, but the code has changed since — worth a look` into Tip
            end
            else put Tmp cat `;background:#3f3f3f` into Tmp
        end
        set the style of TocRow to Tmp
        set attribute `title` of TocRow to Tip
        index SecProse to J
        put SecProse into ProseSrc
        put the position of newline in ProseSrc into NL
        if NL is less than 0 put ProseSrc into FirstLine
        else put left NL of ProseSrc into FirstLine
        put J into Tmp
        add 1 to Tmp
        put Tmp cat `. ` cat FirstLine into FirstLine

        ! Does anything enter this block? The row's own colour already carries the
        ! verification state, so the flag goes on the label and the two signals stay on
        ! separate channels.
        index SecStart to J
        put SecStart into From
        put J into BlockAfter
        add 1 to BlockAfter
        if BlockAfter is less than SecCount
        begin
            index SecStart to BlockAfter
            put SecStart into To
            subtract 1 from To
        end
        else put 1000000 into To
        gosub to BlockFlagged


        index TocLabel to J
        create TocLabel in TocRow
        set the content of TocLabel to FirstLine
        ! A block nothing enters gets a solid background rather than only a struck label: it is
        ! unmissable at a glance, and a reviewer should not have to read every row to find the one
        ! that is unreachable. The trade is that such a row shows this instead of its verification
        ! colour, which is the right way round — an orphaned block is the more urgent fact.
        if Found is 1
        begin
            set the style of TocRow to `background:#b71c1c;color:white`
            set attribute `title` of TocRow to `Orphaned: nothing enters this block, so none of its code can run`
        end
        if Found is 1 set the style of TocLabel to `text-decoration:line-through;opacity:0.55`
        on click TocLabel go to JumpToBlock
        add 1 to J
    end
    return

JumpToBlock:
    put the index of TocLabel into Tmp
    if Tmp is CurBlock stop
    gosub to FlushBlock
    put Tmp into CurBlock
    gosub to RenderBlock
    stop
!! @hash 56b2a0d3
!! @verified 56b2a0d3
!!!
!! Graph mode: a third view — the run drawn, not the script.
!!
!! Blocks mode reads the script's *shape*; this reads what a *run* did. Those are different questions asked of the same file, which is why it is a third pane rather than another setting on either existing one: a code review asks what the code is made of, and a run review asks where the flow went.
!!
!! **The recording is not made here.** It is a file beside the script — `<script>.viz.json`, which the runtime writes with `--trace=` — so a run captured on remote hardware arrives with the project however the project travels, and reviewing a script never has to execute it. This pane reads that file and draws it, nothing more.
!!
!! **The drawing and its sidebar are two modules, each loaded on demand.** They are half of this editor by size between them and none of it is needed until somebody looks at a run, so one is `viz-graph.allspeak` and the other `viz-side.allspeak`: each fetched, compiled and run on the first click on Graph, and messaged from then on. The split is by *what each is about* rather than by size alone — the pane is the picture and owns the gestures, the sidebar is the reading aid and owns its tabs — so either can grow without the other's file growing with it, and the two are given **different elements** to attach to, which is what keeps the layout out of both of them. Two consequences are worth knowing. This file names no `svg` vocabulary any more — that left with the pane, and the pane is what needs the plugin, which the page still loads because the pane is compiled when it is fetched. And `various/plotview.allspeak` is gone: the module file *is* the view, so there is one copy of the drawing rather than a section kept verbatim beside the harness's own copy of the same code. The harness cuts the view out of the module at its header, so what it tests is still what ships.
!!
!! **What crosses is a dict each way, and only when a run is opened.** This section fetches the recording and the script — it is the one that knows which tab is open — and sends the pane their text, the three localised flow words, and the path the recording was expected at. The sidebar is sent the same run, because a doc block is prose about a *line* and the click is what names the line. **And one thing comes back**: a click on a mark is reported here as the line it names, and this file looks that line up in the doc-block model it already holds and shows the result in the sidebar. The editor is the hub in both directions rather than the pane knowing that the sidebar exists, which is what keeps either of them replaceable. The wait, and the message about a recording that is not there, go on the status line, which the pane attached for itself. The gestures never cross at all, and leaving is one more message each, because a module cannot see that it has been taken off the screen.
!!
!! **The plumbing is one sentence.** Markers decide what is recorded, and a script without them has nothing to show; rather than explain that in the pane, the message names the file it looked for, because that is the one thing a reader needs in order to produce one.
!!
!! **Leaving is automatic when a tab changes.** A mode owns the screen, so opening or switching to a file drops back to the flat editor rather than loading the new script into a pane nobody can see — which is what happened the first time this pane was used, and what Blocks has always done. The rule lives in `ActivateTab`, so every path that shows a file obeys it.
!!
!! Appendix
!!
!! §1 Back to the flat editor exactly where it was left — the caret *and* the view, which is what the pane remembering its own state now means for this side too. It is the same pair a tab switch restores, through the same two subroutines, so there is one answer to "where was I" rather than one per way of leaving.
!!
!! §2 This is the only path out of Graph mode that restores: the other is a tab change, which is a different file and starts wherever its own record says.
!!
!! §3 **And it takes the first place in the bar, which is where `Edit` belongs.** The button that goes back to the plain editor is the leftmost of the five, whichever pane it is leaving — so in Blocks mode nothing moves (Blocks is already first) and here the group shifts up by one to make room. **The numbers are the ones `viz.json` states**, whose `order` on these five *is* the bar's sequence; the earlier four children of the bar take the default `0` and hold their DOM order ahead of these. Graham, 2026-10-12: *"the sequence is always Edit - Blocks - Launch - Record - Graph - Find, including when 1 or more is missing."* A hidden button is `display: none`, so it takes no place and the rest keep this order — which is what makes a missing `Launch` or a missing pane not shuffle anything.
!!
!! §4 **The section model is built for this file before the sidebar can be asked about a line.** This file parses its own buffer in Blocks mode and only there, so a reader who opens a run without ever having opened Blocks would otherwise have no sections at all — or worse, the ones left behind by the last file that *was* blocked. It is done here, before the fetch, because the fetch is what puts the pane on screen: after it there is a window in which a mark could be clicked against a stale model.
!!
!! §5 The two files the run is made of, read and defaulted before either is fetched.
!!
!! §6 **Both reads point their failure clause at the send, and that is what makes this work.** `rest get` compiles its failure clause — `or` and `on failure` alike — as a clause that ends the thread, so a clause that merely set a default would leave the pane waiting for a message that never came: the recording is optional, but the *send* is not. Defaulting both to empty first and jumping to the send on failure means the pane is told either way, and an empty recording is what makes it name the file it looked for.
!!
!! §7 The recording is read first because a recording that will not answer is the failure worth naming; the script is the picture's background, and it is a different file.
!!
!! §8 Both modules: each fetched, compiled and run once, and messaged from then on.
!!
!! §9 **`run` compiles the *text*, not a path**, which is why the fetch comes first — and it is a fetch of a file beside this page, so a project that has the editor has both as well. `release parent` inside each module is what makes its `run` return: by the time it does, that module is attached, its handlers are registered and it is listening.
!!
!! §10 **This directory first, the served copy second, and that order is the page's.** The editor is a file a project can be *given* — a pack used to carry one — and a copy of a thing that moves is a copy that goes stale: a project could run an old editor beside a current runtime and plugin, and only found out when the editor refused to compile its own source. A pack carries none now, so this falls through to the released one and cannot be stale; a working tree carries its own, and an edit to the pane is visible in it.
!!
!! §11 **The sidebar is not the pane, so it is loaded leniently.** Without it the picture still works — it is a reading aid beside a drawing — so a page that has one file and not the other says so on the status line and carries on, rather than dropping out of Graph mode over the half of the pane that is optional. The pane is the opposite case: with no pane there is nothing to look at, so a page without it leaves the mode entirely.
!!
!! §12 The default-then-read is `FetchRunText`'s pattern and for its reason: a failure clause ends the thread, so it has to point at the continuation rather than merely set a value. An empty source must not reach `run`, which would try to compile nothing.
!!
!! §13 **The panel rather than the status line, and that is the fix this path always needed.** A module that will not load is a fault in the page rather than news about the work, and the reader needs it to still be there when they look up from the pointer — which is exactly what went wrong the first time this path was hit: the sidebar was not beside the editor, the line flashed and went, and the only symptom was that nothing happened when a mark was clicked. The status line could not hold it (everything there is cleared after three seconds); the panel stays until it is closed.
!!
!! §14 The run, as one dict — the whole of the interface in this direction. Built here rather than filled in place because the pane reads its fields by name, so a field added on one side is visible on the other.
!!
!! §15 **The `GraphMode` guard is not belt and braces.** Both fetches above hand control back to the event loop, so the reader can leave the pane — or switch to another file — while this is still waiting for the recording. Sending `open` then would leave the pane answering a pointer it no longer has, with the editor in flat mode and nothing left to send it the close.
!!
!! §16 Turn off every mode there is. The panes are alternatives, not layers, so each one's entry point has to turn the others off before turning itself on — and the list of "the others" belongs in one place, or the next pane added is missed by whichever entrant was written before it existed. That is exactly what happened to `EnterBlocks` and the Graph pane, and it showed as the Graph button still reading `Edit` (two buttons offering to leave a pane neither of which was on) with the graph left lying under the Blocks pane.
!!
!! §17 Called by `EnterBlocks`, `EnterGraph` and `ActivateTab`. A fourth pane means changing this and nothing else.
ToggleGraph:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    if GraphMode is 0 go to EnterGraph
    gosub to DoExitGraph
    gosub to TabRestore ! §1–§2
    stop

!   Entering shows the pane and hands this tab's run to it. Loading the pane first, because the
!   first visit is the one that fetches and compiles it — the editor is already showing an empty
!   pane by then, so the wait is visible as a pane rather than as a dead button.
!   Leaving Blocks mode first is deliberate: the panes are alternatives, not layers.
EnterGraph:
    gosub to DoExitPanes
    put 1 into GraphMode
    set the content of GraphBtn to `Edit`
    set attribute `title` of GraphBtn to `Back to the plain editor`
    set style `order` of GraphBtn to `4` ! §3
    set style `order` of BlocksBtn to `5`
    set style `order` of LaunchBtn to `6`
    set style `order` of RecordBtn to `7`
    set style `display` of EditorArea to `none`
    set style `display` of BlocksArea to `none`
    set style `display` of GraphArea to `flex`
    ! The sidebar's width, from the last session that had one. Restored here, before the pane is fetched,
    ! so the drawing is fitted to the box it will actually be drawn in — a re-fit a moment later would
    ! move the picture under the reader's eye for no reason it could see.
    get SideStored from storage as `viz-graph-side-width`
    if SideStored is `null` put 0 into SideStored
    if SideStored is `undefined` put 0 into SideStored
    if SideStored is empty put 0 into SideStored
    if SideStored is greater than 200 set style `flex` of GraphSide to `0 0 ` cat SideStored cat `px`
    ! Where the flat editor was standing, so leaving puts it back there. Read before the editor is
    ! hidden: a hidden editor still answers, but reading it while it is up is the honest order.
    gosub to TabRemember
    gosub to LoadModules
    gosub to ParseSource ! §4
    gosub to FetchRunText
    gosub to SendRunToViz
    gosub to SendRunToSide
    stop

FetchRunText: ! §5–§7
    put `` into TraceText
    put `` into SourceText
    index TabPath to ActiveTab
    put TabPath cat `.viz.json` into TracePath
    ! **Either read may come up empty, and neither absence may hide the other.** `or go …` on a `rest get`
    ! leaves the rest of the section behind (the trap in AGENTS.md), and with the *recording* read first a
    ! script with no `.viz.json` beside it was sent to the pane with no script either — so the pane drew
    ! nothing at all, where what it is for is the script plain: the frame, the text, no arrivals, which is
    ! what the panel's "no recording beside this script" is about. The first fault Graham saw on 2026-10-13
    ! was downstream of that (the clip filter's read, `viz-graph.allspeak` §30). `on failure` is the clause
    ! that continues, so each read stands on its own and the pane gets whichever of the two is there.
    rest get TraceText from `/read/` cat TracePath on failure put `` into TraceText
    rest get SourceText from `/read/` cat TabPath on failure put `` into SourceText
VizSendTheRun:
    return

LoadModules: ! §8–§9
    if VizLoaded is 0 gosub to LoadVizModule
    if SideLoaded is 0 gosub to LoadSideModule
    ! **The notice is fetched in its own thread, because nothing waits for it.** The pane and the sidebar are
    ! needed for the picture and the reading, so the run is not fetched until they are ready; the notice is a
    ! message about a wait, and holding the first drawing back for it would cost the reader the very thing the
    ! message explains. Fetched beside them, the only cost is that a drawing which begins before it has loaded
    ! goes unannounced — which the relay logs rather than disguising.
    if AlertLoaded is 0 fork to LoadAlertModule
    return

!   **The third module, and it is loaded last because it is the least load-bearing of the three.** The pane
!   is the picture and the mode depends on it; the sidebar is a reading aid and the mode survives without
!   it; the notice is a message about a wait, and without it the picture draws exactly as it did — so its
!   failure is said on the status line and nothing changes mode. It reuses the editor's own panel
!   (`se-alert`), so no new page element is declared for it: the page hands it the source and the module
!   attaches by id, the same way the pane and the sidebar do.
LoadAlertModule:
    put `` into AlertSrc
    attach AlertSrcDiv to `editor-alert` or go AlertModuleLocal
    put the text of AlertSrcDiv into AlertSrc
    if AlertSrc is not empty go to AlertModuleHere
AlertModuleLocal:
    rest get AlertSrc from `viz-alert.allspeak?v=` cat now or go AlertModuleHosted
    if AlertSrc starts with `<` put `` into AlertSrc
    if AlertSrc is empty go to AlertModuleHosted
AlertModuleHere:
    if AlertSrc is empty go to AlertLoadFailed
    run AlertSrc as AlertModule
    put 1 into AlertLoaded
    stop

AlertModuleHosted:
    rest get AlertSrc from `https://allspeak.ai/dist/viz-alert.allspeak?v=` cat now or go AlertLoadFailed
    if AlertSrc starts with `<` go to AlertLoadFailed
    go to AlertModuleHere

AlertLoadFailed:
    ! **The status line, not the panel, and it is the one module whose failure is not worth a panel.** The
    ! panel is what failed to arrive, and a reader whose drawings will go unannounced needs to know it once
    ! rather than be stopped by it — the picture, the sidebar and every gesture are unaffected.
    set the content of StatusSpan to `The drawing notice could not be loaded; the picture is unaffected`
    log `alert: could not fetch ` cat `viz-alert.allspeak` cat ` — is it beside the editor?`
    fork to ClearStatus
    stop

LoadVizModule:
    put `` into VizSrc ! §10
    ! **The page's element first, then this directory.** A project cannot *fetch* the pane from the site — the
    ! site answers `access-control-allow-origin: *` for `.js` and `.css` but not for `.allspeak` — so the page
    ! hands it over in an element instead, the same channel the language comes through. A working tree has no
    ! such element and reads the pane beside it, which is what makes an edit to the pane visible there.
    attach VizSrcDiv to `editor-graph` or go VizModuleLocal
    put the text of VizSrcDiv into VizSrc
    if VizSrc is not empty go to VizModuleHere
VizModuleLocal:
    rest get VizSrc from `viz-graph.allspeak?v=` cat now or go VizModuleHosted
    ! **A `<` means the server sent a page, not a module.** A dev server that answers an unknown path with its
    ! own page does it with `200` and a type guessed from the extension, so the body is the only thing that
    ! says whether the file arrived — and a page is treated as a miss, so the next place gets its turn. Without
    ! this, a mis-serving server takes the editor down with one syntax error per asset and names no cause.
    if VizSrc starts with `<` put `` into VizSrc
    if VizSrc is empty go to VizModuleHosted
VizModuleHere:
    if VizSrc is empty go to VizLoadFailed
    run VizSrc as VizModule
    put 1 into VizLoaded
    return

VizModuleHosted:
    rest get VizSrc from `https://allspeak.ai/dist/viz-graph.allspeak?v=` cat now or go VizLoadFailed
    if VizSrc starts with `<` go to VizLoadFailed
    go to VizModuleHere

LoadSideModule: ! §11–§12
    ! The same two places as the pane, for the same reason and in the same order.
    put `` into SideSrc
    attach SideSrcDiv to `editor-side` or go SideModuleLocal
    put the text of SideSrcDiv into SideSrc
    if SideSrc is not empty go to SideModuleHere
SideModuleLocal:
    rest get SideSrc from `viz-side.allspeak?v=` cat now or go SideModuleHosted
    if SideSrc starts with `<` put `` into SideSrc
    if SideSrc is empty go to SideModuleHosted
SideModuleHere:
    if SideSrc is empty go to SideLoadFailed
    run SideSrc as SideModule
    put 1 into SideLoaded
    return

SideModuleHosted:
    rest get SideSrc from `https://allspeak.ai/dist/viz-side.allspeak?v=` cat now or go SideLoadFailed
    if SideSrc starts with `<` go to SideLoadFailed
    go to SideModuleHere

SideLoadFailed:
    put `The Graph sidebar could not be loaded. Without it the picture still works — the sidebar is a reading aid beside the drawing. Rebuild the editor payload with ./build-allspeak, or start the dev server from the repository root.` into AlertMsg ! §13
    log `sidebar: could not fetch ` cat `viz-side.allspeak` cat ` — is it beside the editor?`
    gosub to ShowAlert
    return

!   A page served without the pane beside it, which is the one way this can fail. Said in the panel and
!   rectified in the same breath: the editor goes back to the flat view rather than leaving a pane up
!   that nothing will ever draw in.
VizLoadFailed:
    put `The Graph pane could not be loaded, so the editor has gone back to the plain view. Rebuild the editor payload with ./build-allspeak, or start the dev server from the repository root.` into AlertMsg
    gosub to DoExitGraph
    gosub to ShowAlert
    stop

SendRunToViz: ! §14–§15
    if GraphMode is 0 return
    put `{}` into VizRun
    set property `open` of VizRun to 1
    set property `trace` of VizRun to TraceText
    set property `source` of VizRun to SourceText
    set property `path` of VizRun to TracePath
    set property `call` of VizRun to StrFlowCall
    set property `jump` of VizRun to StrFlowJump
    set property `return` of VizRun to StrFlowReturn
    send VizRun to VizModule
    return

!   Leaving puts the flat editor back and relabels the button, so the pane's state is legible from
!   the button alone. The pane is told it is off screen — the only thing about it this side can know
!   and it cannot — because its gestures are registered on the pane *and* on the document, and a drag
!   anywhere in the editor would otherwise be offered to a picture nobody is looking at.
DoExitGraph:
    put 0 into GraphMode
    ! The grip's flag goes with the mode. It is cleared on every drop, so this is only belt and braces —
    ! but a press that ended outside the window leaves it set, and the next drag in the flat editor would
    ! otherwise be offered to a splitter nobody can see.
    put 0 into GripPicked
    ! **And so does the freeze**, on both sides of it: the pane clears its own copy as it stands down (it
    ! is told `open` 0), and this one goes with the mode for the reason the grip's does — a pane nobody is
    ! looking at cannot be holding the pointer still, and a menu that read `Cancel` over an unfrozen pane
    ! would be offering to cancel something that is not happening.
    put 0 into MenuFrozen
    set the content of GraphBtn to `Graph`
    set attribute `title` of GraphBtn to `Show the run this script recorded, as a picture`
    ! Back to the sequence `viz.json` states — `EnterGraph` has the reasoning for these four numbers.
    set style `order` of BlocksBtn to `4`
    set style `order` of LaunchBtn to `5`
    set style `order` of RecordBtn to `6`
    set style `order` of GraphBtn to `7`
    set style `display` of GraphArea to `none`
    set style `display` of EditorArea to `block`
    if VizLoaded is 1 gosub to TellVizClosed
    if SideLoaded is 1 gosub to TellSideClosed
    if AlertLoaded is 1 gosub to TellAlertClosed
    return

TellVizClosed:
    put `{}` into VizRun
    set property `open` of VizRun to 0
    send VizRun to VizModule
    return

DoExitPanes: ! §16–§17
    if BlocksMode is 1 gosub to DoExitBlocks
    if GraphMode is 1 gosub to DoExitGraph
    return
!! @hash 2f912fca
!! @verified 7a22679f
!!!
!! The front door for what arrives from the pane, which is the pane's two reports and the freeze's.
!!
!! **The pane reports a line as the pointer moves and a mark when it is pressed, and it reports the freeze lifting.** All arrive at this file because all are about things this file owns the answers to: which block holds a line is the model Blocks mode is built from, and the word on the menu's last row is the menu's. The message's own `kind` is what tells them apart, so a field can be added to either without the other being read wrongly — the same rule the sidebar's boundary uses for its three.
!!
!! **The freeze's report is the pane correcting this file, and it is the only way that state can be right.** The editor sets the freeze when the row is pressed and cannot see a pointer, while the pane lifts it by itself the moment the pointer comes back over the picture; so the pane says so, and this is where that lands. Nothing else happens on it: the pause it was holding is over and the sidebar is left showing what it was showing.
VizInbound:
    put the message into SideIn
    put property `kind` of SideIn into SideInKind
    if SideInKind is `freeze` go to VizFreezeReport
    if SideInKind is `alert` go to VizAlertRelay
    go to SideMarkLine

!   **The relay, and it exists because a module can only `send` to its parent.** The pane is the one that
!   measures a drawing, and the panel is a third program it does not declare — so the pane says what it
!   knows to this file, and this file hands the same dict on unchanged. Nothing is read here: the message
!   is the panel's vocabulary, not this file's, which is what keeps the panel replaceable.
VizAlertRelay:
    if AlertLoaded is 0
    begin
        log `alert: the notice is not loaded, so ` cat property `what` of SideIn cat ` has nowhere to go`
        stop
    end
    send SideIn to AlertModule
    stop

VizFreezeReport:
    put property `frozen` of SideIn into MenuFrozen
    stop
!! @hash 6f5006c8
!! @verified bab238ee
!!!
!! The sidebar: what the pane reports back, and what the sidebar is shown.
!!
!! **The pane cannot look a line up, and this file already can.** A doc block is prose about a *line*; the click names the line; and the model that knows which block holds it is the one Blocks mode is built from. So the click travels here rather than the model travelling there — which is also why the editor, and not the pane, knows that a sidebar exists at all.
!!
!! **This is the body of the inbound line report, entered from `VizInbound` above.** Everything else here is driven by the reader clicking one of the editor's own buttons; this is the one path that arrives from another program, and it arrives on the pane's pick — or, for the other kind, on the pane's freeze lifting. **The registration itself is not here** — a handler runs only if its line is executed, this file stops before this block, and the registration is in its own block above, where the flow reaches it.
!!
!! **The line is looked up rather than the block searched for.** `SecStart` and `SecEnd` already bound every section, so "which block holds line N" is a walk over them. A line in *no* block is an answer too, and the sidebar is told so rather than being left showing the last block it had. **And the model is built on the way in**, by the same `ParseSource` Blocks mode uses, because it used to be built *only* there: a reader who opened a run without ever opening Blocks had no sections at all — or, worse, the ones left behind by the last file that was blocked, which is the kind of stale answer that reads as a working panel.
!!
!! Appendix
!!
!! §1 **The report arrives as a dict, so its line is read as a property and never converted.** Two things are being avoided here, and both were live faults in the first cut: `put the message into SideSel` leaves a dict in a variable the look-up does arithmetic on, and `add 0 to` it throws rather than coercing; and the other tempting spelling, `the value of the message`, is `parseInt` of its argument — which on a dict is *0 for every click*, so the panel faithfully reported that line 0 is in no doc block. The one honest spelling is the property, because the property is what the pane set.
!!
!! §2 A line lies in at most one block, so the walk stops at the first it finds. The bounds are the block's own two documented lines — its opener and its terminator — and the code the click landed on is between them, which is why both tests are inclusive.
!!
!! §3 The heading is the block's first prose line, numbered as the Blocks view numbers it, because that number is how a reader gets from the sidebar back to the same block in the other pane.
!!
!! §4 **And the walk really does stop at the match — `From` and `To` are written on *every* pass**, so a walk that ran to the end left them holding the *last* section in the model while `SideFound` and the heading held the one that matched. The `Code` tab slices on those two, so it showed every block's code as the last block's: found by Graham in the browser, 2026-10-12, *"the code displayed is always that of the final doc-blocked item in the script"*, with the heading correct — and the check could not see it because its fixture's matching block was also its last. The two bounds are the *matched* block's, which is what the first line of this comment always said the walk did.
!!
!! §5 **And a line no block holds still has a pair of bounds, which is what the `Code` tab needs.** The walk carries the *gap* around the pointer as it goes: the line after the block before the pointer, and the line before the block after it. A file is blocks and the code between them, so a gap is a real run of code rather than an arbitrary window of lines — and a reader pointing between two blocks is handed those lines, which is Graham's rule for this panel (`TODO-viz.md`, "Settled decisions": a tab brings the reading to the reader). `SideFound` stays 0, so the doc-block tab keeps answering with its sentence — it is the same line, and the two tabs say different true things about it.
!!
!! §6 **And the two bounds the code tab slices on**, which `SideFindBlock` has just walked into `From` and `To`. **What they mean depends on `SideFound`**, and both readings are useful: the block's own documented lines when one holds the line, and the *gap's* first and last line when none does — the run of code between the block before the pointer and the block after it. The sidebar is told both and decides: a doc block's prose for the first, that run of code for the second, and the sentence for both when the doc-block tab is the one up.
SideMarkLine:
    if GraphMode is 0 stop
    put the message into SideIn ! §1
    put property `line` of SideIn into SideSel
    ! The mark's own figures, which are the pane's to count and this file's only to pass on. They are read
    ! here rather than in `SendBlockToSide` because they belong to the *click* and not to the block: a line
    ! in no doc block still has a visit number, and the status bar shows it either way.
    put property `visit` of SideIn into SideVisit
    put property `total` of SideIn into SideTotal
    ! Captured values, if the script asked for any. An absent property reads as nothing at all, so a press on
    ! a mark with no `@show` beside it leaves this empty and the sidebar prints only the line and the visit.
    put property `values` of SideIn into SideValues
    gosub to SideFindBlock
    ! **A press also moves the panel, and it is the one report that does.** A click on a mark means "tell me
    ! about this line", so the doc block is brought forward; a *hover* is the pointer travelling, and it
    ! leaves the tab wherever the reader put it. `SideInKind` is what tells the two apart, and the tab is
    ! sent *before* the block so that the block's own render is the last one and lands on the chosen tab.
    if SideInKind is `mark` gosub to SideTabDocs
    gosub to SendBlockToSide
    stop

!   The doc block, brought forward by a press. The same `tab` message the menu's own rows send, so a tab
!   reached two ways cannot be reached two ways that disagree.
SideTabDocs:
    if SideLoaded is 0 return
    put `{}` into SideMsg
    set property `kind` of SideMsg to `tab`
    set property `sel` of SideMsg to 0
    send SideMsg to SideModule
    return

SideFindBlock:
    put 0 into SideFound ! §2–§5
    put `` into SideTitle
    put `` into SideProse
    ! **The far end of a gap with no block after it.** A file runs out of lines rather than out of blocks,
    ! and the editor is not counting them here — the sidebar clamps a bound past its own script rather than
    ! reading past the end, which it already does for a message from another file.
    put 1 into SideGapFrom
    put 999999 into SideGapTo
    put 0 into SideI
    while SideI is less than SecCount
    begin
        index SecStart to SideI
        put SecStart into From
        index SecEnd to SideI
        put SecEnd into To
        if SideSel is not less than From and SideSel is not greater than To
        begin
            put 1 into SideFound
            index SecProse to SideI
            put SecProse into SideProse
            put the position of newline in SideProse into NL
            if NL is less than 0 put SideProse into SideTitle
            else put left NL of SideProse into SideTitle
            put SideI into Tmp
            add 1 to Tmp
            put Tmp cat `. ` cat SideTitle into SideTitle
            go to SideFindDone
        end
        ! This block does not hold the pointer, so the gap narrows on whichever side of it this block is.
        if To is less than SideSel put To into SideGapFrom
        if From is greater than SideSel and From is less than SideGapTo put From into SideGapTo
        add 1 to SideI
    end
    ! No block holds it, so the bounds handed on are the gap's own — one line inside the blocks at either end.
    add 1 to SideGapFrom giving From
    take 1 from SideGapTo giving To
SideFindDone:
    return

SendBlockToSide:
    if SideLoaded is 0
    begin
        log `sidebar: not loaded, so the block for line ` cat SideSel cat ` has nowhere to go`
        return
    end
    put `{}` into SideMsg
    set property `kind` of SideMsg to `block`
    set property `line` of SideMsg to SideSel
    set property `visit` of SideMsg to SideVisit
    set property `total` of SideMsg to SideTotal
    if SideValues is not empty set property `values` of SideMsg to SideValues
    set property `found` of SideMsg to SideFound
    set property `title` of SideMsg to SideTitle
    set property `prose` of SideMsg to SideProse
    set property `from` of SideMsg to From ! §6
    set property `to` of SideMsg to To
    send SideMsg to SideModule
    return

!   The run itself, sent beside the pane's own copy of it, because the sidebar is told about a run
!   whether or not a mark is ever clicked — and a new run has to clear whatever block the last one
!   was showing, which is why this carries nothing but the script's name.
SendRunToSide:
    if SideLoaded is 0 return
    put `{}` into SideMsg
    set property `kind` of SideMsg to `run`
    set property `open` of SideMsg to 1
    set property `path` of SideMsg to TracePath
    ! **The script itself, because the sidebar's second tab is the code.** It is the same text the pane
    ! was given rather than the tab's live buffer: the line numbers the sidebar is told come from the
    ! pane's own hit test, and those were measured against *this* text — a reader who has edited since
    ! would otherwise be shown a code line that is not the one their pointer named.
    set property `script` of SideMsg to SourceText
    send SideMsg to SideModule
    return

TellSideClosed:
    put `{}` into SideMsg
    set property `kind` of SideMsg to `run`
    set property `open` of SideMsg to 0
    send SideMsg to SideModule
    return

!   The panel goes away with the pane: a notice about a drawing nobody is looking at is a box over an
!   editor that has moved on. It is told rather than hidden by the pane itself, because the pane's last
!   word on the subject may be a cost sentence still on screen — and this is the only path that knows both
!   that the run is closed and that the panel is up.
TellAlertClosed:
    put `{}` into PanelMsg
    set property `what` of PanelMsg to `hide`
    send PanelMsg to AlertModule
    return
!! @hash 450ff009
!! @verified e4eac7b5
!!!
!! Recording a run, from the button.
!!
!! **This is the trigger, and the pane's empty state is its argument.** A pane that says *"no recording beside this script"* names a file and leaves the reader to produce one at a console; this makes it instead — the buffer is already here, and so is the plugin, which the page loads for the pane's sake.
!!
!! **The recording is written beside the script, not handed straight to the pane**, and that is the pane's own decision rather than a convenience: `<script>.viz.json` is a file, so a run captured here travels with the project and can be read again without running anything. It is written through the `/write/` route a tab already uses, so nothing needs a new channel.
!!
!! **A run that waits is recorded as far as its first wait, and says so.** `wait` hands the rest of the program to a timer, so a capture made inside a call cannot follow it; the flag the command answers with is what the status line reports, rather than a slice being passed off as a whole run. Following one through is a different shape — the caller being *told* when the run ends — and it is recorded in TODO.md.
!!
!! **And a script that names an app is opened rather than run.** `@app parser.html` means the script is driven by its own page, so running it here could only ever fail — its markers are reached by a *person* clicking, not by the script starting. Record opens that page, arms it from outside and saves the recording when the window closes; the block below that is the script path, unchanged. The two acts are one button because the script already says which is right.
!!
!! **The status line says what the recording *is*, not just that one was made.** A document holding nothing but its header is still a valid document, so a button reading only the trace reports a run that died on its first statement as a success — and the two ways a recording comes back empty are worth telling apart, because one is a script this runtime cannot compile and the other is a script that stopped. So the plugin answers with a sentence — `12 visits in 1 window`, or `could not run: I don't understand 'dictionary' at line 46` — and it is shown as it stands.
!!
!! **And a guard is armed, with the recorder's own defaults.** A script handed to the editor by a tool is not to be trusted with the editor's responsiveness: a busy loop and a never-returning wait both end here, and the recording says which.
!!
!! Appendix
!!
!! §1 **One button, two acts, and the script says which is right.** A script that names an app runs *as* an app — driven by its own page, clicked by a person — so it cannot be run here: the editor opens it instead and arms it from outside, and the recording is written when that window closes. Anything else is a script, and Record runs it here as it always has. The parse is what knows the difference, and it is the same parse the Blocks view uses, so `@app parser.html` means the same thing on both sides of the editor.
!!
!! §2 **The flavour is the plugin's answer, not a second reading of the same facts.** The `flavour |` record comes from the plugin's own resolution — the script's marker, then the project's `#editor-runtime`, then `js` — so the editor and the thing that actually records cannot disagree. This file used to read `#editor-runtime` itself and fall back to it when the tab said nothing: two implementations of one rule, and the reason the marker's case was invisible here is that the *attributes* it used to be read from do not exist on a script this runtime cannot compile. See `NoteFlavour`. **A script for the Python runtime is run by the project's server, and not here.** The editor is a page, so it has the JavaScript runtime and nothing else — which is why Record refused a `@py` script before this. The dev server has Python: `/record/<script>` runs it exactly as `allspeak <script>` would, puts what it printed in `<script>-stdout.txt` beside it (a script's output is unpredictable and would drown the console the server is also writing to) and the recording in `<script>.viz.json`, which is the file the pane already looks for. The server composes the sentence, so the file's name and the verdict are named once.
!!
!! §3 **Short, true, and out of the way in three seconds — which is right for a tick and wrong for a fault.** The *success* message names no path: the pane does, when it reads the recording, and the toolbar is not the place for a filename. It used to say "Recording ... — close its window and the recording is saved to ...", which was both a promise the editor cannot keep (it printed whether or not a window opened) and the longest thing in the toolbar — Graham's two objections, in one line.
!!
!! §4 **Every failure goes to the panel, and every success stays on the strip.** A verdict is the one message here a reader has to *act* on — it names the symbol, the line and the fix — and the strip holds it for three seconds and takes it away whether or not anybody read it, which is the argument this file already makes for the module-load failures below. So all four ways a record can fail — a buffer with no path to record beside, a server that does not answer, a script this runtime cannot run, and a recording the server will not take — write `AlertMsg` and reach `ShowAlert`, and so stay until the Close button puts them away. **Graham asked for it on 2026-10-14**, having watched the compiler's message go by in a demo clip: *"The compiler error message doesn't immediately catch the eye."*
RecordRun:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    if TabCount is 0 stop
    index TabPath to ActiveTab
    put TabPath into EditorPath
    ! A buffer that has never been saved has nowhere to put a recording, and the pane's message names the file it
    ! would look for — so say the same thing here rather than record beside a name that is not there.
    if EditorPath is empty
    begin
        put `Save this script first: a recording goes beside it` into AlertMsg ! §4
        gosub to ShowAlert ! §4
        stop
    end
    codemirror get content of ContentEditor into RecordSource
    put EditorPath cat `.viz.json` into TracePath
    gosub to ParseSource ! §1
    if TabFlavour is `py` ! §2
    begin
        rest get RecordReply from `/record/` cat EditorPath or begin
            put `Could not run ` cat EditorPath cat ` — the server did not answer` into AlertMsg ! §4
            gosub to ShowAlert ! §4
            stop
        end
        set the content of StatusSpan to RecordReply
        fork to ClearStatus
        stop
    end
    if AppPage is not empty
    begin
        record the app at AppPage to TracePath
        set the content of StatusSpan to StrRecording ! §3
        fork to ClearStatus
        stop
        stop
    end
    record the script in EditorPath as RecordSource giving RecordTrace reporting RecordVerdict
    ! An empty trace is how a run that never got started comes back — a script this runtime cannot compile, most
    ! often — and the verdict is the reason, in the runtime's own words. It names the word and the line, which is
    ! what tells a reader that this is not the runtime the script was written for.
    if RecordTrace is empty
    begin
        put `Could not record this script — ` cat RecordVerdict into AlertMsg ! §4
        gosub to ShowAlert ! §4
        stop
    end
    rest post RecordTrace to `/write/` cat TracePath or go RecordFailed
    set the content of StatusSpan to `Recorded ` cat TracePath cat ` — ` cat RecordVerdict
    fork to ClearStatus
    ! The pane, if it is up, is drawing whatever recording was there before this one.
    if GraphMode is 1 gosub to SendRunToViz
    stop

RecordFailed:
    put `Could not record this script — the server would not take the recording` into AlertMsg ! §4
    gosub to ShowAlert ! §4
    stop
!! @hash 76452458
!! @verified df567fa6
!!!
!! Opening the project's app, from the editor.
!!
!! **The app is a page, and a page the editor can already reach: its own.** `@app parser.html` names it relative to where the editor is served from — the project root — so no path has to be assembled, no server route is added, and the page resolves against the editor's own location. It opens in a window of its own, which is the point: the app runs exactly as it does when you open it by hand, with its own layout, its own DOM and its own `rest get`s, unconstrained by the editor's.
!!
!! **Nothing about the app changes, and that is deliberate.** `parser.html` fetches its script and runs it; the editor does not run it, poke it, or wrap it. That is what keeps this half simple, and it is also what makes the *next* half — recording a launched app — a separate problem: the recorder has to be armed before the app's own `viz start` line runs, which means the app page carrying a bootstrap or the editor injecting one before its scripts run. Launching needs neither.
!!
!! **A script that names no app says so** rather than the button doing nothing, because "nothing happened" is the one report a reader cannot act on. The message names the spelling, says it goes on a line of its own, and says it is not a comment — the three things a reader needs and the three the first version got wrong: it pointed at a doc block, which is where the *analyser's* `@hash` and `@verified` live and where an attribute never reaches the compiler.
!!
!! Appendix
!!
!! §1 **The message says where, and that is the whole of its job.** It used to say "to a doc block", which is where an attribute must *not* go: a `@`-line inside a `!!` block is the analyser's metadata and never reaches the compiler, so a reader who followed that advice would have written something the program cannot see. Graham asked which it was, which is the message failing at the one moment it exists for. **The example is a real filename, not `<page>`, and that is not a style choice.** `set the content of` writes `innerHTML` (`Browser.js`), so a placeholder in angle brackets is parsed as an HTML tag and never rendered: the reader saw `add '@app ' on a line of its own` — the spelling this sentence exists to give them, gone. Measured 2026-10-05, from Graham's own status line, and the check below could not see it because the harness's stub stores the string it is given rather than parsing it.
LaunchApp:
    gosub to DismissWelcome   ! the welcome panel goes on the first click of anything that works
    if TabCount is 0 stop
    ! The parse is what reads the attributes, and the buffer may have changed since the last one — so read it now
    ! rather than trusting `AppPage` to be current. It is the same walk the Blocks view uses, and it clears
    ! `AppPage` first, so an attribute that has just been deleted cannot go on launching a page.
    gosub to ParseSource
    if AppPage is empty
    begin
        ! §1
        set the content of StatusSpan to `No app named: add '@app mypage.html' on a line of its own — a script attribute, not a comment`
        fork to ClearStatus
        stop
    end
    location new AppPage
    set the content of StatusSpan to `Opened ` cat AppPage
    fork to ClearStatus
    stop
!! @hash 6a3baf00
!! @verified 0faead49
!!!
!! The popup menu: the pointer's other button, what it offers, and what closes it.
!!
!! **One menu, owned here, for two surfaces.** The picture and the sidebar are separate programs in separate boxes, and a menu is neither's: it must be able to appear over either, and what it lists is the *editor's* to know — the sidebar's tabs and the pane's freeze. So the editor listens for the right-click on both boxes and draws the box itself, and each module is told what the item meant without ever learning that a menu exists.
!!
!! **A right-click is answered wherever it lands**, and the browser's own menu is suppressed where ours is offered (`on right click` cancels the default) so the reader is never shown two menus stacked on one another.
!!
!! **The mask is what makes a click-away close it.** The sheet covers the window and takes the click, and `HideMenu` is its handler; the menu itself is above the sheet and takes its own clicks. It is the same shape the file browser uses, and for the same reason: a popup closed by a click *anywhere* would need an `on click document`, which the runtime does not have and must not grow — a document handler fires for internal links and nothing else.
!!
!! **Two rows of this menu are the sidebar's and one is the pane's**, and neither module is told that a menu exists: each is sent the same kind of message it already answers, so the menu is a way of asking for something the two programs could both already do. Which row was pressed is `the index of MenuItem` — see `MenuItemClick` for the three of them.
ShowMenu:
    if MenuBuilt is 0 gosub to MenuBuild
    put the pick position into MenuAt
    put property `x` of MenuAt into MenuX
    put property `y` of MenuAt into MenuY
    set style `left` of Menu to MenuX cat `px`
    set style `top` of Menu to MenuY cat `px`
    ! **The last row's word is read every time the menu is opened, because it is the one word that
    ! changes.** The freeze is the pane's state, not this file's, and the pane lifts it by itself the
    ! moment the pointer comes back over the picture — so the label has to be taken at the moment the
    ! reader looks, which is here, rather than left as whatever it was the last time.
    gosub to MenuFreezeRow
    set style `display` of MenuMask to `block`
    set style `display` of Menu to `block`
    return

HideMenu:
    set style `display` of Menu to `none`
    set style `display` of MenuMask to `none`
    return
!! @hash 73041cd8
!!!
!! The menu's rows, built once from a list of names.
!!
!! **A row is a symbol, so the list is a name in `MenuItemName` and a row in the pool** — the same constraint the sidebar's tabs live under, and the same shape it uses to get round it: `MenuItem` is declared in this file and every row is *created* here, which is why `se-menu` is an empty box in `viz.json` rather than a list of rows. **The styles are set here for the same reason**, exactly as the tab strip sets its own: an element the runtime creates is a bare `div` of that kind, so a row that carried no padding or colour would be a row a reader could not read — measured in a browser on 2026-10-12, where the rows sat flush against one another in the browser's default colour on the menu's own dark ground. `MenuPad` holds that one styling for every row; nothing in it changes per row, so it is written once.
!!
!! **The first three names are the sidebar's tab names and its order**, which is the one thing here that has to agree with another file: `MenuItemClick` sends a row's index *as* a tab's index, so a tab added to the sidebar's strip has to be added here too.
!!
!! **The labels are English, and so are the sidebar's tabs** — that module has no language pack, deliberately, and neither has this: it owns the box and it owns the words on it. The one word that is not in this list is `Cancel`, which replaces `Freeze` while the picture is being held still.
MenuBuild:
    put 1 into MenuBuilt
    put 4 into MenuItemCount
    set the elements of MenuItemName to MenuItemCount
    index MenuItemName to 0
    put `Doc block` into MenuItemName
    index MenuItemName to 1
    put `Code` into MenuItemName
    index MenuItemName to 2
    put `Values` into MenuItemName
    index MenuItemName to 3
    put `Freeze` into MenuItemName
    put `font-size:12px;color:#d7d7d7;padding:6px 18px 6px 12px;cursor:pointer;text-align:left;white-space:nowrap` into MenuPad
    set the elements of MenuItem to MenuItemCount
    put 0 into MenuI
    while MenuI is less than MenuItemCount
    begin
        index MenuItem to MenuI
        create MenuItem in Menu
        index MenuItemName to MenuI
        put MenuItemName into MenuItemLabel
        set the content of MenuItem to MenuItemLabel
        set the style of MenuItem to MenuPad
        ! **A handler per row, registered as the row is made.** A pool's elements do not exist until
        ! `create` has made them and `on click` registers on the elements the symbol has *at that
        ! moment*, so a registration written once before this loop would register nothing at all. This is
        ! the sidebar's tab strip's own shape, and for its own reason.
        on click MenuItem go to MenuItemClick
        add 1 to MenuI
    end
    return
!! @hash 023d36b3
!!!
!! What each row does when it is pressed.
!!
!! **One handler for four rows, and which row it was comes from the row.** A row is an element of the `MenuItem` pool, so `the index of MenuItem` is the whole of what tells them apart — the shape the sidebar's tab strip already uses. **The rows are the sidebar's three tabs in the sidebar's own order, then the pane's freeze**, so for the first three a row's index *is* a tab's index and nothing maps between them; the fourth is the row that is not a tab. That is the one coupling in this menu, and it is why both lists are in that order and each says so.
!!
!! **The menu is put away first, whatever the row does.** Every row here changes what the reader is looking at, and a menu left standing over the thing it just changed is a menu in the way of its own answer.
!!
!! **Neither rung is this file's to hold.** A tab is the sidebar's state and the freeze is the pane's, so both are *told* and neither is *asked*: `MenuFrozen` exists only so a row can be labelled, and the pane corrects it the moment it lifts the freeze itself — see `VizFreezeReport`, which is that correction arriving.
MenuItemClick:
    put the index of MenuItem into MenuPick
    gosub to HideMenu
    if MenuPick is 3 go to MenuFreezeToggle
    gosub to MenuTabSelect
    stop

!   The freeze, which is a toggle rather than two rows: the pane is told to hold where it is, or to let
!   go, and the row will read the other word the next time the menu is opened.
MenuFreezeToggle:
    if MenuFrozen is 1 put 0 into MenuFrozen
    else put 1 into MenuFrozen
    if VizLoaded is 0
    begin
        log `menu: the pane is not loaded, so freeze=` cat MenuFrozen cat ` has nowhere to go`
        stop
    end
    put `{}` into VizRun
    set property `kind` of VizRun to `freeze`
    set property `frozen` of VizRun to MenuFrozen
    send VizRun to VizModule
    stop

!   The tab switch: the sidebar takes the tab up and re-shows the line it is already holding. Nothing of
!   the line is re-sent, and that is what makes this both cheap and correct — the menu may have been
!   opened over a picture whose last report arrived some time ago, and a re-sent line would be an
!   *arrival* the reader never named, with a visit number and a set of captured values to go with it.
MenuTabSelect:
    if SideLoaded is 0
    begin
        log `menu: the sidebar is not loaded, so tab ` cat MenuPick cat ` has nowhere to go`
        return
    end
    put `{}` into SideMsg
    set property `kind` of SideMsg to `tab`
    set property `sel` of SideMsg to MenuPick
    send SideMsg to SideModule
    return

!   The last row's words, assembled where they are written. The name comes from the one list that holds
!   it, so a renamed row is renamed here too; `Cancel` is the one word that is not in that list, because
!   it is not a name but a state.
MenuFreezeRow:
    take 1 from MenuItemCount giving MenuI
    index MenuItemName to MenuI
    put MenuItemName into MenuItemLabel
    if MenuFrozen is 1 put `Cancel` into MenuItemLabel
    index MenuItem to MenuI
    set the content of MenuItem to MenuItemLabel
    return
!! @hash b2f67929
!!!
!! Puts the welcome panel away, and is the only thing that does.
!!
!! **The panel goes on the first click of anything that works, and there is no single line that says so.** `on click document` reads as "any click anywhere" and is not: the runtime runs a document click handler only for an `<a href>` into this same page (`Browser.js`, `clickDocument` — the editor's own file links are what it exists for). Measured in a browser, 2026-10-12, a click on `Blocks` left the panel standing. So the dismissal is a `gosub to DismissWelcome` as the first line of each of the bar's handlers — `ShowBrowser`, `NewFile`, `DoFind`, `ToggleBlocks`, `ToggleGraph`, `RecordRun` and `LaunchApp` — with the panel itself clickable too, for a reader who clicks the prose rather than a button. **The cost is that a new button has to carry its own `gosub`**, which no list can imply: `tools/viz-modes-check.js` asks the *source* of all seven, because running them for real opened the file browser and broke the checks below it.
!   -- Put the welcome panel away --
DismissWelcome:
    set style `display` of Welcome to `none`
    return
!! @hash 3c88926c
!!!
