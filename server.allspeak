!   server.allspeak
!   AllSpeak development server.
!   Usage: allspeak server [-t|--tabs page1,page2,...] [port]    (default port: 8080)
!   Example: allspeak server -t edit,test 8080
!     opens edit.html and test.html in the default browser at localhost:8080
!
!   Serves two purposes:
!     1. Hosts the AllSpeak editor at localhost:<port>/edit.html
!     2. Serves project files at localhost:<port>/<project>.html
!        (replaces the need for python3 -m http.server)
!
!   API routes (paths are relative to the server's working directory):
!     GET  /list/<path>   →  returns JSON array of {name,type} entries in <path>
!     GET  /list          →  returns entries in the root directory
!     GET  /read/<file>   →  returns contents of <file>
!     POST /write/<file>  →  writes request body to <file>; returns OK
!     GET  /version       →  checks for updates from the repo; returns OK or updated
!     GET  /restart       →  restarts the server process
!     GET  /<file>        →  serves static files (HTML, JS, CSS, JSON, ECS);
!                            404 when there is no such file

    script CodeServer

    use server

    variable BaseDir
    variable FullPath
    variable FilePath
    variable Content
    variable FileList
    variable Port
    variable MimeType
    variable FileLoaded
    variable RepoBase
    variable RemoteVersion
    variable LocalVersion
    server Files

    put `https://allspeak.ai/code/` into RepoBase

    put cwd into BaseDir
    variable ArgCount
    variable ArgIndex
    variable CurrentArg
    variable TabList
    variable TabName
    variable TabIndex
    variable TabUrl
    put argc into ArgCount
    put `8080` into Port
    put empty into TabList
    put 0 into ArgIndex
    while ArgIndex is less than ArgCount
    begin
        put arg ArgIndex into CurrentArg
        if CurrentArg is `-t` or CurrentArg is `--tabs`
        begin
            increment ArgIndex
            if ArgIndex is less than ArgCount
                put arg ArgIndex into TabList
        end
        else
            put CurrentArg into Port
        increment ArgIndex
    end

    ! Ensure .code-version exists
    if file BaseDir cat `/.code-version` does not exist
    begin
        save `0` to BaseDir cat `/.code-version`
    end

    start Files on port Port

    print `AllSpeak dev server running on port ` cat Port
    print `Serving files from ` cat BaseDir
    print `Press Ctrl+C to stop`

    ! Check for updates at startup
    ! **`on failure`, not `or`.** Both spellings run the same action on failure, but an
    ! `or` clause then *ends the thread* — so an unreachable repo would have stopped the
    ! server before it registered its request handler, and the dev server would have been
    ! useless offline. `on failure` recovers and carries on, leaving RemoteVersion empty so
    ! the update block below is skipped.
    get RemoteVersion from url RepoBase cat `code-version`
        on failure
        begin
            print `Warning: could not check for updates`
        end
    if RemoteVersion is not empty
    begin
        replace ` ` with `` in RemoteVersion
        replace newline with `` in RemoteVersion
        load LocalVersion from BaseDir cat `/.code-version`
            on failure
            begin
                put `0` into LocalVersion
            end
        replace ` ` with `` in LocalVersion
        replace newline with `` in LocalVersion
        ! **Only a *greater* published number is an update, and the comparison is numeric.** Any difference
        ! used to fetch, which meant a copy that was *ahead* of the deploy was dragged back to the published
        ! number, its `server.allspeak` overwritten by the older one — **and the repo is such a copy**: the
        ! number is authored here, so a server started in the repo undid the bump that was supposed to reach
        ! the projects. Measured 2026-10-04: `3` local against `2` published logged `Updating from version 3
        ! to 2`, replaced the script and reset the file. `the value of` is what compares `9` and `10` as
        ! numbers rather than as text, and a non-numeric answer (a page in place of the file) simply fails
        ! this test, so nobody is asked to trust the response.
        if the value of RemoteVersion is greater than the value of LocalVersion
        begin
            print `Updating from version ` cat LocalVersion cat ` to ` cat RemoteVersion
            ! **The server script is the only file a project keeps a copy of.** The editor and its two
            ! modules travel in the page's payload (`dist/asedit.js`, built by ./build-allspeak), so a
            ! copy of them in a project directory does nothing but shadow the deployed one — and the page
            ! prefers this directory to the payload, so a stale copy was the editor a project ran. That is
            ! what the download lines here used to write. Nothing else needs fetching.
            download RepoBase cat `server.allspeak` to BaseDir cat `/server.allspeak`
            save RemoteVersion to BaseDir cat `/.code-version`
            print `Update complete`
        end
    end

    on Files request
    begin
        set FullPath to Files path

        if FullPath is `/version`
        begin
            get RemoteVersion from url RepoBase cat `code-version` or begin
                return `error` to Files with status 500
            end
            replace ` ` with `` in RemoteVersion
            replace newline with `` in RemoteVersion
            load LocalVersion from BaseDir cat `/.code-version` or begin
                put `0` into LocalVersion
            end
            replace ` ` with `` in LocalVersion
            replace newline with `` in LocalVersion
            if RemoteVersion is LocalVersion
                return `OK` to Files
            else
                return `updated` to Files
        end
        else if FullPath is `/restart`
        begin
            print `Restart requested`
            system background `sleep 2 && allspeak server.allspeak ` cat Port
            return `OK` to Files
            exit
        end
        else if FullPath is `/list` or FullPath starts with `/list/`
        begin
            put FullPath into FilePath
            replace `/list` with `` in FilePath
            if left 1 of FilePath is `/` put from 1 of FilePath into FilePath
            if FilePath includes `..`
            begin
                return `Forbidden` to Files with status 403
            end
            if FilePath is empty
                set FileList to entries in BaseDir type `allspeak,as,ecs,md,txt,json,html,css,js,py`
            else
                set FileList to entries in BaseDir cat `/` cat FilePath type `allspeak,as,ecs,md,txt,json,html,css,js,py`
            return FileList to Files
        end
        else if FullPath starts with `/read/`
        begin
            put FullPath into FilePath
            replace `/read/` with `` in FilePath
            if FilePath includes `..`
            begin
                return `Forbidden` to Files with status 403
            end
            load Content from BaseDir cat `/` cat FilePath
            	on failure
            	begin
                	log `Could not open ` cat BaseDir cat  `/` cat FilePath
                    put empty into Content
                end
            return Content to Files
        end
        else if FullPath starts with `/write/`
        begin
            put FullPath into FilePath
            replace `/write/` with `` in FilePath
            if FilePath includes `..`
            begin
                return `Forbidden` to Files with status 403
            end
            get Content from Files
            save Content to BaseDir cat `/` cat FilePath
            return `OK` to Files
        end
        else
        begin
            ! Static file serving
            put from 1 of FullPath into FilePath
            if FilePath includes `..`
            begin
                return `Forbidden` to Files with status 403
            end
            if FilePath ends with `.html` put `text/html` into MimeType
            else if FilePath ends with `.json` put `application/json` into MimeType
            else if FilePath ends with `.allspeak` put `text/plain` into MimeType
            else if FilePath ends with `.as` put `text/plain` into MimeType
            else if FilePath ends with `.js` put `application/javascript` into MimeType
            else if FilePath ends with `.css` put `text/css` into MimeType
            else put `text/plain` into MimeType
            ! **One response, decided once, and a real 404 when the file is not there.** This
            ! used to be `load Content from ... or begin return 'Not found' ... 404 end` and then
            ! `return Content to Files` — which read as "404 if the load fails", but an `or`
            ! clause whose action is a `return` does not end the section, so the thread carried on
            ! into the `return Content` below. `Content` still held whatever was read last, so a
            ! request for a file that is not there was answered `200` with the previous response's
            ! body and the MIME guessed from the name that was asked for — and a page then
            ! executed that body as JavaScript. The flag is what makes exactly one answer.
            put `yes` into FileLoaded
            load Content from BaseDir cat `/` cat FilePath
                on failure
                begin
                    put `no` into FileLoaded
                end
            if FileLoaded is `yes`
                return Content to Files with type MimeType
            else
                return `Not found` to Files with status 404
        end
    end

    ! Open requested browser tabs (-t/--tabs flag) — done AFTER the
    ! request handler is registered so the tabs don't race the server
    ! and hit a 503 'Server handler not ready'.
    if TabList is not empty
    begin
        split TabList on `,`
        put 0 into TabIndex
        while TabIndex is less than the elements of TabList
        begin
            index TabList to TabIndex
            put TabList into TabName
            if TabName is not empty
            begin
                put `http://localhost:` cat Port cat `/` cat TabName cat `.html` into TabUrl
                print `Opening ` cat TabUrl
                browse TabUrl
            end
            increment TabIndex
        end
    end
