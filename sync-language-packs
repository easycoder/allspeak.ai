#!/usr/bin/env python3
"""sync-language-packs: extract JSON from each js/allspeak/LanguagePack_<lang>.js
and write it to allspeak-py/allspeak/languages/<lang>.json.

The JS files are the source of truth — multilingual fixes land there first
(via Edit on the source object literal). This script keeps the Python-side
JSON in sync, so scripts run through the `allspeak` CLI see the same
vocabulary as the browser runtime.

Run after editing any js/allspeak/LanguagePack_*.js file.
"""

import json
import os
import re
import sys

REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
JS_DIR = os.path.join(REPO_ROOT, 'js', 'allspeak')
JSON_DIR = os.path.join(REPO_ROOT, 'allspeak-py', 'allspeak', 'languages')


def extract_pack(js_path):
    """Pull the JS object literal out of a LanguagePack_<lang>.js file."""
    with open(js_path, encoding='utf-8') as f:
        text = f.read()
    m = re.search(r'=\s*(\{[\s\S]*\})\s*;?\s*$', text)
    if not m:
        raise SystemExit(f'Cannot extract JSON object from {js_path}')
    return json.loads(m.group(1))


def placeholder_set(text):
    """The `{names}` a message uses, whichever order they appear in."""
    return set(re.findall(r'\{(\w+)\}', text))


def check_packs(packs):
    """Refuse a pack that is behind English, and a message whose placeholders do not match.

    **This is the guard that makes a new language a small job rather than a hunt.** A pack missing a key is not
    an error at run time — `Language.diagnostic` falls back to the English text — which is exactly why nothing
    would tell you: a language could be added, ship half-translated, and read as English in the places nobody
    looked. The mirror of the same hazard is a key that *English* has dropped, which would sit in the other
    packs unread for ever.

    The placeholder half is the subtler one: a translation that drops `{line}` or mistypes `{marker}` renders a
    sentence with a hole in it or with the placeholder still showing, and no test would notice because the
    sentence is still a sentence. So the *shapes* must match, key by key, in every language.
    """
    problems = []
    english = packs.get('en')
    if english is None:
        problems.append('there is no English pack, which is every other pack\'s fallback')
        return problems
    for section in ('diagnostics',):
        want = set(english.get(section, {}))
        for lang, pack in sorted(packs.items()):
            if lang == 'en':
                continue
            have = set(pack.get(section, {}))
            for key in sorted(want - have):
                problems.append(f'{lang}: {section} is missing "{key}" from English')
            for key in sorted(have - want):
                problems.append(f'{lang}: {section} has "{key}", which English does not')
        for lang, pack in sorted(packs.items()):
            for key, text in (pack.get(section) or {}).items():
                mine = placeholder_set(text)
                theirs = placeholder_set(english.get(section, {}).get(key, ''))
                if key in want and mine != theirs:
                    problems.append(
                        f'{lang}: "{key}" uses {sorted(mine) or "no placeholders"}, '
                        f'English uses {sorted(theirs) or "none"}')
    return problems


def reverse_lookup_deaths(packs):
    """Which canonical words a `reverse_word` lookup can never reach, per language.

    **The reverse map is many-to-one, and therefore lossy.** Where a language spells two English words the
    same — French `dans` is `in` and `into`, Italian `e` is `and` and `is` — it keeps one and the other becomes
    invisible to any code that asks "what word is this?" rather than "is this token a form of that word?".
    English has no such pair, out of 376 forms, so the hazard is exactly the non-English packs.
    """
    deaths = {}
    for lang, pack in packs.items():
        forms = {}
        for canonical, spelled in (pack.get('words') or {}).items():
            for form in str(spelled).split('|'):
                forms.setdefault(form, []).append(canonical)
        # Which canonical the reverse map keeps: it is built in pack order with the last writer winning,
        # so the walk below is what `Language._build_reverse_words` does, not a guess at it.
        words = pack.get('words') or {}
        kept = {}
        for canonical in words:
            for form in str(words[canonical]).split('|'):
                kept[form] = canonical
        dead = {}
        for form, canonicals in forms.items():
            if len(canonicals) < 2:
                continue
            for canonical in canonicals:
                if canonical != kept.get(form) and canonical != form:
                    dead.setdefault(canonical, set()).add(form)
        deaths[lang] = dead
    return deaths


def check_grammar(packs):
    """Refuse a Python site that tests a word by reverse lookup against one a pack cannot reach.

    **This is the guard that makes the class safe to leave behind.** `language.reverse_word(t) == 'word'` asks
    the lossy map what `t` *is*; `language.matches_word(t, 'word')` asks the pack whether `t` is a *form* of it,
    which is what the JavaScript grammar does and what every such site in `allspeak-py/` now does. The two agree
    on every token in English — no ambiguous form there — so the difference shows only in a pack that has a
    collision, where the reverse lookup silently names a word the code cannot reach.

    Thirty-two sites were exactly this (measured 2026-10-05): a French loop could not run under Python, because
    a comparison against `than` could never see `à`, and `record le script dans …` could not parse. A new pack
    or a new word can reintroduce it, and a run-time test would only find the ones somebody happened to write a
    script for — so it is checked here, from the packs, where the collision would come from.
    """
    deaths = reverse_lookup_deaths(packs)
    problems = []
    # `[^()]*(?:\([^()]*\))?[^()]*` because the argument is often a call — `reverse_word(self.nextToken())`
    # — and a pattern that stops at the first `)` would miss exactly the sites that consume a token.
    site = re.compile(r"(?:reverse_word|language_word)\([^()]*(?:\([^()]*\))?[^()]*\)"
                      r"\s*(?:==|!=)\s*['\"]([a-z_]+)['\"]")
    root = os.path.join(REPO_ROOT, 'allspeak-py')
    for folder, _dirs, names in os.walk(root):
        for name in sorted(names):
            if not name.endswith('.py'):
                continue
            path = os.path.join(folder, name)
            for n, line in enumerate(open(path, encoding='utf-8'), 1):
                if line.lstrip().startswith('#'):
                    continue
                m = site.search(line)
                if not m:
                    continue
                for lang in sorted(deaths):
                    if m.group(1) in deaths[lang]:
                        forms = ', '.join(sorted(deaths[lang][m.group(1)]))
                        problems.append(
                            f"allspeak-py/{os.path.relpath(path, root)}:{n} tests for '{m.group(1)}', which "
                            f"a reverse lookup cannot reach in {lang} (the form is '{forms}') — "
                            f"use language.matches_word(...)")
    return problems


def main():
    if not os.path.isdir(JSON_DIR):
        raise SystemExit(f'Output directory not found: {JSON_DIR}')

    # Read every pack first, so a pack that is behind is refused *before* anything is written: a half-synced
    # pair of trees is harder to reason about than either state.
    packs = {}
    for fname in sorted(os.listdir(JS_DIR)):
        m = re.match(r'^LanguagePack_(\w+)\.js$', fname)
        if m:
            packs[m.group(1)] = extract_pack(os.path.join(JS_DIR, fname))

    problems = check_packs(packs)
    if problems:
        print('The language packs disagree with English:')
        for line in problems:
            print('  ' + line)
        print('\nNothing was written. A new language must translate every `diagnostics` key — see')
        print('learn/reference/15-multilingual.md — and the English pack is the one that defines the set.')
        return 1

    grammar = check_grammar(packs)
    if grammar:
        print('The Python grammar tests a word in a way some pack cannot answer:')
        for line in grammar:
            print('  ' + line)
        print('\nNothing was written. See `check_grammar` in this script for why; the short version is that')
        print('`reverse_word` is many-to-one and `matches_word` is not.')
        return 1

    synced = 0
    for fname in sorted(os.listdir(JS_DIR)):
        m = re.match(r'^LanguagePack_(\w+)\.js$', fname)
        if not m:
            continue
        lang = m.group(1)
        js_path = os.path.join(JS_DIR, fname)
        json_path = os.path.join(JSON_DIR, f'{lang}.json')
        data = packs[lang]
        with open(json_path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write('\n')
        print(f'  synced: allspeak-py/allspeak/languages/{lang}.json')
        synced += 1

    print(f'Done. {synced} language pack(s) synced.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
