!   server.allspeak
!   AllSpeak development server.
!   Usage: allspeak server [-t|--tabs page1,page2,...] [port]    (default port: 8080)
!   Example: allspeak server -t edit,test 8080
!     opens edit.html and test.html in the default browser at localhost:8080
!
!   Serves two purposes:
!     1. Hosts the AllSpeak editor at localhost:<port>/edit.html
!     2. Serves project files at localhost:<port>/<project>.html
!        (replaces the need for python3 -m http.server)
!
!   API routes (paths are relative to the server's working directory):
!     GET  /list/<path>   →  returns JSON array of {name,type} entries in <path>
!     GET  /list          →  returns entries in the root directory
!     GET  /read/<file>   →  returns contents of <file>
!     POST /write/<file>  →  writes request body to <file>; returns OK
!     GET  /version       →  compares this process's script with the published one;
!                            returns OK or updated
!     GET  /restart       →  restarts the server process
!     GET  /<file>        →  serves static files (HTML, JS, CSS, JSON, ECS);
!                            404 when there is no such file. `edit.html` is
!                            served from the deploy when the project has none,
!                            with the project's language filled in.

    script CodeServer

    use server

    variable BaseDir
    variable FullPath
    variable FilePath
    variable Content
    variable FileList
    variable Port
    variable MimeType
    variable FileLoaded
    variable RepoBase
    variable DistBase
    variable RemoteServer
    variable LocalServer
    variable LocalServerPath
    variable Lang
    variable InitText
    variable LangTag
    variable LangDiv
    variable HomeDiv
    variable Page
    server Files

    put `https://allspeak.ai/code/` into RepoBase
    put `https://allspeak.ai/dist/` into DistBase

    put cwd into BaseDir
    variable ArgCount
    variable ArgIndex
    variable CurrentArg
    variable TabList
    variable TabName
    variable TabIndex
    variable TabUrl
    put argc into ArgCount
    put `8080` into Port
    put empty into TabList
    put 0 into ArgIndex
    while ArgIndex is less than ArgCount
    begin
        put arg ArgIndex into CurrentArg
        if CurrentArg is `-t` or CurrentArg is `--tabs`
        begin
            increment ArgIndex
            if ArgIndex is less than ArgCount
                put arg ArgIndex into TabList
        end
        else
            put CurrentArg into Port
        increment ArgIndex
    end

    ! **No `.code-version`, and no self-update.** This script used to keep itself current: it compared a
    ! `code-version` number in the project with the published one and downloaded itself when they differed.
    ! Every project therefore held a copy of the server, the number was a number nobody remembered to bump,
    ! and — because *any* difference fetched — a copy ahead of the publish was dragged backwards (measured
    ! 2026-10-04: `3` local against `2` published replaced the script and reset the file). None of that is
    ! needed now: the CLI fetches this script when a project has none, so what a project runs is the
    ! published one. A project that *does* keep a `server.allspeak` has asked for that copy, and it is not
    ! this script's business to replace it.

    start Files on port Port

    print `AllSpeak dev server running on port ` cat Port
    print `Serving files from ` cat BaseDir
    print `Press Ctrl+C to stop`

    ! **There is nothing to check for updates, and this is why.** This script used to keep itself current:
    ! it compared a `code-version` number in the project with the published one and downloaded itself when
    ! they differed. Every project therefore held a copy of the server, the number was a number nobody
    ! remembered to bump, and — because *any* difference fetched — a copy ahead of the publish was dragged
    ! backwards (measured 2026-10-04: `3` local against `2` published replaced the script and reset the
    ! file). None of that is needed any more: the CLI fetches this script when a project has none, so the
    ! file a project runs is the published one and `.code-version` is gone. A project that *does* keep a
    ! `server.allspeak` has asked for that copy, and it is not this script's business to replace it.

    on Files request
    begin
        set FullPath to Files path

        if FullPath is `/version`
        begin
            ! **Content, not a number.** The editor asks this at startup and offers a restart when the answer
            ! is `updated`. It used to compare a `code-version` number in the project with the published one,
            ! which needed that number to be in the project and a hand to bump it. What it compares now is
            ! the thing actually being asked: is the *published* server script the one this process is
            ! running? The running copy is a project's own `server.allspeak` when there is one, and the CLI's
            ! fetched copy otherwise. No number, nothing to remember to bump, and a true answer either way.
            get RemoteServer from url RepoBase cat `server.allspeak` or begin
                return `error` to Files with status 500
            end
            put BaseDir cat `/server.allspeak` into LocalServerPath
            if file LocalServerPath does not exist
                put `~/.cache/allspeak/server.allspeak` into LocalServerPath
            load LocalServer from LocalServerPath or begin
                return `OK` to Files
            end
            if RemoteServer is LocalServer
                return `OK` to Files
            else
                return `updated` to Files
        end
        else if FullPath is `/restart`
        begin
            ! The extension is optional, and a project no longer needs a copy of this script for the
            ! command below to work — which is what makes this the way to pick up a newly published one.
            print `Restart requested`
            system background `sleep 2 && allspeak server ` cat Port
            return `OK` to Files
            exit
        end
        else if FullPath is `/list` or FullPath starts with `/list/`
        begin
            put FullPath into FilePath
            replace `/list` with `` in FilePath
            if left 1 of FilePath is `/` put from 1 of FilePath into FilePath
            if FilePath includes `..`
            begin
                ! **`stop`, because a refusal that only sets a response does not refuse.** The lines
                ! after this block ran and overwrote the 403 — measured 2026-10-04: in the static
                ! branch, `curl --path-as-is /../secret-outside.txt` returned the file with `200`,
                ! and the same fall-through defeated the guards on /list, /read and /write.
                return `Forbidden` to Files with status 403
                stop
            end
            if FilePath is empty
                set FileList to entries in BaseDir type `allspeak,as,ecs,md,txt,json,html,css,js,py`
            else
                set FileList to entries in BaseDir cat `/` cat FilePath type `allspeak,as,ecs,md,txt,json,html,css,js,py`
            return FileList to Files
        end
        else if FullPath starts with `/read/`
        begin
            put FullPath into FilePath
            replace `/read/` with `` in FilePath
            if FilePath includes `..`
            begin
                ! **`stop`, because a refusal that only sets a response does not refuse.** The lines
                ! after this block ran and overwrote the 403 — measured 2026-10-04: in the static
                ! branch, `curl --path-as-is /../secret-outside.txt` returned the file with `200`,
                ! and the same fall-through defeated the guards on /list, /read and /write.
                return `Forbidden` to Files with status 403
                stop
            end
            load Content from BaseDir cat `/` cat FilePath
            	on failure
            	begin
                	log `Could not open ` cat BaseDir cat  `/` cat FilePath
                    put empty into Content
                end
            return Content to Files
        end
        else if FullPath starts with `/write/`
        begin
            put FullPath into FilePath
            replace `/write/` with `` in FilePath
            if FilePath includes `..`
            begin
                ! **`stop`, because a refusal that only sets a response does not refuse.** The lines
                ! after this block ran and overwrote the 403 — measured 2026-10-04: in the static
                ! branch, `curl --path-as-is /../secret-outside.txt` returned the file with `200`,
                ! and the same fall-through defeated the guards on /list, /read and /write.
                return `Forbidden` to Files with status 403
                stop
            end
            get Content from Files
            save Content to BaseDir cat `/` cat FilePath
            return `OK` to Files
        end
        else
        begin
            ! Static file serving
            put from 1 of FullPath into FilePath
            if FilePath includes `..`
            begin
                ! **`stop`, because a refusal that only sets a response does not refuse.** The lines
                ! after this block ran and overwrote the 403 — measured 2026-10-04: in the static
                ! branch, `curl --path-as-is /../secret-outside.txt` returned the file with `200`,
                ! and the same fall-through defeated the guards on /list, /read and /write.
                return `Forbidden` to Files with status 403
                stop
            end
            if FilePath ends with `.html` put `text/html` into MimeType
            else if FilePath ends with `.json` put `application/json` into MimeType
            else if FilePath ends with `.allspeak` put `text/plain` into MimeType
            else if FilePath ends with `.as` put `text/plain` into MimeType
            else if FilePath ends with `.js` put `application/javascript` into MimeType
            else if FilePath ends with `.css` put `text/css` into MimeType
            else put `text/plain` into MimeType
            ! **One response, decided once, and a real 404 when the file is not there.** This
            ! used to be `load Content from ... or begin return 'Not found' ... 404 end` and then
            ! `return Content to Files` — which read as "404 if the load fails", but an `or`
            ! clause whose action is a `return` does not end the section, so the thread carried on
            ! into the `return Content` below. `Content` still held whatever was read last, so a
            ! request for a file that is not there was answered `200` with the previous response's
            ! body and the MIME guessed from the name that was asked for — and a page then
            ! executed that body as JavaScript. The flag is what makes exactly one answer.
            put `yes` into FileLoaded
            ! **Ask whether the file is there before trying to read it.** `load … on failure` prints a line for
            ! every failure, and in a project a missing page is the *ordinary* case — a project has no
            ! `edit.html`, and the branch below serves the deployed one — so every page load printed
            ! `Exception "Unable to read from …/edit.html": Running the "or" clause` and read as a fault. A file
            ! that exists and cannot be read is still caught, by the clause that remains.
            if file BaseDir cat `/` cat FilePath does not exist
                put `no` into FileLoaded
            else
            begin
                load Content from BaseDir cat `/` cat FilePath
                    on failure
                    begin
                        put `no` into FileLoaded
                    end
            end
            if FileLoaded is `yes`
                return Content to Files with type MimeType
            else if FilePath is `edit.html`
            begin
                ! **The page is served, not shipped.** A pack used to carry `edit.html`, generated per
                ! language — which put a copy of the *tooling* in every project, and nothing in a project
                ! knows when the repository's page has moved on. So the page is not in a project at all
                ! unless somebody chose to put one there (a local `edit.html` still wins, above): the
                ! server fetches the deployed page and fills in the two things a pack's page used to
                ! get from the pack — the language, and where the editor's payload lives.
                !
                ! The language comes from the project's own `.allspeak-init` (`lang: fr`), the file the
                ! starter AGENTS.md already has the agent create and complete; with no such line it is
                ! English. Everything else in the page is already language-neutral.
                put `en` into Lang
                put empty into InitText
                ! The same courtesy as the file above: a project with no manifest yet is an ordinary state — a
                ! pack ships one, an older project has none — and the answer is English.
                if file BaseDir cat `/.allspeak-init` exists
                begin
                    load InitText from BaseDir cat `/.allspeak-init`
                        on failure
                        begin
                            put empty into InitText
                        end
                end
                if InitText is not empty
                begin
                    ! `field 1 ... delimited by` is the text *after* the marker (measured: the
                    ! occurrences are numbered, not the segments), so with one `lang:` line the
                    ! language is field 1 and there is no field 2.
                    put field 1 of InitText delimited by `lang:` into Lang
                    replace ` ` with `` in Lang
                    replace newline with `` in Lang
                    if Lang is empty put `en` into Lang
                end
                get Page from url RepoBase cat `edit.html`
                    on failure
                    begin
                        return `Not found` to Files with status 404
                    end
                put `<html lang="` cat Lang cat `">` into LangTag
                put `id="editor-lang" style="display:none">` cat Lang cat `<` into LangDiv
                put `id="editor-home" style="display:none">` cat DistBase cat `</div>` into HomeDiv
                replace `<html lang="en">` with LangTag in Page
                replace `id="editor-lang" style="display:none">en<` with LangDiv in Page
                replace `id="editor-home" style="display:none"></div>` with HomeDiv in Page
                return Page to Files with type `text/html`
            end
            else
                return `Not found` to Files with status 404
        end
    end

    ! Open requested browser tabs (-t/--tabs flag) — done AFTER the
    ! request handler is registered so the tabs don't race the server
    ! and hit a 503 'Server handler not ready'.
    if TabList is not empty
    begin
        split TabList on `,`
        put 0 into TabIndex
        while TabIndex is less than the elements of TabList
        begin
            index TabList to TabIndex
            put TabList into TabName
            if TabName is not empty
            begin
                put `http://localhost:` cat Port cat `/` cat TabName cat `.html` into TabUrl
                print `Opening ` cat TabUrl
                browse TabUrl
            end
            increment TabIndex
        end
    end
