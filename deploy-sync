#!/bin/sh
# deploy-sync: mirror source-tree changes into deploy/ for serving.
#
# Run this after:
#   - editing anything under codex/, learn/, primer/
#   - editing primer.html (or any tracked root HTML file)
#   - running ./build-allspeak (which rewrites deploy/dist/)
#   - adding or regenerating docs under resources/doc/
#
# Uses rsync when available (preserves timestamps, only copies changes)
# and falls back to cp -r. Safe to re-run at any time.
#
# For a full end-to-end refresh (sync packs + build JS + build zips + sync),
# use ./deploy instead.

set -eu
cd "$(dirname "$0")"

if command -v rsync >/dev/null 2>&1; then
    SYNC="rsync -a --delete"
else
    SYNC="cp_r_clobber"
    cp_r_clobber() {
        # $1 = source dir (must end with /), $2 = destination dir
        rm -rf "$2"
        mkdir -p "$2"
        cp -r "$1". "$2"
    }
fi

run_sync() {
    src="$1"
    dst="$2"
    shift 2
    if [ ! -d "$src" ]; then
        echo "  skip: $src does not exist"
        return
    fi
    mkdir -p "$dst"
    if [ "$SYNC" = "cp_r_clobber" ]; then
        # NOTE: the cp_r_clobber fallback path does not honour rsync excludes.
        cp_r_clobber "$src" "$dst"
    else
        $SYNC "$@" "$src" "$dst"
    fi
    echo "  synced: $src -> $dst"
}

copy_file() {
    src="$1"
    dst="$2"
    if [ ! -f "$src" ]; then
        echo "  skip: $src does not exist"
        return
    fi
    cp -p "$src" "$dst"
    echo "  copied: $src -> $dst"
}

echo "Syncing source -> deploy/"
run_sync "codex/"           "deploy/codex/"
run_sync "learn/"           "deploy/learn/"
# **The Primer's four trees are one shape now: English at `primer/`, the other languages at `primer/<lang>/`.**
# That is the layout `learn/` already uses, and it is here for the reason that made it necessary: until
# 2026-10-13 the translated Primers existed *only* under `deploy/`, so nothing mirrored them, nothing rebuilt
# them and nothing flagged them — and three of them came to teach a setup command (`allspeak server` where the
# other three languages' pages now say `allspeak viz`) that no longer exists, with nothing to notice it. A
# source tree the sync owns is what makes the drift visible; the same gap in `learn/` had been visible all
# along as a page count.
#
# The paths differ in one way worth naming, because it is what forces the extra lines rather than one sync:
# `learn/`'s language directories sit at the level the URLs do (`learn/fr/manifest.json`), while the Primer's
# language is *outside* its page directory (`/fr/primer/…`), so `primer/fr/` has to be written to
# `deploy/fr/primer/` — a path the single `primer/ -> deploy/en/primer/` copy cannot express.
#
# `README.md` is dev-only, and `project.allspeak` is excluded because `/en/primer.html` loads
# `/shared/primer/project.allspeak`, not `/en/primer/project.allspeak` — copying it here would leave an unused
# duplicate. The `fr/ de/ it/` excludes are what keep the language trees out of the English page directory:
# rsync honours them, which is why this is written for rsync rather than for the `cp` fallback below, which
# does not — on a machine without rsync the fallback would copy them in, and that limitation is the reason it
# is stated rather than assumed.
run_sync "primer/"          "deploy/en/primer/" --exclude=README.md --exclude=project.allspeak --exclude=fr/ --exclude=de/ --exclude=it/
run_sync "primer/fr/"       "deploy/fr/primer/"
run_sync "primer/de/"       "deploy/de/primer/"
run_sync "primer/it/"       "deploy/it/primer/"
# dist/ is now built directly into deploy/dist/ by build-allspeak, so no sync needed.
run_sync "resources/doc/"   "deploy/resources/doc/"
# Images an article calls for that belong to no page's own asset directory.
#
# **The mirror has to be committed as well as synced.** This script is not the only way a deploy happens:
# the GitHub workflow (`Deploy to allspeak.ai`) checks out the repo, runs build-allspeak and build-starters,
# and rsyncs `deploy/` to the server *as-is* — it never runs this one. So a copy that exists only in the
# working tree is not published by that path, and its `--delete` removes it from the server. Sync, then
# commit, exactly as `resources/doc/` above.
run_sync "resources/other/"   "deploy/resources/other/"

# The four language Primer pages all load /shared/primer/project.allspeak. Keep that
# single file in sync with source so we have one canonical script.
copy_file "primer/project.allspeak" "deploy/shared/primer/project.allspeak"

echo "Done."
